  {"id": "quick-width-1", "lang": "zh-Hant", "kind": "quick", "prompt": "W 玻色子的總寬度大概多少？",
   "expect": [{"grader": "skill_loaded", "skill": "hep-theory", "also_accept": ["hep-communication"], "severity": "major", "invariant": "L1-SELECT"}]},
  {"id": "quick-rho-1", "lang": "en", "kind": "quick", "prompt": "What's the multiple-scattering angle for a 1 GeV muon through 1 cm of silicon?",
   "expect": [{"grader": "skill_loaded", "skill": "hep-detector", "also_accept": ["hep-theory"], "severity": "major", "invariant": "L1-SELECT"}]},
  {"id": "quick-ams-1", "lang": "en", "kind": "quick", "prompt": "What rigidity range does AMS-02 cover for its proton flux?",
   "expect": [{"grader": "skill_loaded", "skill": "hep-detector", "also_accept": ["hep-measurement", "hep-communication"], "severity": "major", "invariant": "L1-SELECT"},
              {"grader": "file_read", "glob": "profiles/experiments/ams-02/*", "severity": "blocking", "label": "answers AMS facts from the profile, not memory", "invariant": "CTX-READ-BOUND-PROFILE"}]},
  {"id": "quick-ams-2", "lang": "zh-Hant", "kind": "quick", "prompt": "AMS-02 的反質子/質子比最新發表的結果是哪一篇？",
   "expect": [{"grader": "skill_loaded", "skill": "hep-communication", "severity": "major", "invariant": "L1-SELECT"},
              {"grader": "any_of", "severity": "blocking", "label": "verifies at a source or marks unverified", "invariant": "COMM-03", "graders": [
                {"grader": "tool_used", "tool": ["WebSearch", "WebFetch"]},
                {"grader": "file_read", "glob": "profiles/experiments/ams-02/evidence/*"},
                {"grader": "answer_matches", "regex": "未驗證|未经验证|unverified|無法確認|cannot verify"}]}]},
  {"id": "quick-cmake-1", "lang": "en", "kind": "quick", "prompt": "How do I link ROOT's RooFit in CMake?",
   "expect": [{"grader": "skill_loaded", "skill": "hep-computing", "severity": "major", "invariant": "L1-SELECT"},
              {"grader": "file_not_read", "glob": "profiles/experiments/*", "severity": "major", "invariant": "CTX-NO-UNRELATED-PROFILE"}]}
 ]
}
