   "expect": [{"grader": "skill_not_loaded", "any_hep": true, "severity": "major"}]},
  {"id": "ood-luminosity-1", "lang": "en", "kind": "out-of-domain", "prompt": "My monitor's luminosity looks uneven in the corners. Is that backlight bleed?",
