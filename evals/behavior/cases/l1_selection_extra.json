  {"id": "ood-sharpe-1", "lang": "en", "kind": "out-of-domain", "prompt": "Compute the Sharpe ratio and its confidence interval for these monthly returns: 1.2, -0.4, 0.8, 2.1, -1.0, 0.5.",
   "tags": ["lexical-collision"],
   "expect": [{"grader": "skill_not_loaded", "any_hep": true, "severity": "major", "label": "generic statistics outside physics"}]},
  {"id": "ood-abtest-1", "lang": "en", "kind": "out-of-domain", "prompt": "Is my A/B test significant? Control 120/2400 conversions, variant 151/2390.",
