  {"id": "quick-fc-1", "lang": "en", "kind": "quick", "prompt": "Quick one: 90% CL upper limit for zero observed events and no background?",
   "expect": [{"grader": "skill_loaded", "skill": "hep-statistics", "severity": "major", "invariant": "L1-SELECT"}]},
  {"id": "quick-fc-2", "lang": "zh-Hant", "kind": "quick", "prompt": "快問：觀測 0 個事例、背景 0，90% 信賴水準上限是多少？",
   "expect": [{"grader": "skill_loaded", "skill": "hep-statistics", "severity": "major", "invariant": "L1-SELECT"},
              {"grader": "answer_language", "lang": "zh-Hant", "severity": "minor", "invariant": "CTX-USER-LANGUAGE"}]},
  {"id": "quick-pi0-1", "lang": "en", "kind": "quick", "prompt": "Can a pi0 decay to three photons?",
