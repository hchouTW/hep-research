  {"id": "ood-jetlag-1", "lang": "en", "kind": "out-of-domain", "prompt": "Any tips for beating jet lag after a flight from Taipei to Geneva?",
   "tags": ["lexical-collision"],
   "expect": [{"grader": "skill_not_loaded", "any_hep": true, "severity": "major", "label": "'jet' is not a jet"}]},
  {"id": "ood-unfold-1", "lang": "en", "kind": "out-of-domain", "prompt": "What's the best way to fold and unfold a fitted sheet without wrinkles?",
