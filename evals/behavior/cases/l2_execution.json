{
 "suite": "l2-execution",
 "layer": "L2",
 "note": "Execution inside a skill: does the agent follow the invariants once loaded, and does it reach the profile and the shipped tools. Every fixture is SYNTHETIC. Deterministic graders carry blocking/major severity; rubric (judge) criteria are minor until judge.py calibration passes for them, then may be promoted. Run with arms natural and forced: the gap is the cost of L1.",
 "cases": [
  {
   "id": "l2-st-zero-count",
   "lang": "en",
   "kind": "statistics",
   "prompt": "I observed 0 events with an expected background of 0.8 +- 0.2 (systematic). Give me the 95% CL upper limit on the signal and say exactly how it was constructed.",
   "expect": [
    {
     "grader": "skill_loaded",
     "skill": "hep-statistics",
     "severity": "major",
     "invariant": "L1-SELECT"
    },
    {
     "grader": "command_run",
     "regex": "likelihood_limits\\.py|poisson_diagnostics\\.py",
     "severity": "major",
     "label": "uses the shipped counting tool",
     "invariant": "STAT-02"
    },
    {
     "grader": "answer_matches",
     "regex": "CLs|Feldman|profile|Neyman|Berger|Bayes",
     "severity": "major",
     "label": "names the construction",
     "invariant": "STAT-01"
    },
    {
     "grader": "judge",
     "criterion": "construction_and_approximation",
     "severity": "minor",
     "invariant": "STAT-02"
    }
   ],
   "rubric": [
    {
     "criterion": "construction_and_approximation",
     "description": "States the interval construction, how the background uncertainty enters, and that zero counts need an exact or toy treatment rather than a Gaussian approximation.",
     "levels": {
      "0": "a number only, or a Gaussian/sqrt(n) treatment",
      "1": "construction named, uncertainty treatment or approximation missing",
      "2": "construction, nuisance treatment and approximation validity all stated"
     }
    }
   ]
  },
  {
   "id": "l2-st-no-covariance",
   "lang": "en",
   "kind": "statistics",
   "prompt": "Combine these two flux measurements of the same bin into one value with an uncertainty. Both analyses used the same trigger-efficiency calibration. The file is measurements.json.",
   "fixtures": {
    "measurements.json": {
     "json": {
      "note": "SYNTHETIC fixture, invented values",
      "bin": "10-12 GV",
      "measurements": [
       {
        "name": "A",
        "value": 1.204,
        "stat": 0.011,
        "syst": {
         "trigger_eff": 0.018,
         "acceptance": 0.012
        }
       },
       {
        "name": "B",
        "value": 1.231,
        "stat": 0.014,
        "syst": {
         "trigger_eff": 0.018,
         "unfolding": 0.01
        }
       }
      ],
      "covariance": null
     }
    }
   },
   "expect": [
    {
     "grader": "skill_loaded",
     "skill": "hep-statistics",
     "severity": "major",
     "invariant": "L1-SELECT"
    },
    {
     "grader": "file_read",
     "glob": "measurements.json",
     "severity": "major"
    },
    {
     "grader": "any_of",
     "severity": "blocking",
     "label": "does not treat the shared trigger term as independent",
     "invariant": "STAT-04",
     "graders": [
      {
       "grader": "command_run",
       "regex": "combine_measurements\\.py"
      },
      {
       "grader": "asks_question"
      },
      {
       "grader": "answer_matches",
       "regex": "(fully |100% )?correlat\\w* (trigger|systematic)|shared (trigger|systematic)\\w* .{0,40}correlat"
      }
     ]
    },
    {
     "grader": "judge",
     "criterion": "correlation_handling",
     "severity": "minor",
     "invariant": "STAT-03"
    }
   ],
   "rubric": [
    {
     "criterion": "correlation_handling",
     "description": "Treats the shared trigger-efficiency uncertainty as correlated, keeps the other systematics' correlation as unknown or states the assumption, and does not invent a diagonal covariance.",
     "levels": {
      "0": "independent combination (inverse-variance with all errors in quadrature)",
      "1": "mentions correlation but combines as independent or invents a correlation without stating it",
      "2": "correlated shared term, stated assumptions for the rest, or a refusal asking for the missing evidence"
     }
    }
   ]
  },
  {
   "id": "l2-st-failed-fit",
   "lang": "en",
   "kind": "statistics",
   "prompt": "Write the CLs limit from fit_log.json into a statistical-result artifact so my colleague can use it.",
   "fixtures": {
