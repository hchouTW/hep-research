   "expect": [
    {
     "grader": "skill_loaded",
     "skill": "hep-statistics",
     "severity": "major",
     "invariant": "L1-SELECT"
    },
    {
     "grader": "any_of",
     "severity": "blocking",
     "label": "a failed fit is not reported as a result",
     "invariant": "STAT-07",
     "graders": [
      {
       "grader": "artifact_field",
       "glob": "hep-research-artifacts/**/*.json",
       "field": "status",
       "contains": "failed"
      },
      {
       "grader": "all_of",
       "graders": [
        {
         "grader": "not",
         "grader_spec": {
          "grader": "workspace_file_exists",
          "glob": "hep-research-artifacts/**/*.json"
         }
        },
        {
         "grader": "answer_matches",
         "regex": "did not converge|not converged|failed|未收斂"
        }
       ]
      }
     ]
    }
   ]
  },
