{
 "schema": "g4kit/1",
 "name": "planes_tracker",
 "version": "1.0.0",
 "geometry_kind": "planes-tracker",
 "role": "tracking",
 "purpose": "A telescope of equal planes along x in a uniform field along z, the geometry simreco reads.",
 "inputs": {
  "planes": {
   "kind": "integer"
  },
  "plane_gap_mm": {
   "kind": "length"
  },
  "plane_thickness_mm": {
   "kind": "length"
  },
  "plane_side_mm": {
   "kind": "length"
  },
  "field_tesla": {
   "kind": "physical"
  },
  "plane_material": {
   "kind": "material"
  },
  "world_material": {
   "kind": "material"
  }
 },
 "geometric_defaults": {},
 "detector": {
  "schema": "detector-spec/1",
  "params": {
   "telescope_mm": "planes * (plane_thickness_mm + plane_gap_mm)",
   "world_mm": "4 * telescope_mm + 4 * plane_side_mm + 200"
  },
  "materials": {},
  "fields": {
   "dipole": {
    "b_tesla": [
     "0",
     "0",
     "field_tesla"
    ]
   }
  },
  "templates": {
   "sensor": {
    "solid": {
     "box": {
      "size_mm": [
       "plane_thickness_mm",
       "plane_side_mm",
       "plane_side_mm"
      ]
     }
    },
    "material": {
     "$input": "plane_material"
    },
    "tags": [
     "tracker"
    ]
   },
   "telescope": {
    "solid": {
     "box": {
      "size_mm": [
       "telescope_mm",
       "plane_side_mm",
       "plane_side_mm"
      ]
     }
    },
    "material": {
     "$input": "world_material"
    },
    "tags": [
     "telescope"
    ],
    "children": [
     {
      "placement": {
       "stack": {
        "axis": "x",
        "from": "-x",
        "repeat": {
         "$input": "planes"
        },
        "sequence": [
         {
          "template": "sensor",
          "index": "plane"
         },
         {
          "spacer_mm": "plane_gap_mm"
         }
        ]
       }
      }
     }
    ]
   }
  },
  "world": {
   "material": {
    "$input": "world_material"
   },
   "size_mm": [
    "world_mm",
    "world_mm",
    "world_mm"
   ],
   "field": "dipole",
   "children": [
    {
     "template": "telescope",
     "placement": {
      "single": {
       "centre_mm": [
        "0",
        "0",
        "0"
       ]
      }
     }
    }
   ]
  },
  "frames": {}
 }
}
