+def target_configuration(b: dict, cfg_dir: Path) -> dict:
+    """PROTOTYPE (proposal 4.3): configuration (isolated / embedded) and target_geometry_sha256 from the run record's
+    effective geometry (extension.simulation.geometry), never from the config. isolated: no field and every placement
+    other than the world belongs to the benchmark's target (single-slab benchmarks: the placements of the named slab;
+    longitudinal-profile: the placements whose edep_copy<i>_MeV columns the config lists). Placement order is
+    layered_sim's: layers, then repeats, then slabs (Detector.cc), so copy i is the i-th placement."""
+    name = b["benchmark"]
+    if not b.get("run_record"):
+        return {"configuration": None, "configuration_basis": "no run_record in the config: geometry unknown"}
+    rec = json.loads((cfg_dir / b["run_record"]).read_text(encoding="utf-8"))
+    sim = (rec.get("extension") or {}).get("simulation") or {}
+    geo = sim.get("geometry")
+    if not isinstance(geo, dict):
+        return {"configuration": None, "configuration_basis": "the run record has no simulation.geometry"}
+    placements = [{"copy": 0, "name": s.get("name"), "material": s.get("material"), "thickness_mm": s.get("thickness_mm"),
+                   "shift_mm": s.get("shift_mm", 0.0), "layer": li, "repeat": r}
+                  for li, layer in enumerate(geo.get("layers", [])) for r in range(int(layer.get("repeat", 1)))
+                  for s in layer.get("slabs", [])]
+    for i, p in enumerate(placements):
+        p["copy"] = i
+    if name in SINGLE_SLAB:
+        target = [p for p in placements if p["name"] == b.get("slab")]
+    elif name == "longitudinal-profile":
+        cols = {x.get("column") for x in b.get("layers", [])}
+        target = [p for p in placements if f"edep_copy{p['copy']}_MeV" in cols]
+    else:
+        return {"configuration": None, "configuration_basis": f"proposal 4.3 defines no target for {name}"}
+    # layered_sim (spec/1) has no field: absence of a field key is read as no field (no effective-field record exists)
+    field = sim.get("field") or geo.get("field")
+    isolated = not field and bool(target) and len(target) == len(placements)
+    mats = {p["material"] for p in target}
+    canon = {"lateral_mm": geo.get("lateral_mm"),
+             "placements": [{k: p[k] for k in ("name", "material", "thickness_mm", "shift_mm")} for p in target],
+             "materials": sorted((m for m in sim.get("materials", []) if m.get("name") in mats),
+                                 key=lambda m: m.get("name"))}
+    return {"configuration": "isolated" if isolated else "embedded",
+            "target_geometry_sha256": hashlib.sha256(json.dumps(canon, sort_keys=True).encode()).hexdigest(),
+            "configuration_basis": {"run_record": b["run_record"], "placements": len(placements),
+                                    "target_placements": [p["copy"] for p in target], "field": bool(field)}}
+
