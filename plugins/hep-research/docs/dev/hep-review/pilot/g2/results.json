  "stat_findings": [
   {
    "claim": "The uncertainty propagation for P ignores the stated correlation between A and B; the covariance term 2*rho*(sigma_A/A)*(sigma_B/B) with rho = -0.8 is omitted, so sigma_P is overestimated (51.94 stated vs 23.40 with correlation).",
    "element": "Propagation rule 'relative uncertainty of P is the quadrature sum of the relative uncertainties' and the resulting sigma_P",
    "evidence_text": "rA = 1.195/52.59 = 0.022723, rB = 0.668/32.02 = 0.020862; sqrt(rA^2 + rB^2 + 2*(-0.8)*rA*rB) = 0.013895; sigma_P = 1683.93*0.013895 = 23.40, not 51.94."
   },
   {
    "claim": "The stated sigma_P is the uncorrelated value and is wrong given correlation_AB = -0.8.",
    "element": "stated_results.sigma_P",
    "evidence_text": "Recomputed correlated value 23.399 differs from stated 51.9447 by -55%."
   }
  ],
