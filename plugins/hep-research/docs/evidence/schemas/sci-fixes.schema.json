            "type": "string",
            "minLength": 1
           }
          }
         ]
        },
        "locator_id": {
         "anyOf": [
          {
           "type": "string",
           "minLength": 1
          },
          {
           "type": "array",
           "minItems": 1,
           "items": {
            "type": "string",
            "minLength": 1
           }
          }
         ]
        }
       }
      }
     },
