      "type": "object",
      "required": [
       "reason",
       "decided"
      ],
      "additionalProperties": false,
      "properties": {
       "reason": {
        "type": "string",
        "minLength": 1
       },
       "decided": {
        "type": "string",
        "minLength": 1
       }
      }
     },
