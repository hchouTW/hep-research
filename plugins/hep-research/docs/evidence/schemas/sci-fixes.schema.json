         "type": "string",
         "minLength": 1
        },
        "adapted_parent": {
         "type": "boolean"
        },
        "adaptation": {
         "type": "string",
         "minLength": 1
        },
        "validation": {
         "type": "string",
         "minLength": 1
        },
