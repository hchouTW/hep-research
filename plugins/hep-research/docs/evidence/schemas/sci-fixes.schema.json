      }
     },
     "correctness": {
      "enum": [
       "C0",
       "C1",
       "C2",
       "C3",
       "C4"
      ]
     },
     "discrimination": {
      "enum": [
       "D0",
       "D1",
       "D2",
       "D3"
      ]
     },
