      "items": {
       "type": "string",
       "pattern": "^tests/[^:]+\\.py::[A-Za-z_][A-Za-z0-9_]*::[A-Za-z_][A-Za-z0-9_]*$"
      }
     },
     "oracle_kinds": {
      "type": "array",
