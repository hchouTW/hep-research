      "type": "object",
      "required": [
       "by",
       "date",
       "scope"
      ],
      "additionalProperties": false,
      "properties": {
       "by": {
        "type": "string",
        "minLength": 1
       },
       "date": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
       },
       "scope": {
        "type": "string",
        "minLength": 1
       }
      }
     }
