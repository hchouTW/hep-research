  "documentation_fixes": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "title",
     "severity",
     "sources",
     "gaps",
     "note"
    ],
    "properties": {
     "id": {
      "type": "string",
      "minLength": 1
     },
     "title": {
      "type": "string",
      "minLength": 1
     },
     "severity": {
      "enum": [
       "S3",
       "doc"
