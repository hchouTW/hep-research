          "core",
          "backend"
         ],
         "additionalProperties": false,
         "properties": {
          "core": {
           "type": "array",
           "items": {
            "type": "string",
            "minLength": 1
           }
          },
          "backend": {
           "type": "array",
           "items": {
            "type": "string",
            "minLength": 1
           }
          }
         }
        }
       }
