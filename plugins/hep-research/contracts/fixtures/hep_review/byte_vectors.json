  {"name": "duplicate_key_escaped", "input": "{\"id\":1,\"\\u0069d\":2}", "code": "json.duplicate_key"},
  {"name": "minus_zero", "input": "[-0]", "code": "json.minus_zero"},
  {"name": "float_decimal", "input": "[1.0]", "code": "json.float"},
