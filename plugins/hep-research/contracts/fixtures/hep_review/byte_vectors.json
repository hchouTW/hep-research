  {"name": "chinese_and_emoji", "input": "\"\\u4e2d\\u6587\\ud83d\\ude00\"", "expected_hex": "22e4b8ade69687f09f988022"},
  {"name": "combining_not_normalized", "input": "[\"e\\u0301\",\"\\u00e9\"]", "expected_hex": "5b2265cc81222c22c3a9225d"},
  {"name": "del_and_line_separators_raw", "input": "\"\\u007f\\u2028\\u2029\"", "expected_hex": "227fe280a8e280a922"},
  {"name": "safe_integer_boundaries", "input": "[9007199254740991,-9007199254740991,0,-1,10]", "expected_text": "[9007199254740991,-9007199254740991,0,-1,10]", "expected_hex": "5b393030373139393235343734303939312c2d393030373139393235343734303939312c302c2d312c31305d"},
  {"name": "nested_objects_sorted_arrays_kept", "input": "{ \"b\" : {\"d\":1, \"c\":[3,1,2]}, \"a\":true, \"A\":null, \"e\":[], \"f\":{} }", "expected_text": "{\"A\":null,\"a\":true,\"b\":{\"c\":[3,1,2],\"d\":1},\"e\":[],\"f\":{}}", "expected_hex": "7b2241223a6e756c6c2c2261223a747275652c2262223a7b2263223a5b332c312c325d2c2264223a317d2c2265223a5b5d2c2266223a7b7d7d"},
  {"name": "booleans_null_false", "input": "[true,false,null]", "expected_text": "[true,false,null]", "expected_hex": "5b747275652c66616c73652c6e756c6c5d"},
  {"name": "key_order_is_ascii_codepoint", "input": "{\"b_1\":1,\"a\":2,\"B\":3,\"_z\":4,\"a1\":5}", "expected_text": "{\"B\":3,\"_z\":4,\"a\":2,\"a1\":5,\"b_1\":1}", "expected_hex": "7b2242223a332c225f7a223a342c2261223a322c226131223a352c22625f31223a317d"}
 ],
 "reject": [
