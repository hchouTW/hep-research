  {
   "operation_id": "enc",
   "summary": "Equivalent noise charge of a charge-sensitive amplifier with a CR-(RC)^n shaper from capacitance, series white, parallel (leakage and R_p) and 1/f noise and the peaking time, with the per-term split, the dominant term and the optimum series-parallel peaking time",
   "invocation": {
    "kind": "cli",
    "output": "json-stdout",
    "options": [
     {
      "flag": "--capacitance",
      "input": "capacitance"
     },
     {
      "flag": "--peaking",
      "input": "peaking"
     },
     {
      "flag": "--order",
      "input": "order"
     },
     {
      "flag": "--en",
      "input": "en"
     },
     {
      "flag": "--leakage",
      "input": "leakage"
     },
     {
      "flag": "--rp",
      "input": "rp"
     },
     {
      "flag": "--af",
      "input": "af"
     },
     {
      "flag": "--temperature",
      "input": "temperature"
     },
     {
      "flag": "--status",
      "input": "status"
     }
    ]
   },
   "inputs": [
    {
     "name": "capacitance",
     "kind": "capacitance",
     "unit": "pF",
     "required": true,
     "constraint": "total input capacitance, > 0"
    },
    {
     "name": "peaking",
     "kind": "time",
     "unit": "ns",
     "required": true,
     "constraint": "peaking time t_p = n tau, > 0"
    },
    {
     "name": "order",
     "kind": "parameter",
     "unit": "1",
     "required": false,
     "constraint": "shaper order n of CR-(RC)^n, integer >= 1",
     "default": 1
    },
    {
     "name": "en",
     "kind": "noise_density",
     "unit": "nV/sqrt(Hz)",
     "required": false,
     "constraint": "series white noise density, >= 0",
     "default": 0.0
    },
    {
     "name": "leakage",
     "kind": "current",
     "unit": "nA",
     "required": false,
     "constraint": "leakage current, >= 0",
     "default": 0.0
    },
    {
     "name": "rp",
     "kind": "resistance",
     "unit": "ohm",
     "required": false,
     "constraint": "parallel (bias or feedback) resistance, > 0; omitted means no R_p noise"
    },
    {
     "name": "af",
     "kind": "noise_coefficient",
     "unit": "V^2",
     "required": false,
     "constraint": "1/f coefficient A_f (density A_f/f), >= 0",
     "default": 0.0
    },
    {
     "name": "temperature",
     "kind": "temperature",
     "unit": "K",
     "required": false,
     "constraint": "temperature of R_p for its thermal noise, > 0",
     "default": 300.0
    },
    {
     "name": "status",
     "kind": "parameter",
     "unit": "n/a",
     "required": false,
     "constraint": "one of the core artifact_statuses; echoed as status",
     "default": "unvalidated"
    }
   ],
   "outputs": [
    {
     "name": "status",
     "kind": "label",
     "unit": "n/a"
    },
    {
     "name": "command",
     "kind": "label",
     "unit": "n/a"
    },
    {
     "name": "assumptions",
     "kind": "label",
     "unit": "n/a"
    },
    {
     "name": "validity",
     "kind": "label",
     "unit": "n/a"
    },
    {
