     "name": "uncertainties",
     "kind": "parameter",
     "unit": "{u}",
     "required": true,
     "constraint": "one standard deviation per item, >= 0"
    },
    {
     "name": "rule",
     "kind": "parameter",
     "unit": "n/a",
     "required": false,
     "constraint": "linear (default) or quadrature (items declared independent)",
