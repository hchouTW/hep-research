  {
   "operation_id": "straight-line-acceptance",
   "summary": "Geometric acceptance of coaxial circular apertures for an isotropic flux in the straight-line limit (Sullivan's form for two apertures)",
   "invocation": {
    "kind": "cli",
    "output": "json-stdout",
    "options": [
     {
      "flag": "--z-m",
      "input": "z_m"
     },
     {
      "flag": "--radius-m",
      "input": "radius_m"
     },
     {
      "flag": "--lateral-offset-m",
      "input": "lateral_offset_m"
     },
     {
      "flag": "--status",
      "input": "status"
     }
    ]
   },
   "inputs": [
    {
     "name": "z_m",
     "kind": "length",
     "unit": "m",
     "required": true,
     "constraint": "aperture positions along the axis, distinct"
    },
    {
     "name": "radius_m",
     "kind": "length",
     "unit": "m",
     "required": true,
     "constraint": "aperture radii, > 0"
    },
    {
     "name": "lateral_offset_m",
     "kind": "length",
     "unit": "m",
     "required": true,
     "constraint": "lateral aperture offsets; zero for apertures on one straight axis"
    },
    {
     "name": "status",
     "kind": "parameter",
     "unit": "n/a",
     "required": false,
     "constraint": "one of the core artifact_statuses; echoed as status_label (default unvalidated)",
     "default": "unvalidated"
    }
   ],
   "outputs": [
    {
     "name": "acceptance_m2sr",
     "kind": "acceptance",
     "unit": "m2 sr"
    }
   ],
   "failure_states": [
    {
     "exit_code": 2,
     "status": "invalid-input",
     "meaning": "an argument is missing, malformed or out of range; stdout carries {\"status\": \"rejected\", ...} with the error"
    }
   ],
   "required_capabilities": [],
   "purposes": [
    "exploration",
    "fixed-execution",
    "validation"
   ],
   "side_effects": {
    "writes_files": false,
    "network": false,
    "subprocess": false
   },
