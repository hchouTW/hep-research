  {
   "operation_id": "straight-line-acceptance",
   "summary": "Geometric acceptance of coaxial circular apertures for an isotropic flux in the straight-line limit (Sullivan's form for two apertures)",
   "invocation": {
    "kind": "cli",
    "output": "json-stdout",
    "options": [
     {
      "flag": "--z-m",
      "input": "z_m"
     },
     {
      "flag": "--radius-m",
      "input": "radius_m"
     },
     {
      "flag": "--lateral-offset-m",
      "input": "lateral_offset_m"
     },
     {
      "flag": "--status",
      "input": "status"
     }
    ]
   },
   "inputs": [
    {
     "name": "z_m",
     "kind": "length",
     "unit": "m",
     "required": true,
     "constraint": "aperture positions along the axis, distinct"
    },
    {
     "name": "radius_m",
     "kind": "length",
     "unit": "m",
     "required": true,
     "constraint": "aperture radii, > 0"
    },
    {
     "name": "lateral_offset_m",
     "kind": "length",
     "unit": "m",
     "required": true,
     "constraint": "lateral aperture offsets; zero for apertures on one straight axis"
    },
    {
     "name": "status",
     "kind": "parameter",
     "unit": "n/a",
     "required": false,
     "constraint": "one of the core artifact_statuses; echoed as status_label (default unvalidated)",
     "default": "unvalidated"
    }
   ],
   "outputs": [
    {
     "name": "acceptance_m2sr",
     "kind": "acceptance",
     "unit": "m2 sr"
    }
   ],
   "failure_states": [
    {
     "exit_code": 2,
     "status": "invalid-input",
     "meaning": "an argument is missing, malformed or out of range; stdout carries {\"status\": \"rejected\", ...} with the error"
    }
   ],
   "required_capabilities": [],
   "purposes": [
    "exploration",
    "fixed-execution",
    "validation"
   ],
   "side_effects": {
    "writes_files": false,
    "network": false,
    "subprocess": false
   },
   "design": {
    "fidelity": "F1",
    "figures_of_merit": [
     {
      "id": "geometric-acceptance",
      "better": "larger",
      "unit": "m2 sr",
      "bound": "optimistic",
      "denominator": {
       "rigidity_GV": "number",
       "species": "string",
       "charge_sign": "string"
      },
      "value": {
       "path": "acceptance_m2sr"
      },
      "operation_args": [
       "straight-line-acceptance"
      ],
      "inputs": [
       {
        "input": "z_m",
        "from": {
         "parameter": {
          "role": "tracking",
          "name": "layer_positions_m",
          "unit": "m"
         }
        }
       },
       {
        "input": "radius_m",
        "from": {
         "parameter": {
          "role": "tracking",
          "name": "layer_aperture_radius_m",
          "unit": "m"
         }
        }
       },
       {
        "input": "lateral_offset_m",
        "from": {
         "parameter": {
          "role": "tracking",
          "name": "layer_lateral_offset_m",
          "unit": "m"
         }
        }
       }
      ],
      "free_inputs": [
       "status"
      ],
      "validity": [
       {
        "input": "lateral_offset_m",
        "min": 0,
        "max": 0,
        "note": "apertures on one straight axis: with lateral offsets (dog-leg) bending can raise one charge sign's acceptance, so the straight-line value is not an upper bound (ART-48)"
       }
      ],
      "required_upstreams": [],
      "assumptions": [
       "straight-line limit: no bending, no nuclear interactions, full detection efficiency",
       "isotropic flux",
       "circular coaxial apertures"
      ],
      "note": "an upper bound at every rigidity for coaxial apertures; loose at low rigidity, where bending removes tracks (F2 in-field tracking for compliance)"
     }
    ]
   }
