       {
        "input": "z_m",
        "from": {
         "parameter": {
          "role": "tracking",
          "name": "layer_positions_m",
          "unit": "m"
         }
        }
       },
       {
        "input": "radius_m",
        "from": {
         "parameter": {
          "role": "tracking",
          "name": "layer_aperture_radius_m",
          "unit": "m"
         }
        }
       },
       {
        "input": "lateral_offset_m",
        "from": {
         "parameter": {
          "role": "tracking",
          "name": "layer_lateral_offset_m",
          "unit": "m"
         }
        }
       }
      ],
      "free_inputs": [
       "status"
      ],
      "validity": [
       {
        "input": "lateral_offset_m",
        "min": 0,
        "max": 0,
        "note": "apertures on one straight axis: with lateral offsets (dog-leg) bending can raise one charge sign's acceptance, so the straight-line value is not an upper bound (ART-48)"
       }
      ],
      "required_upstreams": [],
      "assumptions": [
       "straight-line limit: no bending, no nuclear interactions, full detection efficiency",
