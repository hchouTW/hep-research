  {
   "operation_id": "budget-sum",
   "summary": "Sum of per-subsystem budget items with the linear (default) or quadrature sum of their uncertainties",
   "invocation": {
    "kind": "cli",
    "output": "json-stdout",
    "options": [
     {
      "flag": "--estimates",
      "input": "estimates"
     },
     {
      "flag": "--uncertainties",
      "input": "uncertainties"
     },
     {
      "flag": "--rule",
      "input": "rule"
     },
     {
      "flag": "--status",
      "input": "status"
     }
    ]
   },
   "inputs": [
    {
     "name": "estimates",
     "kind": "parameter",
     "unit": "{u}",
     "required": true,
     "constraint": "one estimate per item, >= 0"
    },
    {
     "name": "uncertainties",
     "kind": "parameter",
     "unit": "{u}",
     "required": true,
     "constraint": "one standard deviation per item, >= 0"
    },
    {
     "name": "rule",
     "kind": "parameter",
     "unit": "n/a",
     "required": false,
     "constraint": "linear (default) or quadrature (items declared independent)",
     "default": "linear"
    },
    {
     "name": "status",
     "kind": "parameter",
     "unit": "n/a",
     "required": false,
     "constraint": "one of the core artifact_statuses; echoed as status_label (default unvalidated)",
     "default": "unvalidated"
    }
   ],
   "outputs": [
    {
     "name": "total",
     "kind": "parameter",
     "unit": "{u}"
    },
    {
     "name": "uncertainty",
     "kind": "parameter",
     "unit": "{u}"
    }
   ],
   "failure_states": [
    {
     "exit_code": 2,
     "status": "invalid-input",
     "meaning": "an argument is missing, malformed or out of range; stdout carries {\"status\": \"rejected\", ...} with the error"
    }
   ],
   "required_capabilities": [],
   "purposes": [
    "exploration",
    "fixed-execution",
    "validation"
   ],
   "side_effects": {
