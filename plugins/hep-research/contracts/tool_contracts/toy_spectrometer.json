{
 "contract_version": "1.1.0",
 "tool_id": "toy-spectrometer",
 "entry": "skills/hep-detector/scripts/toy_spectrometer.py",
 "operations": [
  {
   "operation_id": "resolution",
   "summary": "Rigidity resolution of a toy spectrometer configuration: sigma(1/R)^2 = a^2 + (b/(beta R))^2 with the Gluckstern intrinsic and Highland scattering terms",
   "invocation": {
    "kind": "cli",
    "output": "json-stdout",
    "positionals": [
     {
      "position": 0,
      "input": "config"
     }
    ],
    "options": [
     {
      "flag": "--species",
      "input": "species"
     },
     {
      "flag": "--rigidity",
      "input": "rigidity"
     },
     {
      "flag": "--era",
      "input": "era"
     }
    ]
   },
   "inputs": [
    {
     "name": "config",
     "kind": "path",
     "unit": "n/a",
     "required": true,
     "constraint": "JSON configuration",
     "fields": [
      {
       "field": "field",
       "kind": "parameter",
       "unit": "n/a",
       "constraint": "{field_tesla, lever_arm_m}"
      },
      {
       "field": "layers",
       "kind": "parameter",
       "unit": "n/a",
       "constraint": "[{name, z_m, resolution_um, grammage_g_cm2, radiation_length_g_cm2, composition, measuring, charge_resolution}]"
      },
      {
       "field": "species",
       "kind": "parameter",
       "unit": "n/a",
       "constraint": "[{name, Z, A, mass_gev, fraction, spectrum}]"
      }
     ]
    },
    {
     "name": "species",
     "kind": "parameter",
     "unit": "n/a",
     "required": true,
     "constraint": "a species name from the configuration"
    },
    {
     "name": "rigidity",
     "kind": "rigidity",
     "unit": "GV",
     "required": true,
     "constraint": "rigidities, > 0"
    },
    {
     "name": "era",
     "kind": "parameter",
     "unit": "n/a",
     "required": false,
     "constraint": "era name (default the first)"
    }
   ],
   "outputs": [
    {
     "name": "points[].relative_resolution",
     "kind": "relative-resolution",
     "unit": "1"
    }
   ],
   "failure_states": [
    {
     "exit_code": 1,
     "status": "failed",
     "meaning": "the configuration's content is invalid"
    },
    {
     "exit_code": 2,
     "status": "invalid-input",
     "meaning": "an argument or the configuration file is missing or malformed"
    },
    {
     "exit_code": 3,
     "status": "incomplete",
     "meaning": "NumPy is not installed (generate only)"
    }
   ],
   "required_capabilities": [],
   "purposes": [
    "exploration",
    "fixed-execution",
    "validation"
   ],
   "side_effects": {
    "writes_files": false,
    "network": false,
    "subprocess": false
   },
   "design": {
    "fidelity": "F2",
    "figures_of_merit": [
     {
      "id": "momentum-resolution-core",
      "better": "smaller",
      "unit": "1",
      "bound": "estimate",
      "denominator": {
       "rigidity_GV": "number",
       "species": "string"
      },
      "value": {
       "path": "points.0.relative_resolution"
      },
      "uncertainty": {
       "relative": 0.25,
       "coverage": 0.6827,
       "interval": "central",
       "distribution": "gaussian"
      },
      "operation_args": [
       "resolution"
      ],
      "inputs": [
       {
        "input": "config",
        "from": {
         "config": {
          "object": {
           "name": {
            "const": "design candidate (generated by evaluate_design.py)"
           },
           "status": {
            "const": "synthetic"
           },
           "field": {
            "object": {
             "field_tesla": {
              "parameter": {
               "role": "bending",
               "name": "field_T",
               "unit": "T"
              }
             },
             "lever_arm_m": {
              "span": {
               "parameter": {
                "role": "tracking",
                "name": "layer_positions_m",
                "unit": "m"
               }
              }
             }
            }
           },
           "layers": {
            "list": [
             {
              "zip": {
               "name": {
                "const": "measuring layer"
               },
               "z_m": {
                "parameter": {
                 "role": "tracking",
                 "name": "layer_positions_m",
                 "unit": "m"
                }
               },
               "resolution_um": {
                "parameter": {
                 "role": "tracking",
                 "name": "point_resolution_um",
                 "unit": "um"
                }
               },
               "grammage_g_cm2": {
                "parameter": {
                 "role": "tracking",
                 "name": "layer_x_over_x0",
                 "unit": "1"
                }
               },
               "radiation_length_g_cm2": {
                "const": 1.0
               },
               "composition": {
                "const": "declared"
               },
               "measuring": {
                "const": true
               },
               "charge_resolution": {
                "const": [
                 0.08,
                 0.03
                ]
               }
              }
             },
             {
              "object": {
               "name": {
                "const": "passive material"
               },
               "z_m": {
                "product": [
                 {
                  "span": {
                   "parameter": {
                    "role": "tracking",
                    "name": "layer_positions_m",
                    "unit": "m"
                   }
                  }
                 },
                 {
                  "const": 0.5
                 }
                ]
               },
               "resolution_um": {
                "const": 0.0
               },
               "grammage_g_cm2": {
                "parameter": {
                 "role": "tracking",
                 "name": "passive_x_over_x0",
                 "unit": "1"
                }
               },
               "radiation_length_g_cm2": {
                "const": 1.0
               },
               "composition": {
                "const": "declared"
               },
               "measuring": {
                "const": false
               }
              }
             }
            ]
           },
           "charge": {
            "const": {
             "estimator": "truncated-mean",
             "drop_highest": 2,
             "tail_fraction": 0.05,
             "tail_scale": 0.3
            }
           },
           "velocity": {
            "const": {
             "sigma_beta": 0.001
            }
           },
           "species": {
            "list": [
             {
              "object": {
               "name": {
                "species": "tool_name"
               },
               "Z": {
                "species": "charge_number"
               },
               "A": {
                "species": "mass_number"
               },
               "mass_gev": {
                "species": "mass_GeV"
               },
               "fraction": {
                "const": 1.0
               },
               "spectrum": {
                "const": {
                 "kind": "power-law",
                 "index": 2.7,
                 "r_min_gv": 1.0,
                 "r_max_gv": 10000.0
                }
               }
              }
             }
            ]
           },
           "periods": {
            "const": {
             "count": 1,
             "duration_s": 1000.0,
             "rate_hz": 1.0,
             "live_fraction": 1.0
            }
           },
           "eras": {
            "const": [
             {
              "name": "era-1",
              "first_period": 0
             }
            ]
           }
          }
         }
        }
       },
       {
        "input": "species",
        "from": {
         "species": "tool_name"
        }
       },
       {
        "input": "rigidity",
        "from": {
         "denominator": "rigidity_GV"
        }
       }
      ],
      "required_upstreams": [],
      "assumptions": [
       "Gaussian smearing in 1/R",
       "Gluckstern intrinsic term (equally spaced layers)",
       "Highland scattering without the log term",
       "uniform field"
      ],
      "note": "FID-01: an estimate that can differ from the exact fit of tracker_resolution.py by a few percent to more than ten percent; the 25% relative uncertainty covers that, so the two never corroborate each other"
     }
    ]
   }
  }
 ]
}
