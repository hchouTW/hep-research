{"$comment": "Rule and obligation registry (v6.3 D12a, contracts/rules/registry.json): which rules exist, what each needs, how its outcomes map to the five obligation states, which V acceptance cases it answers, and which checks a change to a path must run. Structure only: contracts/rule_registry.py adds the cross-field rules (five-state reason codes for new or changed rules, unique IDs, tests named for running V cases, existing test modules in the impact map).",
 "type": "object",
 "required": ["registry_version", "states", "rules", "v_cases", "impact"],
 "additionalProperties": false,
 "properties": {
  "$comment": {"type": "string"},
  "registry_version": {"$comment": "1.1.0: rule source digests (source_sha256), phase slices and work packages; 1.2.0: rules keyed by (rule_id, version), a retired version stays listed", "type": "string", "enum": ["1.0.0", "1.1.0", "1.2.0"]},
  "states": {"$comment": "the five obligation states, in this order", "type": "array", "items": {"$ref": "#/$defs/state"}},
  "rules": {"type": "array", "items": {"$ref": "#/$defs/rule"}},
  "v_cases": {"type": "array", "items": {"$ref": "#/$defs/v_case"}},
  "impact": {"type": "array", "items": {"$ref": "#/$defs/impact_group"}}
 },
 "$defs": {
  "state": {"type": "string", "enum": ["satisfied", "violated", "not_applicable", "unverified", "unsupported"]},
  "code": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"},
  "codes": {"type": "array", "items": {"$ref": "#/$defs/code"}},
  "text": {"type": "string", "minLength": 1},
  "texts": {"type": "array", "items": {"$ref": "#/$defs/text"}},
  "version": {"$comment": "registry 1.2.0 (release R2): a SemVer version, a pre-release allowed (1.1.0-dev.1)", "type": "string", "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"},
  "outcome_contract": {"$comment": "reason codes per state; every state needs at least one code for a new or changed rule",
   "type": "object", "required": ["satisfied", "violated", "not_applicable", "unverified", "unsupported"], "additionalProperties": false,
   "properties": {"satisfied": {"$ref": "#/$defs/codes"}, "violated": {"$ref": "#/$defs/codes"},
                  "not_applicable": {"$ref": "#/$defs/codes"}, "unverified": {"$ref": "#/$defs/codes"},
                  "unsupported": {"$ref": "#/$defs/codes"}}},
  "rule": {"type": "object",
   "required": ["rule_id", "version", "layer", "suites", "kind", "prerequisites", "applicability", "outcome_contract",
                "legacy_codes", "native_from", "v_cases", "waivable", "accepted_applicability_facts", "owner",
                "review_status", "lifecycle"],
   "additionalProperties": false,
   "properties": {
    "rule_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z0-9][a-z0-9_-]*)+$"},
    "version": {"$ref": "#/$defs/version"},
    "layer": {"type": "string", "enum": ["L1", "L2", "L3"]},
    "suites": {"$comment": "suites that require the rule; empty for a legacy rule no suite requires yet", "type": "array",
               "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*/v\\d+$"}},
    "kind": {"$comment": "legacy: an existing rule as it is; new or changed: needs a full outcome contract", "type": "string",
             "enum": ["legacy", "new", "changed"]},
    "prerequisites": {"$ref": "#/$defs/texts"},
    "applicability": {"$ref": "#/$defs/text"},
    "outcome_contract": {"anyOf": [{"type": "string", "const": "pending"}, {"$ref": "#/$defs/outcome_contract"}]},
    "legacy_codes": {"$ref": "#/$defs/codes"},
    "native_from": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/text"}]},
    "v_cases": {"type": "array", "items": {"type": "string", "pattern": "^V\\d{2}$"}},
    "waivable": {"type": "boolean"},
    "accepted_applicability_facts": {"$ref": "#/$defs/texts"},
    "owner": {"$ref": "#/$defs/text"},
    "review_status": {"type": "string", "enum": ["unreviewed", "self-reviewed", "reviewed"]},
    "lifecycle": {"type": "string", "enum": ["legacy", "proposed", "shadow", "enforcing", "deprecated", "retired"]},
    "source_sha256": {"$comment": "registry 1.1.0: function-level source digest of this rule version's implementation (contracts/analysis_checks/source_digest.py); a change without a new version fails the registry check", "type": "string", "pattern": "^[0-9a-f]{64}$"},
    "notes": {"type": "string"}}},
  "v_part": {"type": "object", "required": ["slice", "suite", "work_packages", "host", "status", "tests"],
   "additionalProperties": false,
   "properties": {
    "slice": {"$comment": "P0-P2: phases of the cross-artifact check architecture (registry 1.1.0)", "type": "string", "enum": ["M1", "M2a", "M2b", "M2c", "D11b", "M3", "P0", "P1", "P2"]},
    "suite": {"anyOf": [{"type": "null"}, {"type": "string", "enum": ["chain", "model", "ratio", "run", "all"]}]},
    "work_packages": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^(D\\d{2}[a-d]?|P[0-2]\\.\\d{2}|WP-R)$"}},
    "host": {"$ref": "#/$defs/text"},
    "status": {"type": "string", "enum": ["not-run", "expected-failure", "required-before-enforcement", "passing"]},
    "tests": {"$comment": "unittest IDs (module.Class.test) that run this part", "type": "array",
              "items": {"type": "string", "pattern": "^tests(\\.[A-Za-z_][A-Za-z0-9_]*)+$"}}}},
  "v_case": {"type": "object", "required": ["v_id", "scenario", "expected", "parts"], "additionalProperties": false,
   "properties": {"v_id": {"type": "string", "pattern": "^V\\d{2}$"}, "scenario": {"$ref": "#/$defs/text"},
                  "expected": {"$ref": "#/$defs/text"},
                  "parts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/v_part"}}}},
  "impact_group": {"type": "object", "required": ["id", "change", "patterns", "checks", "not_available", "full"],
   "additionalProperties": false,
   "properties": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "change": {"$ref": "#/$defs/text"},
    "patterns": {"$comment": "paths relative to the plugin root; '**' crosses folders (PurePosixPath.full_match)",
                 "type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}},
    "checks": {"$comment": "test modules (tests.x.test_y) or run_all_checks parts (part:static, ...)", "type": "array",
               "items": {"type": "string", "pattern": "^(tests(\\.[A-Za-z_][A-Za-z0-9_]*)+|part:(all|units|checks|static|ams-optional))$"}},
    "not_available": {"$comment": "checks the change needs that do not exist yet; any entry forces the full closure",
                      "$ref": "#/$defs/texts"},
    "full": {"$comment": "true: a change here always runs the full closure", "type": "boolean"}}}
 }
}
