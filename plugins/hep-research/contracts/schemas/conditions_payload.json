{
 "$comment": "conditions-payload/1 (R32, K07; contract-map.md): one resolved conditions payload. It holds the identity and the semantics of a payload and a digest of its native content, never constants. payload_id is the canonical SHA-256 of everything except payload_id and tag: a run records identities, not tags. geometry_id is the identity of contracts/schemas/ext_computational_run.json (D2). Read by contracts/conditions.py, not an artifact type.",
 "type": "object",
 "required": ["schema", "payload_id", "tag", "kind", "producer", "iov", "parametrization", "frame", "derived_against", "constraints_used",
              "unconstrained_modes", "independent_validation", "origin", "content_sha256", "required_extensions"],
 "additionalProperties": false,
 "properties": {
  "schema": {"const": "conditions-payload/1"},
  "payload_id": {"$ref": "reconstruction_common.json#/$defs/sha256"},
  "tag": {"$comment": "quoted exactly as its source gives it (N11); it selects a payload and identifies nothing", "$ref": "reconstruction_common.json#/$defs/name"},
  "kind": {"enum": ["calibration-constants", "channel-mask", "alignment-parameters"]},
  "producer": {"$comment": "a step identity, or external with the source named", "type": "object", "required": ["kind"], "additionalProperties": false,
   "properties": {"kind": {"enum": ["step", "external"]}, "step_id": {"$ref": "reconstruction_common.json#/$defs/name"},
                  "source": {"$ref": "reconstruction_common.json#/$defs/name"}}},
  "iov": {"$ref": "#/$defs/iov"},
  "parametrization": {"type": "object", "required": ["name", "version"], "additionalProperties": false,
   "properties": {"name": {"$ref": "reconstruction_common.json#/$defs/name"}, "version": {"$ref": "reconstruction_common.json#/$defs/name"}}},
  "frame": {"type": "object", "required": ["name", "kind"], "additionalProperties": false,
   "properties": {"name": {"$ref": "reconstruction_common.json#/$defs/name"}, "kind": {"enum": ["local", "global"]}}},
  "alignment": {"$comment": "which degrees of freedom per surface or structure, in which frame, at which level of the hierarchy",
   "type": "object", "required": ["degrees_of_freedom"], "additionalProperties": false,
   "properties": {"degrees_of_freedom": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/degree_of_freedom"}}}},
  "derived_against": {"$comment": "alignment: the nominal geometry its deltas apply to; calibration: the upstream payload identities assumed, in chain order",
   "type": "object", "additionalProperties": false,
   "properties": {"geometry_id": {"$ref": "reconstruction_common.json#/$defs/sha256"},
                  "upstream_payloads": {"type": "array", "items": {"$ref": "reconstruction_common.json#/$defs/sha256"}}}},
  "uncertainty": {"$comment": "when available", "type": "object", "required": ["representation", "reference"], "additionalProperties": false,
   "properties": {"representation": {"$ref": "reconstruction_common.json#/$defs/name"}, "reference": {"$ref": "reconstruction_common.json#/$defs/name"}}},
  "loop": {"$comment": "R36, when produced in an outer loop", "type": "object", "required": ["family", "round"], "additionalProperties": false,
   "properties": {"family": {"$ref": "reconstruction_common.json#/$defs/name"}, "round": {"type": "integer", "minimum": 1}}},
  "constraints_used": {"$ref": "reconstruction_common.json#/$defs/names"},
  "unconstrained_modes": {"$ref": "reconstruction_common.json#/$defs/names"},
  "independent_validation": {"$comment": "never a member of constraints_used (Section 9.6)", "$ref": "reconstruction_common.json#/$defs/names"},
  "origin": {"$comment": "nominal: ideal geometry or unit gain for simulation; never presented as measured", "enum": ["nominal", "measured"]},
  "derived_from": {"$comment": "R33: the payload a subset was derived from", "$ref": "reconstruction_common.json#/$defs/sha256"},
  "content_sha256": {"$ref": "reconstruction_common.json#/$defs/sha256"},
  "required_extensions": {"$ref": "reconstruction_common.json#/$defs/extension_ids"},
  "optional_extensions": {"$ref": "reconstruction_common.json#/$defs/extension_ids"},
  "extensions": {"$ref": "reconstruction_common.json#/$defs/extension_fields"}
 },
 "$defs": {
  "iov": {"$comment": "Section 9.3: predicates that must all hold; endpoints are explicit", "type": "object", "required": ["predicates"], "additionalProperties": false,
   "properties": {"predicates": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["coordinate", "start", "end", "closure"],
    "additionalProperties": false, "properties": {"coordinate": {"$ref": "reconstruction_common.json#/$defs/name"}, "start": {"type": "number"},
                                                  "end": {"type": "number"}, "closure": {"enum": ["half-open", "closed"]}}}}}},
  "degree_of_freedom": {"type": "object", "required": ["structure", "parameters", "frame", "level"], "additionalProperties": false,
   "properties": {"structure": {"$ref": "reconstruction_common.json#/$defs/name"}, "parameters": {"$ref": "reconstruction_common.json#/$defs/names"},
                  "frame": {"enum": ["local", "global"]}, "level": {"$ref": "reconstruction_common.json#/$defs/name"}}}
 }
}
