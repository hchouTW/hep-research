   "items": {
    "type": "string"
   }
  },
  "underflow_overflow": {
   "type": "string"
  },
  "conditions": {
   "type": "string"
  },
  "provenance": {
   "type": "string"
  },
  "matrix_ref": {
   "type": "string"
  },
