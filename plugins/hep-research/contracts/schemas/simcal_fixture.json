{
 "description": "simcal (simulator parameter calibration): a stage-graph or design fixture holding a contract and a plan (section 17).",
 "type": "object",
 "required": [
  "schema",
  "fixture",
  "description",
  "status",
  "contract",
  "plan"
 ],
 "additionalProperties": false,
 "properties": {
  "schema": {
   "enum": ["simcal-fixture/1", "calibration-fixture/1"]
  },
  "fixture": {
   "type": "string",
   "minLength": 1
  },
  "description": {
   "type": "string",
   "minLength": 1
  },
  "status": {
   "const": "synthetic"
  },
  "contract": {
   "anyOf": [
    {
     "type": "object",
     "required": [
      "stage_graph",
      "parameters",
      "references"
     ],
     "additionalProperties": false,
     "properties": {
      "stage_graph": {
       "$ref": "simcal_stage_graph.json"
      },
      "parameters": {
       "type": "array",
       "items": {
        "type": "object",
        "required": [
         "name",
         "role",
         "nodes"
        ],
        "additionalProperties": false,
        "properties": {
         "name": {
          "type": "string",
          "minLength": 1
         },
         "role": {
          "enum": [
           "theta",
           "phi",
           "psi"
          ]
         },
         "nodes": {
          "type": "array",
          "items": {
           "type": "string",
           "minLength": 1
          },
          "minItems": 1
         },
         "mechanism": {
          "$ref": "simcal_mechanism.json"
         },
         "physical_bounds": {
          "type": "array",
          "items": {
           "type": "number"
          }
         },
         "sampling_bounds": {
          "type": "array",
          "items": {
           "type": "number"
          }
         },
         "source": {
          "type": "string",
          "minLength": 1
         },
         "uncertainty": {
          "enum": [
           "negligible",
           "non-negligible"
          ]
         },
         "index": {
          "$ref": "simcal_parameter_index.json"
         },
         "spec_pointer": {
          "type": "string",
          "minLength": 1
         },
         "bindings": {
          "type": "array",
          "items": {
           "type": "object",
           "required": [
            "document",
            "pointer"
           ],
           "additionalProperties": false,
           "properties": {
            "document": {
             "enum": [
              "detector-spec",
              "alignment-overlay",
              "simulation-request",
              "run-card",
              "response-pipeline",
              "condition-snapshot",
              "reconstruction",
              "evaluator"
             ]
            },
            "pointer": {
             "type": "string"
            }
           }
          },
          "$comment": "g4sim (section 5.1, 11.4): the specification fields the parameter is bound to, by JSON Pointer; the theta and phi bindings are the mask list of the model identity, locked with the contract"
         }
        }
       },
       "minItems": 1
      },
      "references": {
       "type": "array",
       "items": {
        "$ref": "simcal_reference.json"
       }
      }
     }
    },
    {
     "$ref": "simcal_contract.json"
    }
   ]
  },
  "plan": {
   "anyOf": [
    {
     "type": "object",
     "required": [
      "kernels"
     ],
     "additionalProperties": false,
     "properties": {
      "kernels": {
       "type": "object"
      }
     }
    },
    {
     "$ref": "simcal_plan.json"
    }
   ]
  },
  "release": {
   "$ref": "simcal_data_release.json"
  }
 },
 "$comment": "simcal-fixture/1: a stage-graph fixture of phase 0 (section 17), graph structure only. A design fixture (phase 1) holds a full simcal-contract/1 and simcal-plan/1 and the synthetic calibration release its contract declares."
}
