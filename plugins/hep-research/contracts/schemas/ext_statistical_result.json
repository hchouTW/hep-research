{"$comment": "Owner: hep-statistics. Paradigm-specific requirements are enforced in contracts.validate. Since 2.2.0: typed p-value bounds, coverage, fit diagnostics and model provenance; their semantic rules (contracts.validate._stat_semantics) apply natively from contract 2.2.0 and to older artifacts only with --strict.",
 "type": "object",
 "$defs": {
  "p_bound": {"type": "object", "required": ["kind", "value", "cl", "convention"], "$comment": "since 2.2.0: a p-value the toys bound but do not measure (k = 0 or k = n exceedances)",
   "properties": {"kind": {"type": "string", "enum": ["upper", "lower"]}, "value": {"type": "number", "minimum": 0},
    "cl": {"type": "number", "exclusiveMinimum": 0}, "convention": {"type": "string"},
    "k": {"type": "integer", "minimum": 0}, "n": {"type": "integer", "minimum": 1}}}},
 "required": ["paradigm", "likelihood", "parameters_of_interest", "nuisances", "fit_status"],
 "properties": {
  "paradigm": {"type": "string", "enum": ["frequentist", "bayesian", "likelihood-only"]},
  "likelihood": {"type": "object", "properties": {"backend": {"type": "string", "$comment": "since 2.2.0"},
   "backend_version": {"type": "string"}, "model_ref": {"type": "string"}, "model_sha256": {"type": "string"}}},
  "parameters_of_interest": {"type": "array", "items": {"type": "string"}, "minItems": 1},
  "nuisances": {"type": "array"}, "constraints": {"type": "array"},
  "test_statistic": {"type": "string"},
  "construction": {"type": "string", "enum": ["neyman", "feldman-cousins", "cls", "asymptotic", "profile-likelihood-wilks", "berger-boos", "cousins-highland", "toy-calibrated-profile", "other"]},
  "significance": {"type": "object", "$comment": "since 1.1.0; a scan without global_p is unresolved (stats.lee_missing)",
   "properties": {
    "local_p": {"type": "number", "minimum": 0}, "local_z": {"type": "number"},
    "global_p": {"type": "number", "minimum": 0}, "global_z": {"type": "number"},
    "local_p_bound": {"$ref": "#/$defs/p_bound"}, "global_p_bound": {"$ref": "#/$defs/p_bound"},
    "global_n_toys": {"type": "integer", "minimum": 1, "$comment": "since 2.2.0"},
    "trials_method": {"type": "string", "enum": ["none-needed", "toys", "gross-vitells", "analytic-bound"]},
    "scan": {"type": "object", "required": ["parameters"], "properties": {
     "parameters": {"type": "array", "items": {"type": "string"}, "minItems": 1},
     "ranges": {"type": "array", "items": {"type": "array", "items": {"type": "number"}}}}}}},
  "expected": {"type": "object", "$comment": "since 1.1.0", "properties": {
   "median": {"type": "number"}, "band_1sigma": {"type": "array", "items": {"type": "number"}},
   "band_2sigma": {"type": "array", "items": {"type": "number"}}, "method": {"type": "string"}}},
  "uncertainty_breakdown": {"type": "object", "$comment": "since 1.1.0", "required": ["method"], "properties": {
   "method": {"type": "string", "enum": ["group-freeze", "impacts", "other"]}, "order": {"type": "array", "items": {"type": "string"}},
   "groups": {"type": "array", "items": {"type": "object", "required": ["name"]}}, "closure": {"type": "object"}}},
  "goodness_of_fit": {"type": "object", "$comment": "since 1.1.0", "required": ["statistic"], "properties": {
   "statistic": {"type": "string"}, "p_value": {"type": "number", "minimum": 0},
   "calibration": {"type": "string", "enum": ["asymptotic", "toys"]}, "n_toys": {"type": "integer", "minimum": 1}}},
  "coverage": {"type": "object", "$comment": "method is free text (how coverage was or was not studied); typed fields since 2.2.0: check names the evidence, and an object without check is an untyped placeholder (unresolved)",
   "properties": {"method": {"type": "string"}, "check": {"type": "string", "enum": ["toys", "exact-construction", "analytic", "not-checked"]},
    "n_toys": {"type": "integer", "minimum": 0}, "coverage": {"type": "number", "minimum": 0},
    "interval": {"type": "array", "items": {"type": "number"}}, "cl": {"type": "number", "exclusiveMinimum": 0},
    "ensemble": {"type": "string"}, "failure_policy": {"type": "string"},
    "failures": {"type": "integer", "minimum": 0}, "points": {"type": "array"}}},
  "fit_diagnostics": {"type": "object", "$comment": "since 2.2.0: the producing code's fit verdicts (core/stats/fit_diagnostics.py)",
   "properties": {"status": {"type": "string", "enum": ["ok", "failed", "incomplete"]}}},
  "priors": {"type": "array", "items": {"type": "object", "required": ["parameter", "form"]}},
  "sampler": {"type": "object"}, "convergence": {"type": "object"},
  "fit_status": {"type": "string", "enum": ["converged", "failed", "not-run", "converged-with-warnings"]},
  "results": {"type": "object"}
 }}
