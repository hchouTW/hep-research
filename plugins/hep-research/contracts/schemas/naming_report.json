{
 "$comment": "naming_report.json: contracts/naming_check.py check (spec \u00a76.5). The outer shape is contracts/audit_report.py (status pass/fail/incomplete/input-error, exit 0/1/3/2); the naming section counts the five states and digests every input of the judgement.",
 "type": "object",
 "required": [
  "report_version",
  "tool",
  "scope",
  "status",
  "exit_code",
  "checks_run",
  "checks_not_run",
  "findings",
  "notes",
  "inputs",
  "naming"
 ],
 "additionalProperties": false,
 "properties": {
  "report_version": {
   "const": "1.0.0"
  },
  "tool": {
   "const": "naming_check"
  },
  "scope": {
   "type": "object"
  },
  "status": {
   "type": "string",
   "enum": [
    "pass",
    "fail",
    "incomplete",
    "input-error"
   ]
  },
  "exit_code": {
   "type": "integer",
   "enum": [
    0,
    1,
    2,
    3
   ]
  },
  "checks_run": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "checks_not_run": {
   "type": "array",
   "items": {
    "type": "object"
   }
  },
  "findings": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/finding"
   }
  },
  "notes": {
   "type": "array"
  },
  "inputs": {
   "type": "object"
  },
  "counts": {
   "type": "object"
  },
  "note": {
   "type": "string"
  },
  "naming": {
   "type": "object",
   "required": [
    "counts",
    "inputs"
   ],
   "additionalProperties": false,
   "properties": {
    "counts": {
     "type": "object",
     "required": [
      "satisfied",
      "violated",
      "not_applicable",
      "unverified",
      "unsupported"
     ],
     "additionalProperties": false,
     "properties": {
      "satisfied": {
       "type": "integer",
       "minimum": 0
      },
      "violated": {
       "type": "integer",
       "minimum": 0
      },
      "not_applicable": {
       "type": "integer",
       "minimum": 0
      },
      "unverified": {
       "type": "integer",
       "minimum": 0
      },
      "unsupported": {
       "type": "integer",
       "minimum": 0
      }
     }
    },
    "inputs": {
     "type": "object"
    },
    "mode": {
     "type": "string",
     "enum": [
      "project",
      "gate"
     ]
    },
    "strict": {
     "type": "boolean"
    },
    "engine_version": {
     "type": "string"
    },
    "table": {
     "type": "array",
     "items": {
      "type": "object"
     }
    }
   }
  }
 },
 "$defs": {
  "finding": {
   "type": "object",
   "required": [
    "code",
    "severity",
    "location",
    "message",
    "suggested_action",
    "entity_id",
    "surface",
    "rule_id",
    "rule_version",
    "predicate",
    "state",
    "reason_code",
    "current",
    "proposed",
    "issue",
    "evidence",
    "confidence",
    "contract_level",
    "action",
    "handoff"
   ],
   "additionalProperties": false,
   "properties": {
    "code": {
     "type": "string",
     "minLength": 1
    },
    "severity": {
     "type": "string",
     "enum": [
      "error",
      "unresolved",
      "warning"
     ]
    },
    "location": {
     "type": "string"
    },
    "message": {
     "type": "string"
    },
    "suggested_action": {
     "type": "string"
    },
    "entity_id": {
     "type": [
      "string",
      "null"
     ]
    },
    "surface": {
     "type": "string",
     "pattern": "^N(?:[1-9]|1[0-7])$"
    },
    "rule_id": {
     "type": "string",
     "minLength": 1
    },
    "rule_version": {
     "$ref": "common.json#/$defs/version"
    },
    "predicate": {
     "type": "string",
     "minLength": 1
    },
    "state": {
     "type": "string",
     "enum": [
      "satisfied",
      "violated",
      "not_applicable",
      "unverified",
      "unsupported"
     ]
    },
    "reason_code": {
     "type": "string",
     "minLength": 1
    },
    "current": {
     "type": [
      "string",
      "null"
     ]
    },
    "proposed": {
     "type": [
      "string",
      "null"
     ]
    },
    "issue": {
     "type": "string"
    },
    "evidence": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "confidence": {
     "type": [
      "string",
      "null"
     ],
     "enum": [
      "high",
      "medium",
      "low",
      null
     ]
    },
    "contract_level": {
     "type": [
      "string",
      "null"
     ],
     "enum": [
      "C0",
      "C1",
      "C2",
      "C3",
      "C4",
      null
     ]
    },
    "action": {
     "type": "string",
     "enum": [
      "none",
      "report-missing",
      "gather-evidence",
      "fix",
      "fix-with-change-set",
      "propose",
      "propose-then-change-set-after-approval",
      "propose-alias",
      "report-only"
     ]
    },
    "handoff": {
     "type": [
      "object",
      "null"
     ]
    },
    "known_gap": {
     "type": "boolean"
    }
   }
  }
 }
}
