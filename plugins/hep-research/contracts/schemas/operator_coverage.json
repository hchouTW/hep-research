{"$comment": "Operator coverage contract (v6.3 D04, contracts/semantics/coverage/): for one operator-semantics table, bound by its canonical digest, which catalog effects and which listed class members each operator covers, its stage, and its bounded factor effects. contracts/effect_catalog.py adds the cross-field checks.",
 "type": "object",
 "required": ["coverage_version", "table_id", "table_sha256", "catalog_version", "operators"],
 "additionalProperties": false,
 "properties": {
  "$comment": {"type": "string"},
  "coverage_version": {"type": "string", "enum": ["1.0.0"]},
  "table_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
  "table_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
  "catalog_version": {"type": "string", "enum": ["1.0.0"]},
  "operators": {"type": "array", "minItems": 1, "items": {"type": "object",
   "required": ["operator_id", "stage", "covers", "class_coverage"], "additionalProperties": false, "properties": {
    "operator_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
    "stage": {"type": "string", "enum": ["estimator", "normalization", "unfolding", "response", "calibration"]},
    "covers": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "class_coverage": {"$comment": "class id -> members covered; members null means undefined (every member unverified)",
     "type": "object", "additionalProperties": {"type": "object", "required": ["members", "basis"], "additionalProperties": false,
      "properties": {"members": {"anyOf": [{"type": "null"}, {"type": "array", "items": {"type": "string", "minLength": 1}}]},
                     "basis": {"type": "string", "minLength": 1}}}},
    "factors": {"type": "array", "items": {"type": "object", "required": ["effect", "power"], "additionalProperties": false,
     "properties": {"effect": {"type": "string", "minLength": 1}, "power": {"type": "integer"}}}}}}}
 }
}
