{
 "$comment": "Check context 1.0.0 (v6.3 D05a/D05b, docs/dev/v6.3/m2a-design.md): the frozen analysis intent of a chain bundle in item IDs and pointers only, never its own bundle's digest. contracts/analysis_checks/context.py adds the cross-field checks; the obligation inventory is generated (contracts/analysis_checks/obligations.py), never written by hand.",
 "type": "object",
 "required": [
  "context_version",
  "suite",
  "scope_axes",
  "bindings",
  "declarations"
 ],
 "additionalProperties": false,
 "properties": {
  "context_version": {
   "$comment": "1.1.0 (release R2, DR-2): roots and ratio roots carry no 'required'; a 1.1.0 context selects 1.1.0 or later suites (pre-releases included), a 1.0.0 context 1.0.x suites (contracts/analysis_checks/context.py version_findings)",
   "type": "string",
   "enum": [
    "1.0.0",
    "1.1.0"
   ]
  },
  "suite": {
   "type": "object",
   "required": [
    "id",
    "version"
   ],
   "additionalProperties": false,
   "properties": {
    "id": {
     "type": "string",
     "minLength": 1
    },
    "version": {
     "type": "string",
     "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
    }
   }
  },
  "spec": {
   "type": "string",
   "minLength": 1
  },
  "scope_axes": {
   "type": "object",
   "additionalProperties": {
    "type": "array",
    "minItems": 1,
    "items": {
     "type": "string",
     "minLength": 1
    }
   }
  },
  "roots": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "root_id",
     "quantity",
     "unit",
     "binning",
     "scope",
     "output"
    ],
    "additionalProperties": false,
    "properties": {
     "root_id": {
      "$ref": "#/$defs/id"
     },
     "quantity": {
      "type": "string",
      "minLength": 1
     },
     "unit": {
      "type": "string",
      "minLength": 1
     },
     "binning": {
      "$ref": "#/$defs/ref"
     },
     "scope": {
      "type": "string"
     },
     "output": {
      "$ref": "#/$defs/ref"
     },
     "required": {
      "type": "boolean"
     }
    }
   }
  },
  "recipe_instances": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "instance_id",
     "recipe",
     "scope",
     "variation",
     "role",
     "nominal",
     "calibrations"
    ],
    "additionalProperties": false,
    "properties": {
     "instance_id": {
      "$ref": "#/$defs/id"
     },
     "recipe": {
      "type": "string",
      "minLength": 1
     },
     "scope": {
      "type": "string"
     },
     "variation": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
     },
     "role": {
      "type": "string"
     },
     "nominal": {
      "anyOf": [
       {
        "type": "null"
       },
       {
        "type": "string"
       }
      ]
     },
     "calibrations": {
      "type": "object",
      "additionalProperties": {
       "type": "string"
      }
     }
    }
   }
  },
  "bindings": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "binding_id",
     "type",
     "from",
     "to"
    ],
    "additionalProperties": false,
    "properties": {
     "binding_id": {
      "$ref": "#/$defs/id"
     },
     "type": {
      "type": "string"
     },
     "from": {
      "$ref": "#/$defs/ref"
     },
     "to": {
      "$ref": "#/$defs/ref"
     }
    }
   }
  },
  "declarations": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "declaration_id",
     "type",
     "content"
    ],
    "additionalProperties": false,
    "properties": {
     "declaration_id": {
      "$ref": "#/$defs/id"
     },
     "type": {
      "type": "string"
     },
     "asserted_by": {
      "type": "object"
     },
     "basis": {
      "type": "object"
     },
     "content": {
      "type": "object"
     }
    }
   }
  },
  "obligations": {
   "type": "object",
   "required": [
    "generator",
    "suite",
    "items",
    "digest"
   ],
   "additionalProperties": false,
   "properties": {
    "generator": {
     "anyOf": [
      {
       "type": "object"
      },
      {
       "type": "array",
       "items": {
        "type": "object"
       }
      }
     ]
    },
    "suite": {
     "anyOf": [
      {
       "type": "object"
      },
      {
       "type": "array",
       "items": {
        "type": "object"
       }
      }
     ]
    },
    "items": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "obligation_id",
       "rule_id",
       "rule_version",
       "subject",
       "prerequisites"
      ]
     }
    },
    "digest": {
     "$ref": "revocation_event.json#/$defs/sha256"
    }
   }
  },
  "suites": {
   "$comment": "further suites this analysis is checked under (v6.3 M2b); the report claims only the suites listed",
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "version"
    ],
    "additionalProperties": false,
    "properties": {
     "id": {
      "type": "string",
      "minLength": 1
     },
     "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
     }
    }
   }
  },
  "ratio_roots": {
   "$comment": "ratio results of two chain roots (ratio-subset/v1): operands by root id, the scope axis they differ in",
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "root_id",
     "numerator",
     "denominator",
     "over_axis",
     "quantity",
     "unit"
    ],
    "additionalProperties": false,
    "properties": {
     "root_id": {
      "$ref": "#/$defs/id"
     },
     "numerator": {
      "type": "object",
      "required": [
       "root"
      ],
      "additionalProperties": false,
      "properties": {
       "root": {
        "type": "string"
       }
      }
     },
     "denominator": {
      "type": "object",
      "required": [
       "root"
      ],
      "additionalProperties": false,
      "properties": {
       "root": {
        "type": "string"
       }
      }
     },
     "over_axis": {
      "type": "string",
      "minLength": 1
     },
     "quantity": {
      "type": "string",
      "minLength": 1
     },
     "unit": {
      "type": "string",
      "minLength": 1
     },
     "required": {
      "type": "boolean"
     }
    }
   }
  },
  "models": {
   "$comment": "model instances (model-card/v1): a model-card item under a context id",
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "model_id",
     "item"
    ],
    "additionalProperties": false,
    "properties": {
     "model_id": {
      "$ref": "#/$defs/id"
     },
     "item": {
      "type": "string",
      "minLength": 1
     }
    }
   }
  },
  "evaluations": {
   "$comment": "likelihoods evaluated as a whole: one model, or several multiplied, with explicit cross-model shared parameters",
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "evaluation_id",
     "models"
    ],
    "additionalProperties": false,
    "properties": {
     "evaluation_id": {
      "$ref": "#/$defs/id"
     },
     "models": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "string",
       "minLength": 1
      }
     },
     "shared_parameters": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "parameter_id",
        "members"
       ],
       "additionalProperties": false,
       "properties": {
        "parameter_id": {
         "type": "string",
         "minLength": 1
        },
        "members": {
         "type": "array",
         "minItems": 1,
         "items": {
          "type": "object",
          "required": [
           "model",
           "parameter"
          ],
          "additionalProperties": false,
          "properties": {
           "model": {
            "type": "string",
            "minLength": 1
           },
           "parameter": {
            "type": "string",
            "minLength": 1
           }
          }
         }
        }
       }
      }
     }
    }
   }
  },
  "model_roots": {
   "$comment": "the root intent of a model bundle: an evaluation and its POI",
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "root_id",
     "evaluation",
     "poi"
    ],
    "additionalProperties": false,
    "properties": {
     "root_id": {
      "$ref": "#/$defs/id"
     },
     "evaluation": {
      "type": "string",
      "minLength": 1
     },
     "poi": {
      "type": "object",
      "required": [
       "model",
       "parameter"
      ],
      "additionalProperties": false,
      "properties": {
       "model": {
        "type": "string",
        "minLength": 1
       },
       "parameter": {
        "type": "string",
        "minLength": 1
       }
      }
     }
    }
   }
  }
 },
 "$defs": {
  "id": {
   "type": "string",
   "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
  },
  "ref": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "item": {
     "type": "string"
    },
    "pointer": {
     "type": "string"
    },
    "instance": {
     "type": "string"
    },
    "step": {
     "type": "string"
    },
    "prediction": {
     "type": "string"
    },
    "model": {
     "type": "string"
    },
    "aux_id": {
     "type": "string"
    }
   }
  }
 },
 "anyOf": [
  {
   "$comment": "a chain context (counting-chain, ratio-subset)",
   "required": [
    "spec",
    "roots",
    "recipe_instances"
   ]
  },
  {
   "$comment": "a model context (model-card/v1): models, evaluations and the root intent",
   "required": [
    "models",
    "evaluations",
    "model_roots"
   ]
  }
 ]
}
