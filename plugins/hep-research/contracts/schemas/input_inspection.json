{
 "$comment": "input-inspection/1 (contract-map.md; plan Sections 5.6, 5.7 SEL03; K15, K17): one bounded inspection. Holds the per-product input signatures, every probe with its reading scope, sampling rule, cost and unread portion, the declared budget and what was spent, the conflicts with the probe each needs, and why inspection stopped. Written by contracts/input_inspector.py and read by contracts/sidecar_reader.py, not an artifact type. It holds no file name (K15).",
 "type": "object",
 "required": ["schema", "state", "stop_reason", "budget", "spent", "signatures", "probes", "conflicts", "refused_declarations", "products_read", "products_unread", "required_extensions"],
 "additionalProperties": false,
 "properties": {
  "schema": {"const": "input-inspection/1"},
  "state": {"$comment": "complete: every input read and no conflict open. partial: something stayed unknown or in conflict with the budget intact. stopped: a budget ended inspection or none was declared (Section 5.6 item 5). not-needed: nothing to inspect (A16).",
   "enum": ["complete", "partial", "stopped", "not-needed"]},
  "stop_reason": {"anyOf": [{"type": "null"}, {"$ref": "reconstruction_common.json#/$defs/name"}]},
  "budget": {"$comment": "Section 5.6 item 5; plan K17 row: declared by the caller, never defaulted; null when none was declared or none was needed", "anyOf": [{"type": "null"}, {"$ref": "#/$defs/budget"}]},
  "spent": {"$ref": "#/$defs/budget"},
  "signatures": {"$comment": "input-signature/1 documents, each read by read_document in the semantic check", "type": "array", "items": {"type": "object"}},
  "probes": {"type": "array", "items": {"$ref": "#/$defs/probe"}},
  "conflicts": {"type": "array", "items": {"$ref": "#/$defs/conflict"}},
  "refused_declarations": {"$comment": "K15: what a caller offered that is not evidence, kept visible and not used", "type": "array", "items": {"$ref": "#/$defs/refused_declaration"}},
  "products_read": {"$ref": "reconstruction_common.json#/$defs/names"},
  "products_unread": {"$ref": "reconstruction_common.json#/$defs/names"},
  "required_extensions": {"$ref": "reconstruction_common.json#/$defs/extension_ids"},
  "optional_extensions": {"$ref": "reconstruction_common.json#/$defs/extension_ids"},
  "extensions": {"$ref": "reconstruction_common.json#/$defs/extension_fields"}
 },
 "$defs": {
  "budget": {"type": "object", "required": ["probes", "bytes", "seconds", "memory_bytes", "tools"], "additionalProperties": false,
   "properties": {"probes": {"type": "integer", "minimum": 0}, "bytes": {"type": "integer", "minimum": 0}, "seconds": {"type": "number", "minimum": 0},
    "memory_bytes": {"$comment": "rise of the peak resident size of the process during the inspection", "type": "integer", "minimum": 0}, "tools": {"$comment": "distinct registered readers", "type": "integer", "minimum": 0}}},
  "probe": {"$comment": "Section 5.6 item 2. probe and reader are null when no runtime reader exists for the input: nothing was read (K15).",
   "type": "object", "required": ["run", "probe", "reader", "reader_version", "parameters", "target", "outcome", "stop_reason", "cost", "read_scope", "sampling", "unread_bytes", "documents_refused", "warnings"],
   "additionalProperties": false,
   "properties": {"run": {"$ref": "reconstruction_common.json#/$defs/name"},
    "probe": {"anyOf": [{"type": "null"}, {"$ref": "reconstruction_common.json#/$defs/name"}]},
    "reader": {"anyOf": [{"type": "null"}, {"$ref": "reconstruction_common.json#/$defs/name"}]},
    "reader_version": {"anyOf": [{"type": "null"}, {"$ref": "reconstruction_common.json#/$defs/name"}]},
    "parameters": {"type": "object"}, "target": {"$ref": "reconstruction_common.json#/$defs/name"},
    "outcome": {"$comment": "read, partial (some of a file read, or only its container for a file of no known schema), failed, refused (K13 or a validator), not-run", "enum": ["read", "partial", "failed", "refused", "not-run"]},
    "stop_reason": {"anyOf": [{"type": "null"}, {"$ref": "reconstruction_common.json#/$defs/name"}]},
    "cost": {"type": "object", "required": ["bytes_read", "seconds", "memory_bytes"], "additionalProperties": false,
     "properties": {"bytes_read": {"type": "integer", "minimum": 0}, "seconds": {"type": "number", "minimum": 0}, "memory_bytes": {"type": "integer", "minimum": 0}}},
    "read_scope": {"$ref": "reconstruction_common.json#/$defs/name"}, "sampling": {"$ref": "reconstruction_common.json#/$defs/name"},
    "unread_bytes": {"$comment": "null when the size is not known", "anyOf": [{"type": "null"}, {"type": "integer", "minimum": 0}]},
    "documents_refused": {"$comment": "documents of this file the reader refused; they share one signature", "type": "integer", "minimum": 0},
    "warnings": {"$ref": "reconstruction_common.json#/$defs/names"}}},
  "conflict": {"$comment": "A46: both values stay, and the conflict names the probe it needs; probe_registered is false when no runtime reader offers that probe yet",
   "type": "object", "required": ["key", "scope", "values", "required_probe", "probe_registered"], "additionalProperties": false,
   "properties": {"key": {"$ref": "reconstruction_common.json#/$defs/name"}, "scope": {"$ref": "reconstruction_common.json#/$defs/name"},
    "values": {"type": "array", "minItems": 2, "items": {"type": "object", "required": ["value", "source_kind", "reference"], "additionalProperties": false,
     "properties": {"value": {"type": ["string", "number", "boolean"]}, "source_kind": {"$ref": "reconstruction_common.json#/$defs/name"}, "reference": {"$ref": "reconstruction_common.json#/$defs/name"}}}},
    "required_probe": {"$ref": "reconstruction_common.json#/$defs/name"}, "probe_registered": {"type": "boolean"}}},
  "refused_declaration": {"type": "object", "required": ["product", "key", "reason"], "additionalProperties": false,
   "properties": {"product": {"$ref": "reconstruction_common.json#/$defs/name"}, "key": {"$ref": "reconstruction_common.json#/$defs/name"}, "reason": {"$ref": "reconstruction_common.json#/$defs/name"}}}
 }
}
