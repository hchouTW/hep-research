{
 "$comment": "Result binding (v6.3 M2c, run-lineage/v1): written after execution, never inside the analysis bundle and never naming its own digest. It binds the analysis bundle and semantic lock used, the computational-runs (explicit input sources) and campaigns, and per root the result file, its producer, identity and status labels. Agent-written: the attribution it states is a declaration (C12). It carries digests and labels, never result values.",
 "type": "object",
 "required": [
  "binding_version",
  "kind",
  "analysis_bundle_sha256",
  "semantic_lock_sha256",
  "asserted_by",
  "runs",
  "campaigns",
  "results"
 ],
 "additionalProperties": false,
 "properties": {
  "binding_version": {
   "const": "1.0.0"
  },
  "kind": {
   "const": "result-binding"
  },
  "analysis_bundle_sha256": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$"
  },
  "semantic_lock_sha256": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$"
  },
  "asserted_by": {
   "type": "object",
   "required": [
    "kind",
    "id"
   ],
   "additionalProperties": false,
   "properties": {
    "kind": {
     "enum": [
      "person",
      "agent",
      "tool"
     ]
    },
    "id": {
     "type": "string",
     "minLength": 1
    }
   }
  },
  "runs": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "run_id",
     "ref",
     "sha256",
     "base",
     "inputs"
    ],
    "additionalProperties": false,
    "properties": {
     "run_id": {
      "type": "string",
      "minLength": 1
     },
     "ref": {
      "type": "string",
      "minLength": 1
     },
     "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
     },
     "base": {
      "$comment": "project-relative folder the run's manifest paths resolve against",
      "type": "string"
     },
     "inputs": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "path",
        "source"
       ],
       "additionalProperties": false,
       "properties": {
        "path": {
         "type": "string",
         "minLength": 1
        },
        "source": {
         "type": "object",
         "additionalProperties": false,
         "properties": {
          "item": {
           "type": "string",
           "minLength": 1
          },
          "external": {
           "type": "object",
           "required": [
            "item",
            "entry"
           ],
           "additionalProperties": false,
           "properties": {
            "item": {
             "type": "string"
            },
            "entry": {
             "type": "string"
            }
           }
          },
          "product": {
           "type": "object",
           "required": [
            "run",
            "output"
           ],
           "additionalProperties": false,
           "properties": {
            "run": {
             "type": "string"
            },
            "output": {
             "type": "string"
            }
           }
          }
         }
        }
       }
      }
     }
    }
   }
  },
  "campaigns": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "campaign_uid",
     "dir",
     "run_ref",
     "run_sha256",
     "execution_bundle_sha256"
    ],
    "additionalProperties": false,
    "properties": {
     "campaign_uid": {
      "type": "string",
      "minLength": 1
     },
     "dir": {
      "type": "string",
      "minLength": 1
     },
     "run_ref": {
      "type": "string",
      "minLength": 1
     },
     "run_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
     },
     "execution_bundle_sha256": {
      "anyOf": [
       {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
       },
       {
        "type": "null"
       }
      ]
     }
    }
   }
  },
  "results": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "root",
     "file",
     "sha256",
     "producer",
     "unit",
     "scope",
     "binning",
     "status"
    ],
    "additionalProperties": false,
    "properties": {
     "root": {
      "type": "string",
      "minLength": 1
     },
     "file": {
      "type": "string",
      "minLength": 1
     },
     "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
     },
     "producer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
       "run": {
        "type": "string",
        "minLength": 1
       },
       "campaign": {
        "type": "string",
        "minLength": 1
       }
      }
     },
     "unit": {
      "type": "string"
     },
     "scope": {
      "type": "string"
     },
     "binning": {
      "type": "object",
      "required": [
       "item",
       "pointer"
      ],
      "additionalProperties": false,
      "properties": {
       "item": {
        "type": "string"
       },
       "pointer": {
        "type": "string"
       }
      }
     },
     "status": {
      "type": "array",
      "items": {
       "type": "string"
      }
     }
    }
   }
  }
 }
}
