{
 "$comment": "reconstruction-product/1 (contract-map.md; plan Sections 8.2, 8.3, 10.1): the semantic description of one native product. Objects are located by product identity, collection, key and revision; a row index is valid only inside its own product. Read by contracts/reconstruction.py, not an artifact type.",
 "type": "object",
 "required": ["schema", "product_id", "revision", "collection", "native", "presence", "role", "conditions_used", "required_extensions"],
 "additionalProperties": false,
 "properties": {
  "schema": {"const": "reconstruction-product/1"},
  "product_id": {"$ref": "reconstruction_common.json#/$defs/name"},
  "revision": {"type": "integer", "minimum": 1},
  "collection": {"$ref": "reconstruction_common.json#/$defs/name"},
  "native": {"$ref": "reconstruction_common.json#/$defs/native"},
  "presence": {"$ref": "reconstruction_common.json#/$defs/presence"},
  "role": {"$ref": "reconstruction_common.json#/$defs/role"},
  "objects": {"type": "array", "items": {"$ref": "#/$defs/object"}},
  "sampling": {"$ref": "#/$defs/sampling"},
  "retention": {"$ref": "#/$defs/retention"},
  "estimate": {"$ref": "#/$defs/estimate"},
  "frames": {"$ref": "#/$defs/frames"},
  "candidates": {"$ref": "#/$defs/candidates"},
  "inversion": {"$ref": "#/$defs/inversion"},
  "counts": {"$ref": "#/$defs/counts"},
  "scan": {"$ref": "#/$defs/scan"},
  "constraint_resolution": {"$ref": "#/$defs/constraint_resolution"},
  "association": {"$ref": "#/$defs/association"},
  "conditions_used": {"$comment": "R32: every payload consumed, in chain order (R34), with its round (R36); an empty list states that none was", "type": "array", "items": {"$ref": "reconstruction_common.json#/$defs/used_payload"}},
  "required_extensions": {"$ref": "reconstruction_common.json#/$defs/extension_ids"},
  "optional_extensions": {"$ref": "reconstruction_common.json#/$defs/extension_ids"},
  "extensions": {"$ref": "reconstruction_common.json#/$defs/extension_fields"}
 },
 "$defs": {
  "reference": {"$comment": "product identity plus collection, key and revision; 'row' is allowed by the schema and judged in code: only inside its own product",
   "type": "object", "required": ["product_id", "collection", "revision"], "additionalProperties": false,
   "properties": {"product_id": {"$ref": "reconstruction_common.json#/$defs/name"}, "collection": {"$ref": "reconstruction_common.json#/$defs/name"},
                  "revision": {"type": "integer", "minimum": 1}, "key": {"type": ["integer", "string"]}, "row": {"type": "integer", "minimum": 0}}},
  "object": {"type": "object", "required": ["key", "native_ref"], "additionalProperties": false,
   "properties": {"key": {"type": ["integer", "string"]}, "native_ref": {"$ref": "reconstruction_common.json#/$defs/name"},
                  "surface": {"$ref": "reconstruction_common.json#/$defs/name"}, "state_type": {"$ref": "reconstruction_common.json#/$defs/name"},
                  "source_links": {"type": "array", "items": {"$ref": "#/$defs/reference"}}}},
  "sampling": {"$comment": "Section 8.3: only what the method needs; missing_samples stay marked",
   "type": "object", "required": ["interval", "time_origin", "time_system", "channels", "window", "missing_samples"], "additionalProperties": false,
   "properties": {"interval": {"$ref": "reconstruction_common.json#/$defs/measure"}, "time_origin": {"$ref": "reconstruction_common.json#/$defs/name"},
                  "time_system": {"$ref": "reconstruction_common.json#/$defs/name"}, "channels": {"$ref": "reconstruction_common.json#/$defs/names"},
                  "window": {"$ref": "reconstruction_common.json#/$defs/numbers"}, "missing_samples": {"$ref": "reconstruction_common.json#/$defs/numbers"},
                  "transforms": {"$ref": "reconstruction_common.json#/$defs/names"}, "saturation": {"$ref": "reconstruction_common.json#/$defs/name"}}},
  "retention_state": {"enum": ["kept", "removed", "reproducible", "not-applicable"]},
  "retention": {"$comment": "Sections 8.3 and R34: what was removed decides what can be recomputed; lost_recalibrations names what reduced retention can no longer support",
   "type": "object", "required": ["raw", "waveform", "truth", "candidates", "conditions_snapshot"], "additionalProperties": false,
   "properties": {"raw": {"$ref": "#/$defs/retention_state"}, "waveform": {"$ref": "#/$defs/retention_state"}, "truth": {"$ref": "#/$defs/retention_state"},
                  "candidates": {"$ref": "#/$defs/retention_state"}, "conditions_snapshot": {"$ref": "#/$defs/retention_state"},
                  "lost_recalibrations": {"$ref": "reconstruction_common.json#/$defs/names"}}},
  "component": {"$comment": "a linear combination of the parameters that the data do determine (K05)",
   "type": "object", "required": ["weights", "value"], "additionalProperties": false,
   "properties": {"weights": {"$ref": "reconstruction_common.json#/$defs/numbers"}, "value": {"type": "number"}, "variance": {"type": "number", "minimum": 0}}},
  "key_range": {"$comment": "[start, end), half open", "type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer"}},
  "frames": {"$comment": "W3: cores own outputs, halos are reread and own nothing, an original gap stays marked and each key names its own payload (R32). core/partition expresses the cores; it has no halo.",
   "type": "object", "required": ["domain", "key_coordinate", "partitions", "missing_keys", "outputs", "accounts"], "additionalProperties": false,
   "properties": {
    "domain": {"$ref": "#/$defs/key_range"},
    "key_coordinate": {"$comment": "the IOV coordinate the keys lie on", "$ref": "reconstruction_common.json#/$defs/name"},
    "fixed_coordinates": {"$comment": "Section 9.3: other coordinates of the observation, such as a run, when a payload's validity has several predicates", "type": "object", "additionalProperties": {"type": "number"}},
    "partitions": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["partition_id", "core", "halo", "halo_keys"], "additionalProperties": false,
     "properties": {"partition_id": {"$ref": "reconstruction_common.json#/$defs/name"}, "core": {"$ref": "#/$defs/key_range"}, "halo": {"type": "integer", "minimum": 0},
                    "halo_keys": {"type": "array", "items": {"type": "integer"}}}}},
    "missing_keys": {"type": "array", "items": {"type": "integer"}},
    "outputs": {"type": "array", "items": {"type": "object", "required": ["key", "owner", "payload_id", "window"], "additionalProperties": false,
     "properties": {"key": {"type": "integer"}, "owner": {"$ref": "reconstruction_common.json#/$defs/name"}, "payload_id": {"$ref": "reconstruction_common.json#/$defs/sha256"},
                    "window": {"enum": ["complete", "edge-incomplete", "gap-adjacent"]}}}},
    "accounts": {"type": "object", "required": ["observed", "owned", "missing", "edge_incomplete", "gap_adjacent"], "additionalProperties": false,
     "properties": {"observed": {"type": "integer", "minimum": 0}, "owned": {"type": "integer", "minimum": 0}, "missing": {"type": "integer", "minimum": 0},
                    "edge_incomplete": {"type": "array", "items": {"type": "integer"}}, "gap_adjacent": {"type": "array", "items": {"type": "integer"}}}}}},
  "hypothesis": {"type": "object", "required": ["hypothesis_id", "revision", "state", "exclusive_group", "measurements"], "additionalProperties": false,
   "properties": {"hypothesis_id": {"$ref": "reconstruction_common.json#/$defs/name"}, "revision": {"type": "integer", "minimum": 1},
                  "state": {"enum": ["open", "committed", "superseded", "discarded"]}, "exclusive_group": {"$ref": "reconstruction_common.json#/$defs/name"},
                  "measurements": {"type": "array", "items": {"$ref": "#/$defs/reference"}},
                  "hypothesis_kind": {"enum": ["track", "shower", "vertex", "ordering", "other"]}, "ordering": {"$ref": "reconstruction_common.json#/$defs/names"},
                  "escape": {"enum": ["contained", "escaped"]},
                  "quality": {"type": "object", "required": ["metric", "value"], "additionalProperties": false,
                   "properties": {"metric": {"$ref": "reconstruction_common.json#/$defs/name"}, "value": {"type": "number"}}}}},
  "candidates": {"$comment": "W4, Section 10.1: memory ownership (memory_owner, a native reference), use of observations (measurements, which hypotheses may share) and counting of results (selection_policy, consumers) are three separate things.",
   "type": "object", "required": ["hypotheses", "selection_policy", "consumers", "memory_owner", "pruning"], "additionalProperties": false,
   "properties": {
    "hypotheses": {"type": "array", "items": {"$ref": "#/$defs/hypothesis"}},
    "selection_policy": {"type": "object", "required": ["kind", "selected"], "additionalProperties": false,
     "properties": {"kind": {"$ref": "reconstruction_common.json#/$defs/name"}, "selected": {"$comment": "exclusive group to hypothesis_id", "type": "object", "additionalProperties": {"$ref": "reconstruction_common.json#/$defs/name"}}}},
    "consumers": {"type": "array", "items": {"type": "object", "required": ["consumer", "hypothesis_id", "revision", "use"], "additionalProperties": false,
     "properties": {"consumer": {"$ref": "reconstruction_common.json#/$defs/name"}, "hypothesis_id": {"$ref": "reconstruction_common.json#/$defs/name"},
                    "revision": {"type": "integer", "minimum": 1}, "use": {"enum": ["count", "read"]}}}},
    "memory_owner": {"$ref": "reconstruction_common.json#/$defs/native"},
    "pruning": {"type": "array", "items": {"type": "object", "required": ["rule", "stage", "removed"], "additionalProperties": false,
     "properties": {"rule": {"$ref": "reconstruction_common.json#/$defs/name"}, "stage": {"enum": ["before-selection", "after-selection"]},
                    "removed": {"$ref": "reconstruction_common.json#/$defs/name"}}}}}},
  "inversion": {"$comment": "W5: a linear operator declared by quantity, unit and normalization, with every solution and null direction kept. The operator itself stays a native reference; ext_response.json is for probability responses.",
   "type": "object", "required": ["operator", "observed", "solutions", "null_directions", "uniqueness_claim", "prior", "selected_solution", "undetermined_components",
                                  "native_image", "response_ref", "background_ref", "handoff", "comparator"], "additionalProperties": false,
   "properties": {
    "operator": {"type": "object", "required": ["matrix", "interpretation", "input_quantity", "output_quantity", "normalization", "native"], "additionalProperties": false,
     "properties": {"matrix": {"$ref": "reconstruction_common.json#/$defs/matrix"}, "interpretation": {"enum": ["linear-quantity", "probability"]},
                    "input_quantity": {"$ref": "reconstruction_common.json#/$defs/quantity"}, "output_quantity": {"$ref": "reconstruction_common.json#/$defs/quantity"},
                    "normalization": {"type": "object", "required": ["kind", "basis"], "additionalProperties": false,
                     "properties": {"kind": {"enum": ["none", "column", "row"]}, "basis": {"enum": ["declared", "default"]}}},
                    "native": {"$ref": "reconstruction_common.json#/$defs/native"}}},
    "observed": {"$ref": "reconstruction_common.json#/$defs/numbers"},
    "solutions": {"type": "array", "minItems": 1, "items": {"$ref": "reconstruction_common.json#/$defs/numbers"}},
    "null_directions": {"type": "array", "items": {"$ref": "reconstruction_common.json#/$defs/numbers"}},
    "uniqueness_claim": {"type": "boolean"},
    "prior": {"$comment": "stated when it selects a solution", "anyOf": [{"type": "null"}, {"$ref": "reconstruction_common.json#/$defs/name"}]},
    "selected_solution": {"anyOf": [{"type": "null"}, {"type": "integer", "minimum": 0}]},
    "undetermined_components": {"type": "array", "items": {"$ref": "reconstruction_common.json#/$defs/numbers"}},
    "native_image": {"$ref": "reconstruction_common.json#/$defs/native"},
    "response_ref": {"$ref": "reconstruction_common.json#/$defs/name"},
    "background_ref": {"$ref": "reconstruction_common.json#/$defs/name"},
    "handoff": {"$comment": "the skill that owns the inversion's inference", "$ref": "reconstruction_common.json#/$defs/name"},
    "comparator": {"$ref": "#/$defs/comparator"}}},
  "window": {"type": "object", "required": ["start", "end", "unit"], "additionalProperties": false,
   "properties": {"start": {"type": "number"}, "end": {"type": "number"}, "unit": {"$ref": "reconstruction_common.json#/$defs/name"}}},
  "counts": {"$comment": "W6: a zero count is an observation, an absent interval is not, each channel's rate uses its own valid exposure and response, and the count model is declared with its premises. Live exposure is held here: contracts/schemas/exposure_record.json records who saw which data.",
   "type": "object", "required": ["capability", "observables", "per_event_energy", "count_model", "run_time", "selections", "channels", "intervals", "rates"], "additionalProperties": false,
   "properties": {
    "capability": {"enum": ["counting", "energy-resolving"]},
    "observables": {"type": "array", "minItems": 1, "items": {"$ref": "reconstruction_common.json#/$defs/quantity_kind"}},
    "per_event_energy": {"type": "boolean"},
    "count_model": {"type": "object", "required": ["kind", "premises", "inferred_from"], "additionalProperties": false,
     "properties": {"kind": {"$ref": "reconstruction_common.json#/$defs/name"}, "premises": {"$ref": "reconstruction_common.json#/$defs/names"},
                    "inferred_from": {"$comment": "integer-type is refused: an integer type establishes no count model", "enum": [null, "integer-type"]}}},
    "run_time": {"$ref": "reconstruction_common.json#/$defs/measure"},
    "selections": {"$comment": "W6: what passed into a count, kept apart from presence and exposure; kind none states that nothing was selected", "type": "array", "minItems": 1,
     "items": {"type": "object", "required": ["selection_id", "kind", "threshold"], "additionalProperties": false,
      "properties": {"selection_id": {"$ref": "reconstruction_common.json#/$defs/name"}, "kind": {"enum": ["none", "threshold", "window", "native-rule"]},
                     "threshold": {"anyOf": [{"type": "null"}, {"$ref": "reconstruction_common.json#/$defs/measure"}]},
                     "window": {"$ref": "#/$defs/window"}, "reference": {"$ref": "reconstruction_common.json#/$defs/name"}}}},
    "channels": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["channel", "valid_exposure", "response_ref", "selection_ref"], "additionalProperties": false,
     "properties": {"channel": {"$ref": "reconstruction_common.json#/$defs/name"}, "valid_exposure": {"$ref": "reconstruction_common.json#/$defs/measure"},
                    "response_ref": {"$ref": "reconstruction_common.json#/$defs/name"}, "selection_ref": {"$ref": "reconstruction_common.json#/$defs/name"}}}},
    "intervals": {"type": "array", "items": {"type": "object", "required": ["interval_id", "channel", "presence"], "additionalProperties": false,
     "properties": {"interval_id": {"$ref": "reconstruction_common.json#/$defs/name"}, "channel": {"$ref": "reconstruction_common.json#/$defs/name"},
                    "presence": {"$ref": "reconstruction_common.json#/$defs/presence"}, "count": {"type": "integer", "minimum": 0}}}},
    "rates": {"type": "array", "items": {"type": "object", "required": ["channel", "denominator", "response_ref", "selection_ref"], "additionalProperties": false,
     "properties": {"channel": {"$ref": "reconstruction_common.json#/$defs/name"}, "response_ref": {"$ref": "reconstruction_common.json#/$defs/name"},
                    "selection_ref": {"$ref": "reconstruction_common.json#/$defs/name"},
                    "denominator": {"type": "object", "required": ["source", "value", "unit"], "additionalProperties": false,
                     "properties": {"source": {"enum": ["valid-exposure", "run-time"]}, "value": {"type": "number"}, "unit": {"$ref": "reconstruction_common.json#/$defs/name"}}}}}},
    "coincidence": {"$comment": "A23, contract part", "type": "object", "required": ["prompt_window", "delayed_window", "accidentals", "capture_escape", "denominators"], "additionalProperties": false,
     "properties": {"prompt_window": {"$ref": "#/$defs/window"}, "delayed_window": {"$ref": "#/$defs/window"},
                    "accidentals": {"type": "object", "required": ["method", "reference"], "additionalProperties": false,
                     "properties": {"method": {"$ref": "reconstruction_common.json#/$defs/name"}, "reference": {"$ref": "reconstruction_common.json#/$defs/name"}}},
                    "capture_escape": {"type": "object", "required": ["capture_reference", "escape_reference"], "additionalProperties": false,
                     "properties": {"capture_reference": {"$ref": "reconstruction_common.json#/$defs/name"}, "escape_reference": {"$ref": "reconstruction_common.json#/$defs/name"}}},
                    "denominators": {"type": "array", "minItems": 1, "items": {"$ref": "reconstruction_common.json#/$defs/name"}}}}}},
  "scan": {"$comment": "W7: one of three separate subcases, none a solver. rf-scan: settings, mapped coordinates and marked overlaps. retarding-scan: setting, time, count and transmission of each visit. global: only what the design determines.",
   "type": "object", "required": ["subcase", "source_ref", "coordinates", "conditions_ref", "response_ref", "noise_model", "merging", "unidentifiable"], "additionalProperties": false,
   "properties": {
    "subcase": {"enum": ["rf-scan", "retarding-scan", "global"]},
    "source_ref": {"$ref": "reconstruction_common.json#/$defs/name"},
    "coordinates": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["axis", "kind", "unit"], "additionalProperties": false,
     "properties": {"axis": {"$ref": "reconstruction_common.json#/$defs/name"}, "kind": {"enum": ["frequency", "time", "setting", "index", "spatial"]},
                    "unit": {"$ref": "reconstruction_common.json#/$defs/name"}}}},
    "conditions_ref": {"$ref": "reconstruction_common.json#/$defs/name"},
    "response_ref": {"$ref": "reconstruction_common.json#/$defs/name"},
    "noise_model": {"type": "object", "required": ["kind", "premises"], "additionalProperties": false,
     "properties": {"kind": {"$ref": "reconstruction_common.json#/$defs/name"}, "premises": {"$ref": "reconstruction_common.json#/$defs/names"}}},
    "merging": {"type": "object", "required": ["kind"], "additionalProperties": false,
     "properties": {"kind": {"enum": ["keep-settings", "keep-visits", "joint-model", "chunk-average"]}}},
    "unidentifiable": {"$ref": "reconstruction_common.json#/$defs/names"},
    "settings": {"type": "array", "items": {"type": "object", "required": ["setting_id", "local_oscillator", "sideband_sign", "interval_unit", "intermediate_interval", "physical_interval", "raw_segments"], "additionalProperties": false,
     "properties": {"setting_id": {"$ref": "reconstruction_common.json#/$defs/name"}, "local_oscillator": {"$ref": "reconstruction_common.json#/$defs/measure"},
                    "sideband_sign": {"$comment": "physical = oscillator + sign x intermediate, declared by the record", "enum": [1, -1]}, "interval_unit": {"$ref": "reconstruction_common.json#/$defs/name"},
                    "intermediate_interval": {"$ref": "reconstruction_common.json#/$defs/numbers"}, "physical_interval": {"$ref": "reconstruction_common.json#/$defs/numbers"},
                    "raw_segments": {"$ref": "reconstruction_common.json#/$defs/names"}}}},
    "overlaps": {"type": "array", "items": {"type": "object", "required": ["settings", "raw_segments", "shared_noise", "independent_exposure"], "additionalProperties": false,
     "properties": {"settings": {"$ref": "reconstruction_common.json#/$defs/names"}, "raw_segments": {"$ref": "reconstruction_common.json#/$defs/names"},
                    "shared_noise": {"type": "boolean"}, "independent_exposure": {"type": "boolean"},
                    "noise_premise": {"$comment": "a shared segment is shared noise unless this says otherwise", "$ref": "reconstruction_common.json#/$defs/name"}}}},
    "visits": {"type": "array", "items": {"type": "object", "required": ["setting", "dwell", "count", "transmission_ref", "conditions_ref"], "additionalProperties": false,
     "properties": {"setting": {"$ref": "reconstruction_common.json#/$defs/name"}, "dwell": {"$ref": "reconstruction_common.json#/$defs/measure"},
                    "count": {"type": "integer", "minimum": 0}, "transmission_ref": {"$ref": "reconstruction_common.json#/$defs/name"},
                    "conditions_ref": {"$ref": "reconstruction_common.json#/$defs/name"}}}},
    "model": {"type": "object", "required": ["parameters", "design", "observation"], "additionalProperties": false,
     "properties": {"parameters": {"$ref": "reconstruction_common.json#/$defs/names"}, "design": {"$ref": "reconstruction_common.json#/$defs/matrix"},
                    "observation": {"$ref": "reconstruction_common.json#/$defs/numbers"}}},
    "reported": {"type": "array", "items": {"$ref": "#/$defs/component"}},
    "constraint": {"$comment": "an added constraint or prior, stated; value only for an exact constraint, since a prior has no single value", "anyOf": [{"type": "null"}, {"type": "object", "required": ["statement", "weights"], "additionalProperties": false,
     "properties": {"statement": {"$ref": "reconstruction_common.json#/$defs/name"}, "weights": {"$ref": "reconstruction_common.json#/$defs/numbers"}, "value": {"type": "number"}}}]},
    "regularization": {"enum": ["none", "jitter"]},
    "uniqueness_claim": {"type": "boolean"}}},
  "constraint_option": {"type": "object", "required": ["name", "state", "sufficient"], "additionalProperties": false,
   "properties": {"name": {"$ref": "reconstruction_common.json#/$defs/name"}, "state": {"enum": ["qualified", "unqualified", "not-available"]}, "sufficient": {"type": "boolean"}}},
  "constraint_resolution": {"$comment": "A03, A25, G02: a missing external constraint is followed by a check of qualified internal or joint constraints; delivery is restricted only if the information stays insufficient",
   "type": "object", "required": ["target", "external", "internal", "joint", "outcome", "restriction"], "additionalProperties": false,
   "properties": {"target": {"$ref": "reconstruction_common.json#/$defs/name"},
    "external": {"type": "object", "required": ["name", "state"], "additionalProperties": false,
     "properties": {"name": {"$ref": "reconstruction_common.json#/$defs/name"}, "state": {"enum": ["available", "missing"]}}},
    "internal": {"type": "array", "items": {"$ref": "#/$defs/constraint_option"}}, "joint": {"type": "array", "items": {"$ref": "#/$defs/constraint_option"}},
    "outcome": {"enum": ["full", "restricted"]},
    "restriction": {"anyOf": [{"type": "null"}, {"type": "object", "required": ["omits", "reason"], "additionalProperties": false,
     "properties": {"omits": {"type": "array", "minItems": 1, "items": {"$ref": "reconstruction_common.json#/$defs/name"}}, "reason": {"$ref": "reconstruction_common.json#/$defs/name"}}}]}}},
  "association": {"$comment": "A22, contract part: members of different sensor kinds associate through their respective responses; each states its time base and window, which may be shared",
   "type": "object", "required": ["rule", "members"], "additionalProperties": false,
   "properties": {"rule": {"$ref": "reconstruction_common.json#/$defs/name"},
    "members": {"type": "array", "minItems": 2, "items": {"type": "object", "required": ["product_id", "sensor_kind", "response_ref", "time_base", "time_window"], "additionalProperties": false,
     "properties": {"product_id": {"$ref": "reconstruction_common.json#/$defs/name"}, "sensor_kind": {"$ref": "reconstruction_common.json#/$defs/name"},
                    "response_ref": {"$ref": "reconstruction_common.json#/$defs/name"}, "time_base": {"$ref": "reconstruction_common.json#/$defs/name"},
                    "time_window": {"$ref": "#/$defs/window"}}}}}},
  "estimate": {"$comment": "W2: a linear estimate with its model, covariance scope and identifiability. Covariance scope fixed-model holds under the stated model and noise only (Section 8.5).",
   "type": "object", "required": ["parameters", "model", "observation", "solution", "covariance", "identifiability", "regularization", "status", "optimal_claim", "comparator"],
   "additionalProperties": false,
   "properties": {
    "parameters": {"$ref": "reconstruction_common.json#/$defs/names"},
    "model": {"type": "object", "required": ["design", "noise_covariance", "shape"], "additionalProperties": false,
     "properties": {"design": {"$ref": "reconstruction_common.json#/$defs/matrix"}, "noise_covariance": {"$ref": "reconstruction_common.json#/$defs/matrix"},
                    "shape": {"enum": ["fixed-template", "amplitude-dependent"]}}},
    "observation": {"$ref": "reconstruction_common.json#/$defs/numbers"},
    "solution": {"anyOf": [{"type": "null"}, {"$ref": "reconstruction_common.json#/$defs/numbers"}]},
    "covariance": {"type": "object", "required": ["matrix", "scope", "includes"], "additionalProperties": false,
     "properties": {"matrix": {"anyOf": [{"type": "null"}, {"$ref": "reconstruction_common.json#/$defs/matrix"}]},
                    "scope": {"enum": ["fixed-model", "with-named-sources"]}, "includes": {"$ref": "reconstruction_common.json#/$defs/names"}}},
    "identifiability": {"type": "object", "required": ["rank", "status", "unidentifiable"], "additionalProperties": false,
     "properties": {"rank": {"type": "integer", "minimum": 0}, "status": {"enum": ["full", "rank-deficient"]},
                    "unidentifiable": {"$ref": "reconstruction_common.json#/$defs/names"},
                    "components": {"type": "array", "items": {"$ref": "#/$defs/component"}}}},
    "regularization": {"enum": ["none", "jitter"]},
    "status": {"enum": ["fit", "rank-deficient", "out-of-domain"]},
    "optimal_claim": {"type": "boolean"},
    "comparator": {"$ref": "#/$defs/comparator"}}},
