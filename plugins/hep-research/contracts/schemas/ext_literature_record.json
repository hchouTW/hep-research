{"$comment": "Owner: hep-citations. Literature-record extension (contracts 2.13.0): the offline literature record that skills/hep-citations/scripts/manage_literature.py writes, unchanged in content (record_version 1.0.0), now inside the common envelope so a handoff to hep-authoring validates. Sources and claims keep the evidence-ledger formats of evidence_source.json and evidence_claim.json plus the import's own keys (identifiers, read_events, versions, notices, status, imported_from, aliases); contracts.validate checks them with core.evidence.ledger (_literature_semantics). Online verification is recorded, never performed.",
 "type": "object",
 "required": ["record_version", "created", "imported", "sources", "claims", "searches", "notices", "relations", "proposed_merges", "flags", "verification"],
 "properties": {
  "record_version": {"type": "string", "enum": ["1.0.0"]},
  "created": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
  "imported": {"type": "array", "items": {"type": "object", "required": ["path", "sha256", "date"],
    "properties": {"path": {"type": ["string", "null"]}, "sha256": {"type": ["string", "null"]}, "date": {"type": "string"}, "counts": {"type": "object"}}}},
  "sources": {"type": "object", "additionalProperties": {"type": "object", "required": ["id", "title", "verification_level", "read_events"],
    "properties": {"id": {"type": "string"}, "title": {"type": "string"}, "verification_level": {"type": "string", "x-vocab": "verification_levels"},
                   "identifiers": {"type": "object"}, "citation_key": {"type": "string"},
                   "read_events": {"type": "array", "items": {"type": "object", "required": ["level", "date"],
                     "properties": {"level": {"type": ["string", "null"]}, "date": {"type": ["string", "null"]}, "locators": {"type": "array"}, "imported_from": {"type": ["string", "null"]}}}},
                   "versions": {"type": "array"}, "notices": {"type": "array"}, "aliases": {"type": "array", "items": {"type": "string"}}}}},
  "claims": {"type": "object", "additionalProperties": {"type": "object", "required": ["id", "source_ids"],
    "properties": {"id": {"type": "string"}, "source_ids": {"type": "array", "items": {"type": "string"}}}}},
  "searches": {"type": "array", "items": {"type": "object"}},
  "notices": {"type": "array", "items": {"type": "object"}},
  "relations": {"type": "array", "items": {"type": "object", "required": ["kind", "from", "to"]}},
  "proposed_merges": {"type": "array", "items": {"type": "object", "required": ["ids"]}},
  "flags": {"type": "array", "items": {"type": "object"}},
  "verification": {"type": "object", "required": ["online"], "properties": {"online": {"type": "string", "enum": ["not-performed", "performed"]}, "note": {"type": "string"}}}
 }}
