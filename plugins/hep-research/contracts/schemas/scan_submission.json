{
 "$comment": "Scan submission (task P6.1): what an agent session sends to the custodian's scan service (a service outside the plugin) to ask whether outputs contain a sealed value. It names the outputs by digest and states how many candidate values they hold (contracts/scan_verdict.py count_candidates), because each answer is a group test over every candidate value (protected-data-architecture.md \u00a76.5): the per-analysis budget is counted in candidate values, not calls.",
 "type": "object",
 "required": [
  "submission_version",
  "submission_id",
  "analysis",
  "release_id",
  "session",
  "outputs",
  "candidate_values",
  "time"
 ],
 "additionalProperties": false,
 "properties": {
  "submission_version": {
   "type": "string",
   "const": "1.0.0"
  },
  "submission_id": {
   "type": "string",
   "minLength": 1
  },
  "analysis": {
   "type": "string",
   "minLength": 1
  },
  "release_id": {
   "type": "string",
   "minLength": 1
  },
  "session": {
   "type": "string",
   "minLength": 1
  },
  "outputs": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "ref",
     "sha256",
     "size"
    ],
    "additionalProperties": false,
    "properties": {
     "ref": {
      "type": "string",
      "minLength": 1
     },
     "sha256": {
      "$ref": "revocation_event.json#/$defs/sha256"
     },
     "size": {
      "type": "integer",
      "minimum": 0
     }
    }
   }
  },
  "candidate_values": {
   "type": "integer",
   "minimum": 0
  },
  "time": {
   "$ref": "revocation_event.json#/$defs/timestamp"
  }
 }
}
