{
 "$comment": "simulation-summary/1 (contracts CV-A1, Geant4 program A1.5; owner contracts, content proposed by hep-detector): per-block accumulators of one logical simulation run (or one job of it), read and merged by core/simulation/summary.py. Optional fields may be added. Geant4 program C2.1 (minor): an observable may keep per-block raw values (blocks[].values, values_max, quantile_method) or say why it does not (values_omitted); merge rule values: concat.",
 "type": "object",
 "required": [
  "summary_version",
  "run",
  "observables",
  "merge"
 ],
 "properties": {
  "summary_version": {
   "const": "simulation-summary/1"
  },
  "run": {
   "type": "object",
   "required": [
    "first_event",
    "block_size",
    "blocks",
    "events_in_blocks",
    "events_ignored",
    "producer"
   ],
   "properties": {
    "run_id": {
     "type": "string"
    },
    "logical_run_seed": {
     "type": "integer",
     "minimum": 1
    },
    "seed_scheme": {
     "enum": [
      "hash-v1",
      "legacy"
     ]
    },
    "evidence_role": {
     "type": "string"
    },
    "seeding": {
     "enum": [
      "stream",
      "per-event"
     ]
    },
    "first_event": {
     "type": "integer",
     "minimum": 0
    },
    "block_size": {
     "type": "integer",
     "minimum": 1
    },
    "blocks": {
     "type": "integer",
     "minimum": 1
    },
    "events_in_blocks": {
     "type": "integer",
     "minimum": 0
    },
    "events_ignored": {
     "type": "integer",
     "minimum": 0
    },
    "spec_sha256": {
     "type": "string"
    },
    "weight_column": {
     "enum": [
      "absent",
      "unit"
     ]
    },
    "producer": {
     "type": "object",
     "required": [
      "name"
     ]
    }
   }
  },
  "observables": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "name",
     "source_column",
     "selection",
     "bins",
     "thresholds",
     "blocks"
    ],
    "properties": {
     "name": {
      "type": "string",
      "minLength": 1
     },
     "blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "object",
       "required": [
        "block",
        "events",
        "n",
        "hist",
        "underflow",
        "overflow",
        "count_if",
        "sum",
        "sumsq",
        "min",
        "max"
       ],
       "properties": {
        "block": {
         "type": "integer",
         "minimum": 0
        },
        "events": {
         "type": "integer",
         "minimum": 0
        },
        "n": {
         "type": "integer",
         "minimum": 0
        },
        "hist": {
         "type": "array",
         "items": {
          "type": "integer",
          "minimum": 0
         }
        },
        "underflow": {
         "type": "integer",
         "minimum": 0
        },
        "overflow": {
         "type": "integer",
         "minimum": 0
        },
        "count_if": {
         "type": "array",
         "items": {
          "type": "integer",
          "minimum": 0
         }
        },
        "sum": {
         "type": "number"
        },
        "sumsq": {
         "type": "number",
         "minimum": 0
        },
        "min": {
         "type": [
          "number",
          "null"
         ]
        },
        "max": {
         "type": [
          "number",
          "null"
         ]
        },
        "values": {
         "type": "array",
         "items": {
          "type": "number"
         }
        }
       }
      }
     },
     "values_max": {
      "type": "integer",
      "minimum": 1
     },
     "values_omitted": {
      "type": "string",
      "minLength": 1
     },
     "quantile_method": {
      "enum": [
       "hyndman-fan-7"
      ]
     }
    }
   }
  },
  "merge": {
   "type": "object",
   "required": [
    "events",
    "n",
    "hist",
    "count_if",
    "sum",
    "sumsq",
    "min",
    "max"
   ]
  }
 }
}
