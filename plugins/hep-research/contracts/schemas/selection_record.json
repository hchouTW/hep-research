{
 "$comment": "selection-record/1 (contract-map.md; plan Sections 5.13, 8.7; K16): a replayable record of how a recipe was or was not chosen. Distinct from decision_record.json, to which it may point for a human decision. contracts/candidate_selection.py writes its formal form on artificial inputs (T15a); without the formal block it is the shape of Section 8.7, readable and honest, and cannot be replayed. Read by contracts/reconstruction.py, not an artifact type.",
 "type": "object",
 "required": ["schema", "record_id", "request", "signature_ref", "policy", "candidates", "decision", "trials", "sample_roles", "dependencies", "required_extensions"],
 "additionalProperties": false,
 "properties": {
  "schema": {"const": "selection-record/1"},
  "record_id": {"$ref": "reconstruction_common.json#/$defs/name"},
  "request": {"type": "object", "required": ["target", "deliverable"], "additionalProperties": false,
   "properties": {"target": {"$ref": "reconstruction_common.json#/$defs/name"}, "deliverable": {"$ref": "reconstruction_common.json#/$defs/name"}}},
  "signature_ref": {"$ref": "reconstruction_common.json#/$defs/name"},
  "policy": {"type": "object", "required": ["version", "granularity", "target", "quality_contract", "objective", "budgets"], "additionalProperties": false,
   "properties": {"version": {"$ref": "#/$defs/optional_name"}, "granularity": {"enum": ["dataset", "run", "conditions-stratum"]}, "target": {"$ref": "#/$defs/optional_name"},
                  "quality_contract": {"$ref": "#/$defs/optional_name"}, "objective": {"$ref": "#/$defs/optional_name"}, "budgets": {"$ref": "#/$defs/optional_name"}}},
  "candidates": {"type": "array", "items": {"type": "object", "required": ["recipe", "hard_predicates", "quality_evidence", "exclusion_or_probe_reason"], "additionalProperties": false,
   "properties": {"recipe": {"$ref": "#/$defs/optional_name"}, "hard_predicates": {"$ref": "reconstruction_common.json#/$defs/name"},
                  "quality_evidence": {"$ref": "#/$defs/optional_name"}, "exclusion_or_probe_reason": {"$ref": "#/$defs/optional_name"}}}},
  "decision": {"type": "object", "required": ["state", "chosen_recipe", "reason", "decision_record_ref"], "additionalProperties": false,
   "properties": {"state": {"$comment": "qualified-default is the predeclared conservative baseline of K16", "enum": ["needs-evidence", "abstained", "selected", "qualified-default"]},
                  "chosen_recipe": {"$ref": "#/$defs/optional_name"}, "reason": {"$ref": "reconstruction_common.json#/$defs/name"},
                  "decision_record_ref": {"$ref": "#/$defs/optional_name"}}},
  "trials": {"$comment": "every probe and trial with its cost, failures included (K17)", "type": "array", "items": {"type": "object", "required": ["trial_id", "cost", "outcome"], "additionalProperties": false,
   "properties": {"trial_id": {"$ref": "reconstruction_common.json#/$defs/name"}, "cost": {"$ref": "reconstruction_common.json#/$defs/name"}, "outcome": {"$ref": "reconstruction_common.json#/$defs/name"}}}},
  "sample_roles": {"$ref": "reconstruction_common.json#/$defs/names"},
  "dependencies": {"$ref": "reconstruction_common.json#/$defs/names"},
  "formal": {"$comment": "Sections 5.13, 8.7: what a formal record adds to the shape of Section 8.7, written by contracts/candidate_selection.py. A record without it can be read and cannot be replayed.", "$ref": "#/$defs/formal"},
  "required_extensions": {"$ref": "reconstruction_common.json#/$defs/extension_ids"},
  "optional_extensions": {"$ref": "reconstruction_common.json#/$defs/extension_ids"},
  "extensions": {"$ref": "reconstruction_common.json#/$defs/extension_fields"}
 },
 "$defs": {
  "optional_name": {"anyOf": [{"type": "null"}, {"$ref": "reconstruction_common.json#/$defs/name"}]},
  "block": {"$comment": "why a candidate stands out; A52 keeps the backend and the evidence apart", "enum": ["necessary-unsatisfied", "necessary-unknown", "necessary-conflicting", "recipe-unavailable", "no-available-backend", "quality-failed", "insufficient-evidence", "cost-unknown", "over-budget"]},
  "formal": {"type": "object", "required": ["hashes", "values_role", "candidate_set", "signature", "inspection", "judgments", "baseline", "sample_groups", "qualification_candidates", "restricted_delivery", "claims", "post_selection_evidence", "learned_ranker"], "additionalProperties": false,
   "properties": {"hashes": {"$comment": "Section 8.7, A60: each input of the selection by digest; contracts/candidate_selection.py says how each is formed", "type": "object",
     "required": ["input_sha256", "reader_sha256", "conditions_sha256", "rule_sha256", "evidence_sha256", "policy_sha256", "candidate_set_sha256"], "additionalProperties": false,
     "properties": {"input_sha256": {"$ref": "reconstruction_common.json#/$defs/sha256"}, "reader_sha256": {"$ref": "reconstruction_common.json#/$defs/sha256"}, "conditions_sha256": {"$ref": "reconstruction_common.json#/$defs/sha256"},
      "rule_sha256": {"$ref": "reconstruction_common.json#/$defs/sha256"}, "evidence_sha256": {"$ref": "reconstruction_common.json#/$defs/sha256"}, "policy_sha256": {"$ref": "reconstruction_common.json#/$defs/sha256"},
      "candidate_set_sha256": {"$ref": "reconstruction_common.json#/$defs/sha256"}}},
    "values_role": {"$comment": "K16: rules only, on artificial values", "const": "artificial-witness"},
    "candidate_set": {"type": "object", "required": ["index_id", "version"], "additionalProperties": false, "properties": {"index_id": {"$ref": "reconstruction_common.json#/$defs/name"}, "version": {"$ref": "reconstruction_common.json#/$defs/name"}}},
    "signature": {"$ref": "#/$defs/signature_summary"},
    "inspection": {"type": "object", "required": ["state", "stop_reason", "products_unread"], "additionalProperties": false,
     "properties": {"state": {"$ref": "reconstruction_common.json#/$defs/name"}, "stop_reason": {"$ref": "#/$defs/optional_name"}, "products_unread": {"$ref": "reconstruction_common.json#/$defs/names"}}},
    "judgments": {"type": "array", "items": {"$ref": "#/$defs/judgment"}},
    "baseline": {"$comment": "Section 5.13 fallback: the predeclared baseline of the policy", "$ref": "#/$defs/optional_name"},
    "sample_groups": {"$comment": "Section 5.13: data roles are sample_roles, these are the groups", "$ref": "reconstruction_common.json#/$defs/names"},
    "qualification_candidates": {"$comment": "SEL06, DS1: listed separately, and never a choice", "$ref": "reconstruction_common.json#/$defs/names"},
    "restricted_delivery": {"$comment": "A52: null exactly when a recipe is chosen", "anyOf": [{"type": "null"}, {"$ref": "#/$defs/restriction"}]},
    "claims": {"type": "object", "required": ["expert_support", "policy_confirmed", "global_best"], "additionalProperties": false,
     "properties": {"expert_support": {"$comment": "DS3: experts that hold their own quality evidence, which is the whole of the claim", "$ref": "reconstruction_common.json#/$defs/names"},
      "policy_confirmed": {"$comment": "DS3, K18: full-chain confirmation is not reachable here", "const": false}, "global_best": {"$comment": "SEL08, Section 5.9", "const": false}}},
    "post_selection_evidence": {"$comment": "Section 8.7, K18: the default is no post-selection quality claim, so only null is written until T16", "type": "null"},
    "learned_ranker": {"$comment": "Section 5.13 asks for model versions; none is used, and K18 says a ranker adds nothing required", "type": "null"}}},
  "signature_summary": {"type": "object", "required": ["facts", "unknown", "conflicts"], "additionalProperties": false,
   "properties": {"facts": {"type": "array", "items": {"type": "object", "required": ["key", "value", "scope", "reference"], "additionalProperties": false,
     "properties": {"key": {"$ref": "reconstruction_common.json#/$defs/name"}, "value": {"type": ["string", "number", "boolean"]}, "scope": {"$ref": "reconstruction_common.json#/$defs/name"}, "reference": {"$ref": "reconstruction_common.json#/$defs/name"}}}},
    "unknown": {"$ref": "reconstruction_common.json#/$defs/names"}, "conflicts": {"$ref": "reconstruction_common.json#/$defs/names"}}},
  "judgment": {"$comment": "SEL05, SEL06: one candidate, with the branch used (Section 5.8) and what stayed open", "type": "object", "required": ["recipe", "standing", "blocks", "branch", "open", "cost", "evidence_stage", "runtime_evidence", "rationale"], "additionalProperties": false,
   "properties": {"recipe": {"$ref": "reconstruction_common.json#/$defs/name"}, "standing": {"enum": ["routine-eligible", "qualification-candidate", "excluded"]}, "blocks": {"type": "array", "items": {"$ref": "#/$defs/block"}},
    "branch": {"$ref": "reconstruction_common.json#/$defs/names"}, "open": {"$ref": "reconstruction_common.json#/$defs/names"}, "cost": {"anyOf": [{"type": "null"}, {"type": "number", "minimum": 0}]}, "evidence_stage": {"$ref": "#/$defs/optional_name"},
    "runtime_evidence": {"$comment": "Section 5.13: the runtime evidence reference", "$ref": "#/$defs/optional_name"}, "rationale": {"$comment": "SEL04: the generation rationale", "$ref": "reconstruction_common.json#/$defs/name"}}},
  "restriction": {"type": "object", "required": ["reasons", "open", "options"], "additionalProperties": false,
   "properties": {"reasons": {"type": "array", "minItems": 1, "items": {"anyOf": [{"$ref": "#/$defs/block"}, {"enum": ["objective-not-fixed", "evidence-not-comparable", "tied-within-tolerance"]}]}},
    "open": {"$ref": "reconstruction_common.json#/$defs/names"}, "options": {"$comment": "Section 5.9 item 4: candidates that stand, delivered without a choice", "$ref": "reconstruction_common.json#/$defs/names"}}}
 }
}
