{
 "$comment": "reconstruction-recipe/1 (contract-map.md; plan Sections 5.2, 8.6): a method bound to a backend, ports, conditions and checks. Distinct from recipe.json, the closed correction chain, which keeps its meaning. A proposal has no backend and no command; nothing here executes. Read by contracts/reconstruction.py, not an artifact type.",
 "type": "object",
 "required": ["schema", "recipe_id", "status", "method", "implementation", "inputs", "outputs", "converters", "independent_inputs", "profile_binding", "reproducibility", "preconditions",
              "dependencies", "execution", "checks", "tool_contract", "evidence_ref", "command", "runtime_evidence", "required_extensions"],
 "additionalProperties": false,
 "properties": {
  "schema": {"const": "reconstruction-recipe/1"},
  "recipe_id": {"$ref": "reconstruction_common.json#/$defs/name"},
  "status": {"$comment": "proposal: not executable. development: a pilot, unqualified. routine: needs passed binding evidence.", "enum": ["proposal", "development", "routine"]},
  "method": {"$comment": "a reference to the one method card, so a profile switch duplicates nothing (A02)", "type": "object", "required": ["card_ref", "card_sha256"], "additionalProperties": false,
   "properties": {"card_ref": {"$ref": "reconstruction_common.json#/$defs/name"}, "card_sha256": {"$ref": "reconstruction_common.json#/$defs/sha256"}}},
  "implementation": {"$comment": "null means not selected; it is never filled with a guess", "type": "object", "required": ["backend", "version", "native_entrypoint"], "additionalProperties": false,
   "properties": {"backend": {"$ref": "#/$defs/optional_name"}, "version": {"$ref": "#/$defs/optional_name"}, "native_entrypoint": {"$ref": "#/$defs/optional_name"}}},
  "inputs": {"type": "array", "items": {"$ref": "reconstruction_port.json"}},
  "outputs": {"type": "array", "items": {"$ref": "reconstruction_port.json"}},
  "converters": {"type": "array", "items": {"$ref": "reconstruction_common.json#/$defs/converter"}},
  "independent_inputs": {"$comment": "pairs of input port ids assumed statistically independent; never two summaries of one source", "type": "array",
   "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "reconstruction_common.json#/$defs/name"}}},
  "profile_binding": {"$comment": "A02: device conditions and the support domain of this binding", "type": "object", "required": ["profile_id", "conditions", "support_domain", "request"], "additionalProperties": false,
   "properties": {"profile_id": {"$ref": "reconstruction_common.json#/$defs/name"},
    "conditions": {"type": "array", "items": {"$ref": "reconstruction_common.json#/$defs/bound_payload"}},
    "support_domain": {"$comment": "axis to its supported range", "type": "object", "additionalProperties": {"type": "object", "required": ["min", "max"], "additionalProperties": false,
     "properties": {"min": {"type": "number"}, "max": {"type": "number"}}}},
    "request": {"$comment": "axis to the requested value", "type": "object", "additionalProperties": {"type": "number"}}}},
  "reproducibility": {"$comment": "plan Section 14.1, G03: byte reruns are identical; numerical and statistical forms name their comparators. Null only for a proposal (Section 8.7)",
   "anyOf": [{"type": "null"}, {"type": "object", "required": ["form", "comparators"], "additionalProperties": false,
    "properties": {"form": {"enum": ["byte", "numerical", "statistical"]}, "comparators": {"$ref": "reconstruction_common.json#/$defs/names"}}}]},
  "preconditions": {"$ref": "reconstruction_common.json#/$defs/names"},
  "dependencies": {"$ref": "reconstruction_common.json#/$defs/names"},
  "execution": {"$comment": "A18: slots above 1 need a reentrant backend", "type": "object", "required": ["concurrency", "slots"], "additionalProperties": false,
   "properties": {"concurrency": {"enum": ["serialized", "reentrant"]}, "slots": {"type": "integer", "minimum": 1}}},
  "checks": {"$ref": "reconstruction_common.json#/$defs/names"},
  "tool_contract": {"$comment": "A41: a versioned mapping to an existing closed tool contract, or null. The tool contract itself stays unchanged.",
   "anyOf": [{"type": "null"}, {"type": "object", "required": ["tool_id", "operation_id", "mapping_version"], "additionalProperties": false,
    "properties": {"tool_id": {"$ref": "reconstruction_common.json#/$defs/name"}, "operation_id": {"$ref": "reconstruction_common.json#/$defs/name"},
                   "mapping_version": {"$ref": "reconstruction_common.json#/$defs/name"}}}]},
  "evidence_ref": {"$ref": "#/$defs/optional_name"},
  "command": {"anyOf": [{"type": "null"}, {"type": "array", "minItems": 1, "items": {"$ref": "reconstruction_common.json#/$defs/name"}}]},
  "runtime_evidence": {"$ref": "#/$defs/optional_name"},
  "required_extensions": {"$ref": "reconstruction_common.json#/$defs/extension_ids"},
  "optional_extensions": {"$ref": "reconstruction_common.json#/$defs/extension_ids"},
  "extensions": {"$ref": "reconstruction_common.json#/$defs/extension_fields"}
 },
 "$defs": {
  "optional_name": {"anyOf": [{"type": "null"}, {"$ref": "reconstruction_common.json#/$defs/name"}]}
 }
}
