{"$comment": "Unit table of one review round, units/round-<n>.json (docs/dev/independent-review-spec.md sections 4.1-4.4 and Appendix B): the delivered document split into units, each with its section, kind, text (a contiguous excerpt of the document), text_sha256, substantive flag and one in_scope boolean per lens; plus the round, the document's source_sha256 and, from round 2 on, the LCS mapping from the previous round (section 4.2).",
 "type": "object",
 "required": ["units_version", "round", "source_sha256", "units", "mapping"],
 "additionalProperties": false,
 "properties": {
  "units_version": {"type": "string", "const": "1.0.0"},
  "round": {"type": "integer", "minimum": 1},
  "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
  "units": {"type": "array", "items": {"$ref": "#/$defs/unit"}},
  "mapping": {"anyOf": [{"type": "null"}, {"type": "object", "required": ["unchanged", "changed", "added", "removed"], "additionalProperties": false,
   "properties": {"unchanged": {"type": "array", "items": {"$ref": "#/$defs/pair"}},
                  "changed": {"type": "array", "items": {"$ref": "#/$defs/pair"}},
                  "added": {"type": "array", "items": {"type": "string"}},
                  "removed": {"type": "array", "items": {"type": "string"}}}}]}},
 "$defs": {
  "pair": {"type": "array", "items": {"type": "string"}, "minItems": 2, "description": "[old unit id, new unit id]"},
  "unit": {"type": "object", "required": ["id", "section", "kind", "text", "text_sha256", "substantive", "in_scope"], "additionalProperties": false,
   "properties": {"id": {"type": "string", "pattern": "^U[0-9]{4,}$"},
                  "section": {"type": "string"},
                  "kind": {"type": "string", "enum": ["heading", "sentence", "table-row", "code"]},
                  "text": {"type": "string", "minLength": 1},
                  "text_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                  "substantive": {"type": "boolean"},
                  "in_scope": {"type": "object", "additionalProperties": {"type": "boolean"}}}}}}
