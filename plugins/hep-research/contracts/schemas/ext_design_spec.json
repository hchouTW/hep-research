{"$comment": "Owner: hep-detector (hep-measurement drafts objectives). contracts 3.11.0, detector system design spec ART-01..ART-15: one versioned, never-modified baseline of physics goals, requirements, allocations, constraints and the comparison basis. A changed requirement is a new file with a higher spec_version (ART-14), bound by a requirement-change decision record (DEC-08). Ids are namespaced by design_id (ART-06). Fields read by the gates or the verdict rules are required (OQ-07); verdicts are derived by contracts/design.py, never written here.",
 "type": "object",
 "required": ["design_id", "spec_version", "objectives", "requirements", "constraints"],
 "additionalProperties": false,
 "properties": {
  "design_id": {"$comment": "the namespace of every id in this design (ART-06), also the 'analysis' of its decision records (DEC-17)",
   "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
  "spec_version": {"type": "integer", "minimum": 1},
  "objectives": {"type": "array", "items": {"$ref": "#/$defs/objective"}},
  "requirements": {"type": "array", "items": {"$ref": "#/$defs/requirement"}},
  "allocations": {"type": "array", "items": {"$ref": "#/$defs/allocation"}},
  "constraints": {"type": "array", "items": {"$ref": "#/$defs/constraint"}},
  "comparison_basis": {"$comment": "ART-15: the normalization basis for comparing candidates, checked by design.py from each candidate's F1 budget evaluation of 'quantity'",
   "type": "object", "required": ["quantity", "tolerance_relative"], "additionalProperties": false, "properties": {
   "quantity": {"$ref": "#/$defs/fom"},
   "tolerance_relative": {"type": "number", "minimum": 0},
   "pareto_axes": {"$comment": "M4, CHN-06: the figures of merit of a Pareto front among the candidates that survive screening; given only when the basis holds",
    "type": "array", "minItems": 2, "items": {"$ref": "#/$defs/fom"}},
   "note": {"type": "string"}}}
 },
 "$defs": {
  "fom": {"$comment": "a figure-of-merit id of contracts/rules/design_adequacy.json", "type": "string",
   "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
  "fidelity": {"type": "string", "enum": ["F0", "F1", "F2", "F3", "F4", "F5"]},
  "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}:(PHY|REQ|CON|ALC)-[A-Z0-9][A-Z0-9-]*$"},
  "denominator": {"$comment": "ART-10, ART-11: the conditions under which the figure of merit holds; its fields follow the denominator the figure of merit's tool contract declares, each value with a tolerance (strings compare exactly)",
   "type": "object", "additionalProperties": {"type": "object", "required": ["value", "tolerance"], "additionalProperties": false,
    "properties": {"value": {"type": ["number", "string"]}, "tolerance": {"type": "number", "minimum": 0}}}},
  "target": {"anyOf": [{"type": "number"}, {"type": "array", "minItems": 2, "items": {"type": "number"}}]},
  "objective": {"type": "object", "required": ["id", "description", "observable", "range"], "additionalProperties": false,
   "properties": {
    "id": {"$ref": "#/$defs/id"},
    "description": {"type": "string", "minLength": 1},
    "observable": {"type": "string", "minLength": 1},
    "range": {"type": "string", "minLength": 1},
    "precision_goal": {"type": "string"}}},
  "requirement": {"type": "object", "required": ["id", "quantity", "comparator", "target", "unit", "denominator", "kind"],
   "additionalProperties": false, "properties": {
    "id": {"$ref": "#/$defs/id"},
    "parents": {"type": "array", "items": {"$ref": "#/$defs/id"}},
    "description": {"type": "string"},
    "quantity": {"$ref": "#/$defs/fom"},
    "comparator": {"type": "string", "enum": ["<=", ">=", "range"]},
    "target": {"$ref": "#/$defs/target"},
    "unit": {"type": "string", "minLength": 1},
    "denominator": {"$ref": "#/$defs/denominator"},
    "kind": {"type": "string", "enum": ["driving", "derived"]},
    "covered_by": {"$comment": "3.12.0, MAT-04 (d): a derived requirement names the driving requirement whose H4 disposition covers it (contracts/design.py refuses a derived requirement without one)",
     "$ref": "#/$defs/id"},
    "allocation": {"$ref": "#/$defs/id"},
    "verification": {"type": "object", "additionalProperties": false, "properties": {
     "method": {"type": "string"},
     "min_fidelity": {"$ref": "#/$defs/fidelity"},
     "required_upstreams": {"type": "array", "items": {"$ref": "#/$defs/fom"}}}},
    "priority": {"type": "string"}}},
  "allocation": {"$comment": "ART-12: a quadrature rule needs independent items or a correlation matrix; linear is conservative",
   "type": "object", "required": ["id", "requirement", "rule", "items", "margin"], "additionalProperties": false, "properties": {
    "id": {"$ref": "#/$defs/id"},
    "requirement": {"$ref": "#/$defs/id"},
    "rule": {"type": "string", "enum": ["quadrature", "linear"]},
    "items": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["name", "value"], "additionalProperties": false,
     "properties": {"name": {"type": "string", "minLength": 1}, "value": {"type": "number", "minimum": 0},
                    "subsystem_role": {"type": "string"}}}},
    "margin": {"type": "number", "minimum": 0},
    "independent": {"type": "boolean"},
    "correlation": {"type": "array", "items": {"type": "array", "items": {"type": "number"}}}}},
  "constraint": {"type": "object", "required": ["id", "type", "hardness", "quantity", "comparator", "target", "unit", "denominator"],
   "additionalProperties": false, "properties": {
    "id": {"$ref": "#/$defs/id"},
    "type": {"type": "string", "enum": ["mass", "power", "envelope", "channel-count", "data-rate", "radiation", "cost"]},
    "hardness": {"type": "string", "enum": ["hard", "soft"]},
    "quantity": {"$ref": "#/$defs/fom"},
    "comparator": {"type": "string", "enum": ["<=", ">=", "range"]},
    "target": {"$ref": "#/$defs/target"},
    "unit": {"type": "string", "minLength": 1},
    "denominator": {"$ref": "#/$defs/denominator"},
    "subsystems": {"$comment": "3.12.0: the subsystems (DES-* ids) the constraint covers; required for a hard constraint by contracts/design.py; a candidate that lacks one cannot pass it (chain.incomplete)",
     "type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^DES-[A-Z0-9-]+$"}},
    "description": {"type": "string"}}}
 }
}
