{"$comment": "Owner: hep-detector. contracts 3.11.0, detector system design spec ART-20..ART-36: one candidate per file, a graph of subsystems keyed by DES-* id with role (core vocabulary subsystem_roles, extensible by namespace), technology, parameters (each with unit, source and status), interfaces and in-situ calibration, and its engineering budgets. A variant names its base in derived_from and records only overrides. Screened-out and at-risk are derived by contracts/design.py and never written here (ART-26).",
 "type": "object",
 "required": ["candidate_id", "design_id"],
 "additionalProperties": false,
 "properties": {
  "candidate_id": {"$ref": "#/$defs/candidate_id"},
  "design_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
  "description": {"type": "string"},
  "derived_from": {"$ref": "#/$defs/candidate_id"},
  "overrides": {"$comment": "with derived_from: only the differences from the base, {DES-id: {parameters: {name: parameter}, ...}}",
   "type": "object", "additionalProperties": {"type": "object", "additionalProperties": false, "properties": {
    "role": {"type": "string", "x-vocab": "subsystem_roles"},
    "technology": {"type": "string"},
    "parameters": {"type": "object", "additionalProperties": {"$ref": "#/$defs/parameter"}},
    "interfaces": {"type": "array", "items": {"type": "string"}},
    "calibration": {"$ref": "#/$defs/calibration"}}}},
  "subsystems": {"type": "object", "additionalProperties": {"$ref": "#/$defs/subsystem"}},
  "budgets": {"$comment": "ART-23..ART-25: per budget quantity, one row per subsystem id; a missing row or estimate makes the constraint inconclusive (budget.incomplete)",
   "type": "object", "additionalProperties": false, "properties": {
    "mass": {"$ref": "#/$defs/budget_rows"}, "power": {"$ref": "#/$defs/budget_rows"},
    "channel_count": {"$ref": "#/$defs/budget_rows"}, "data_rate": {"$ref": "#/$defs/budget_rows"}}},
  "geometry_ref": {"$comment": "ART-30: the Geant4 geometry and study spec generated by evaluate_design.py geometry (needed by F4 evaluations)",
   "type": "string", "minLength": 1}
 },
 "$defs": {
  "candidate_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}:[A-Za-z0-9][A-Za-z0-9._-]*$"},
  "parameter": {"type": "object", "required": ["value", "unit", "source", "status"], "additionalProperties": false, "properties": {
   "value": {"type": ["number", "string", "array", "boolean"]},
   "unit": {"type": "string", "minLength": 1},
   "source": {"type": "string", "minLength": 1},
   "status": {"type": "string", "x-vocab": "evidence_statuses"}}},
  "calibration": {"type": "object", "required": ["method", "control_samples"], "additionalProperties": false, "properties": {
   "method": {"type": "string", "minLength": 1},
   "control_samples": {"type": "array", "items": {"type": "string", "minLength": 1}}}},
  "subsystem": {"type": "object", "required": ["role", "technology", "parameters", "calibration"], "additionalProperties": false,
   "properties": {
    "role": {"type": "string", "x-vocab": "subsystem_roles"},
    "technology": {"type": "string", "minLength": 1},
    "parameters": {"type": "object", "additionalProperties": {"$ref": "#/$defs/parameter"}},
    "interfaces": {"type": "array", "items": {"type": "string"}},
    "calibration": {"$ref": "#/$defs/calibration"}}},
  "budget_rows": {"type": "object", "additionalProperties": {"$ref": "#/$defs/budget_item"}},
  "budget_item": {"type": "object", "required": ["unit", "basis"], "additionalProperties": false, "properties": {
   "allocation": {"type": "number", "minimum": 0},
   "estimate": {"type": "number", "minimum": 0},
   "uncertainty": {"$comment": "absolute, one standard deviation; not below the adequacy-table minimum for the basis (ART-24)",
    "type": "number", "minimum": 0},
   "unit": {"type": "string", "minLength": 1},
   "basis": {"type": "string", "enum": ["measurement", "catalog", "estimate"]},
   "source": {"$comment": "ART-25: an item without a source counts as 'estimate'", "type": "string", "minLength": 1},
   "fidelity": {"type": "string", "enum": ["F0", "F1", "F2", "F3", "F4", "F5"]}}}
 }
}
