{
 "$comment": "Analysis check report 1.0.0 (v6.3 D05c, contracts/analysis_check.py): a sidecar, never part of the bundle it examines. It identifies the subject (bundle digest), the assessment (subject, suite, rules, registry, checker, readers, settings), the inventory, and per obligation the state, reason, evidence pointers and declaration flag. It carries codes, digests and IDs, never result values, and it authorizes nothing (HC-05).",
 "type": "object",
 "required": [
  "report_version",
  "kind",
  "status",
  "subject_digest",
  "assessment_id",
  "assessment",
  "inventory_digest",
  "suite",
  "checker",
  "input_validity",
  "input_diagnostics",
  "lock_differences",
  "coverage",
  "consistency",
  "counts",
  "formal_use_view",
  "obligations",
  "declarations",
  "context_findings",
  "legacy_findings",
  "execution_evidence_level",
  "validation_status",
  "scope_delta",
  "exceptions",
  "note"
 ],
 "additionalProperties": false,
 "properties": {
  "report_version": {
   "type": "string",
   "const": "1.0.0"
  },
  "kind": {
   "type": "string",
   "const": "analysis-check-report"
  },
  "status": {
   "type": "string",
   "enum": [
    "complete",
    "incomplete",
    "inconsistent",
    "invalid"
   ]
  },
  "subject_digest": {
   "anyOf": [
    {
     "type": "null"
    },
    {
     "$ref": "revocation_event.json#/$defs/sha256"
    }
   ]
  },
  "assessment_id": {
   "$ref": "revocation_event.json#/$defs/sha256"
  },
  "assessment": {
   "type": "object",
   "required": [
    "subject",
    "suite",
    "rules",
    "registry",
    "checker",
    "readers",
    "settings"
   ]
  },
  "inventory_digest": {
   "anyOf": [
    {
     "type": "null"
    },
    {
     "type": "string"
    }
   ]
  },
  "suite": {
   "type": "object"
  },
  "checker": {
   "type": "object",
   "required": [
    "files",
    "digest"
   ]
  },
  "input_validity": {
   "type": "string",
   "enum": [
    "valid",
    "invalid"
   ]
  },
  "input_diagnostics": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "kind",
     "code",
     "message"
    ]
   }
  },
  "lock_differences": {
   "type": "array"
  },
  "coverage": {
   "type": "object",
   "required": [
    "value",
    "completed",
    "total"
   ],
   "properties": {
    "value": {
     "type": "string",
     "enum": [
      "complete",
      "partial"
     ]
    },
    "completed": {
     "type": "integer"
    },
    "total": {
     "type": "integer"
    }
   }
  },
  "consistency": {
   "type": "string",
   "enum": [
    "consistent",
    "inconsistent",
    "undetermined"
   ]
  },
  "counts": {
   "type": "object"
  },
  "formal_use_view": {
   "type": "object",
   "required": [
    "coverage",
    "consistency",
    "declaration_based_as"
   ]
  },
  "obligations": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "obligation_id",
     "rule_id",
     "state",
     "reason",
     "evidence",
     "declaration_based",
     "declarations"
    ],
    "properties": {
     "state": {
      "type": "string",
      "enum": [
       "satisfied",
       "violated",
       "not_applicable",
       "unverified",
       "unsupported"
      ]
     },
     "declaration_based": {
      "type": "boolean"
     }
    }
   }
  },
  "declarations": {
   "type": "array"
  },
  "context_findings": {
   "type": "array"
  },
  "legacy_findings": {
   "type": "array"
  },
  "execution_evidence_level": {
   "type": "string"
  },
  "validation_status": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "scope_delta": {
   "anyOf": [
    {
     "type": "null"
    },
    {
     "type": "object",
     "required": [
      "new_subject",
      "added",
      "removed",
      "inherits"
     ]
    }
   ]
  },
  "exceptions": {
   "type": "array"
  },
  "note": {
   "type": "string"
  },
  "semantics_source": {
   "type": "string",
   "enum": [
    "installed",
    "snapshot"
   ]
  },
  "installed_differences": {
   "type": "array"
  },
  "snapshot_missing": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "checker_changed": {
   "type": "boolean"
  }
 }
}
