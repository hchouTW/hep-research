{"$comment": "Owner: research-communication. Communication extension under the capability communication:traceability-v1 (traceability_version 1.0.0): claims with evidence edges, document occurrences, source read events, declared evidence ledgers and support assessments. Structural only: relationships, status propagation and assessment currency are checked by contracts/communication.py; files, ledgers and manuscripts are resolved by contracts/communication_project.py. Never upgrades derivation or result status.",
 "type": "object",
 "required": ["traceability_version", "scope", "claims", "sources_read", "evidence_ledgers", "limitations"],
 "properties": {
  "traceability_version": {"$ref": "common.json#/$defs/version"},
  "scope": {"$comment": "what this record covers; absence of data never implies a choice",
    "type": "object", "required": ["occurrences", "sources"],
    "properties": {"occurrences": {"type": "boolean", "$comment": "manuscript coverage requested: occurrences are checked against the documents"},
                   "sources": {"type": "boolean", "$comment": "literature sources cited: the declared ledgers are resolved"},
                   "figures": {"type": "boolean"}, "reviewer": {"type": "boolean"}, "revisions": {"type": "boolean"},
                   "note": {"type": "string"}}},
  "documents": {"type": "array", "items": {"$ref": "#/$defs/document"}},
  "claims": {"type": "array", "items": {"$ref": "#/$defs/claim"}},
  "occurrences": {"type": "array", "items": {"$ref": "#/$defs/occurrence"}},
  "sources_read": {"type": "array", "items": {"$ref": "#/$defs/read_event"}},
  "evidence_ledgers": {"type": "array", "items": {"$ref": "#/$defs/ledger_ref"}},
  "figure_inputs": {"type": "array", "items": {"$ref": "#/$defs/figure_input"}},
  "reporting_context": {"$ref": "#/$defs/reporting_context"},
  "revision_items": {"type": "array", "items": {"$ref": "#/$defs/revision_item"}},
  "reviewer_items": {"type": "array", "items": {"$ref": "#/$defs/reviewer_item"}},
  "limitations": {"type": "array", "items": {"type": "string"}}
 },
 "$defs": {
  "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
  "day": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
  "document": {"type": "object", "required": ["id", "path", "format"],
    "properties": {"id": {"$ref": "common.json#/$defs/namespaced_id"},
                   "path": {"$ref": "common.json#/$defs/nonempty", "$comment": "project-relative"},
                   "format": {"type": "string", "enum": ["markdown", "latex", "text", "other"]},
                   "sha256": {"$ref": "#/$defs/sha256"}, "version": {"type": "string"},
                   "audience": {"type": "string"}, "purpose": {"type": "string"}}},
  "claim": {"type": "object", "required": ["id", "text", "claim_type", "scope", "status", "evidence", "unresolved_inputs"],
    "properties": {"id": {"$ref": "common.json#/$defs/namespaced_id"},
                   "text": {"$ref": "common.json#/$defs/nonempty"},
                   "claim_type": {"type": "string", "enum": ["measurement", "search", "limit", "theory-prediction", "ml-result",
                                                             "comparison", "method", "interpretation", "illustration", "background", "other"]},
                   "scope": {"type": "object", "required": ["text"], "properties": {
                       "text": {"$ref": "common.json#/$defs/nonempty"},
                       "assumptions": {"type": "array", "items": {"type": "string"}}}},
                   "status": {"type": "array", "items": {"type": "string", "x-vocab": "artifact_statuses"}, "minItems": 1},
                   "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence_edge"}},
                   "assessment": {"$ref": "#/$defs/assessment"},
                   "workflow_state": {"type": "string", "enum": ["pending-evidence", "ready-to-edit", "edited", "verified"]},
                   "unresolved_inputs": {"type": "array", "items": {"type": "string"}}}},
  "evidence_edge": {"type": "object", "required": ["id", "target_kind", "target", "locator", "role"],
    "properties": {"id": {"$ref": "common.json#/$defs/namespaced_id"},
                   "target_kind": {"type": "string", "enum": ["artifact", "source"]},
                   "target": {"$ref": "common.json#/$defs/nonempty", "$comment": "an artifact target is an inputs[].ref; a source target is a namespaced source id of a declared ledger"},
                   "locator": {"$ref": "common.json#/$defs/nonempty", "$comment": "the inspected passage, table, equation, figure or field"},
                   "role": {"type": "string", "enum": ["supports", "qualifies", "contradicts", "background"]},
                   "usage": {"type": "string", "enum": ["used-in-claim", "context-only"]},
                   "usage_reason": {"type": "string"},
                   "version": {"type": "string", "$comment": "the authoritative version or identity of a source (arXiv version, DOI version, ledger verification date)"}}},
  "assessment": {"type": "object", "required": ["verdict", "rationale", "evidence_ids", "assessor", "date", "currency"],
    "properties": {"verdict": {"type": "string", "enum": ["supported", "partially-supported", "unsupported", "unresolved"]},
                   "rationale": {"$ref": "common.json#/$defs/nonempty"},
                   "evidence_ids": {"type": "array", "items": {"$ref": "common.json#/$defs/namespaced_id"}},
                   "assessor": {"type": "object", "required": ["identity", "role"], "properties": {
                       "identity": {"$ref": "common.json#/$defs/nonempty"},
                       "role": {"type": "string", "enum": ["author", "reviewer", "agent", "unknown"]}}},
                   "date": {"$ref": "#/$defs/day"},
                   "claim_digest": {"$ref": "#/$defs/sha256"},
                   "evidence_fingerprints": {"type": "object", "additionalProperties": {"type": "string"}},
                   "currency": {"type": "string", "enum": ["current", "stale", "unresolved"]}}},
  "occurrence": {"type": "object", "required": ["id", "claim_id", "document_id", "locator", "passage", "state"],
    "properties": {"id": {"$ref": "common.json#/$defs/namespaced_id"},
                   "claim_id": {"$ref": "common.json#/$defs/namespaced_id"},
                   "document_id": {"$ref": "common.json#/$defs/namespaced_id"},
                   "locator": {"$ref": "common.json#/$defs/nonempty", "$comment": "section:<name>, label:<tex label>, anchor:<heading>, or line:<n>"},
                   "passage": {"$ref": "common.json#/$defs/nonempty", "$comment": "the exact selected passage, used verbatim for the document check"},
                   "passage_sha256": {"$ref": "#/$defs/sha256"},
                   "value": {"type": "object", "required": ["value", "unit"], "properties": {
                       "value": {"type": "string"}, "unit": {"type": "string"}, "rounding": {"type": "string"}}},
                   "state": {"type": "string", "enum": ["mapped", "inspected"]}}},
  "read_event": {"type": "object", "required": ["id", "level"],
    "properties": {"id": {"$ref": "common.json#/$defs/namespaced_id"},
                   "version": {"type": "string"},
                   "level": {"type": "string", "x-vocab": "verification_levels"},
                   "locators": {"type": "array", "items": {"type": "string"}},
                   "verification_date": {"$ref": "#/$defs/day"},
                   "limitations": {"type": "string"},
                   "content_sha256": {"$ref": "#/$defs/sha256"}}},
  "ledger_ref": {"type": "object", "required": ["namespace", "sources_ref", "claims_ref"],
    "properties": {"namespace": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
                   "sources_ref": {"$ref": "common.json#/$defs/nonempty"}, "claims_ref": {"$ref": "common.json#/$defs/nonempty"},
                   "sources_sha256": {"$ref": "#/$defs/sha256"}, "claims_sha256": {"$ref": "#/$defs/sha256"}}},
  "figure_input": {"type": "object", "required": ["id", "source_status", "read_status", "render_status", "visual_inspection_status"],
    "properties": {"id": {"$ref": "common.json#/$defs/namespaced_id"},
                   "result_ref": {"type": "string"}, "source_id": {"type": "string"}, "provenance": {"type": "string"},
                   "source_status": {"type": "array", "items": {"type": "string", "x-vocab": "artifact_statuses"}},
                   "read_status": {"type": "string", "enum": ["read", "not-read", "unresolved"]},
                   "render_status": {"type": "string", "enum": ["rendered", "not-rendered", "failed", "unresolved"]},
                   "visual_inspection_status": {"type": "string", "enum": ["inspected", "pending", "failed", "unresolved"]}}},
  "reporting_context": {"type": "object", "required": ["result_type", "fields"],
    "properties": {"result_type": {"type": "string", "enum": ["measurement", "search", "limit", "theory-prediction", "ml-result"]},
                   "method": {"type": "object"},
                   "fields": {"type": "object", "additionalProperties": {"type": "object", "required": ["state"], "properties": {
                       "state": {"type": "string", "enum": ["provided", "missing", "not-applicable", "unresolved"]},
                       "value": {}, "reason": {"type": "string"}}}}}},
  "revision_item": {"type": "object", "required": ["id", "trigger", "kind", "impacted_claims", "required_actions", "state"],
    "properties": {"id": {"$ref": "common.json#/$defs/namespaced_id"},
                   "trigger": {"$ref": "common.json#/$defs/nonempty"},
                   "kind": {"type": "string", "enum": ["content-edit", "analysis-rerun", "figure-regeneration", "reassessment", "source-change"]},
                   "old": {}, "new": {},
                   "impacted_claims": {"type": "array", "items": {"$ref": "common.json#/$defs/namespaced_id"}},
                   "impacted_occurrences": {"type": "array", "items": {"$ref": "common.json#/$defs/namespaced_id"}},
                   "required_actions": {"type": "array", "items": {"type": "string"}},
                   "state": {"type": "string", "enum": ["pending-evidence", "ready-to-edit", "edited", "verified", "stale"]},
                   "completion_evidence": {"type": "array", "items": {"type": "object", "required": ["check", "version"], "properties": {
                       "check": {"type": "string"}, "version": {"type": "string"}, "date": {"$ref": "#/$defs/day"}}}}}},
  "reviewer_item": {"type": "object", "required": ["id", "requested_action", "claims", "disposition"],
    "properties": {"id": {"$ref": "common.json#/$defs/namespaced_id"},
                   "comment": {"type": "string"},
                   "requested_action": {"$ref": "common.json#/$defs/nonempty"},
                   "claims": {"type": "array", "items": {"$ref": "common.json#/$defs/namespaced_id"}},
                   "revision_items": {"type": "array", "items": {"$ref": "common.json#/$defs/namespaced_id"}},
                   "response_draft": {"type": "string"},
                   "disposition": {"type": "string", "enum": ["pending", "changed", "declined", "partially-changed"]},
                   "completion_evidence": {"type": "array", "items": {"type": "string"}}}}
 }}
