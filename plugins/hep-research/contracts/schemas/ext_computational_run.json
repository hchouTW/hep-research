{
 "$comment": "Owner: hep-computing.",
 "type": "object",
 "required": [
  "input_manifest",
  "tools",
  "commands",
  "environment",
  "seeds",
  "tolerances",
  "exit_status",
  "output_hashes"
 ],
 "properties": {
  "input_manifest": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "path",
     "sha256"
    ]
   }
  },
  "tools": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "name",
     "version"
    ]
   }
  },
  "commands": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "environment": {
   "type": "object"
  },
  "seeds": {
   "type": "object"
  },
  "tolerances": {
   "type": "object"
  },
  "resources": {
   "type": "object"
  },
  "exit_status": {
   "type": "integer"
  },
  "output_hashes": {
   "type": "object"
  },
  "evidence_records": {
   "$comment": "3.1.0: provisional run records the artifact relies on by hash, without inheriting their labels (Geant4 phase 2); resolved by contracts/dependencies.py",
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "ref",
     "sha256",
     "artifact_id"
    ],
    "properties": {
     "ref": {
      "type": "string"
     },
     "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
     },
     "artifact_id": {
      "type": "string"
     },
     "artifact_type": {
      "const": "computational-run"
     },
     "role": {
      "type": "string"
     }
    }
   }
  },
  "study": {
   "type": "object"
  }
 }
}
