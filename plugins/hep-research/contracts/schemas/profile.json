{"$comment": "profile.json minimum fields.",
 "type": "object",
 "required": ["id", "kind", "version", "scope", "exclusions", "compatible", "related_skills", "resources", "vocabulary_extensions", "adapters", "depends_on", "evidence_namespace", "maintainer", "capabilities"],
 "properties": {
  "id": {"$ref": "common.json#/$defs/profile_id"},
  "kind": {"type": "string", "enum": ["experiment", "theory-domain"]},
  "version": {"$ref": "common.json#/$defs/version"},
  "scope": {"type": "string", "minLength": 1}, "exclusions": {"type": "array", "items": {"type": "string"}},
  "illustrative": {"type": "boolean"},
  "compatible": {"type": "object", "required": ["core", "contracts"], "properties": {"core": {"type": "string"}, "contracts": {"type": "string"}}},
  "related_skills": {"type": "array", "items": {"type": "string", "enum": ["hep-analysis", "detector-response", "hep-theory", "hep-statistics", "hep-computing", "physics-ml", "research-communication"]}},
  "resources": {"type": "object", "required": ["index", "conventions"], "additionalProperties": {"type": "string"}},
  "vocabulary_namespaces": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}},
  "vocabulary_extensions": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "string"}}},
  "adapters": {"type": "object", "required": ["required", "optional"], "properties": {
     "required": {"type": "array", "items": {"type": "string", "pattern": "^adapter:"}}, "optional": {"type": "array", "items": {"type": "string", "pattern": "^adapter:"}}}},
  "depends_on": {"type": "array", "items": {"$ref": "common.json#/$defs/profile_id"}},
  "evidence_namespace": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
  "maintainer": {"type": "string", "minLength": 1},
  "capabilities": {"type": "array", "items": {"type": "object", "required": ["name", "status", "scope"], "properties": {
     "name": {"type": "string"}, "status": {"type": "string", "x-vocab": "capability_statuses"}, "scope": {"type": "string"},
     "tests": {"type": "array", "items": {"type": "string"}}}}}
 }}
