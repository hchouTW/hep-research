{"$comment": "Owner: hep-theory. Covers theory spec and derivation record header. No experiment, detector, data, or blinding fields are required or allowed.",
 "type": "object",
 "required": ["model", "assumptions", "conventions", "order", "parameters", "derivation_status", "validity_domain", "checks_run", "checks_not_run"],
 "additionalProperties": false,
 "properties": {
  "model": {"type": "object", "required": ["id", "description"],
            "properties": {"family": {"type": "string", "description": "optional model family; 'cosmic-ray-propagation' asks for degenerate_directions (contracts 2.6.0)"}}},
  "domain_profile": {"$ref": "common.json#/$defs/profile_id"},
  "assumptions": {"type": "array", "items": {"type": "string"}, "minItems": 1},
  "conventions": {"$ref": "common.json#/$defs/conventions"},
  "order": {"type": "string"},
  "parameters": {"type": "object"},
  "scales": {"anyOf": [{"type": "object"}, {"$ref": "common.json#/$defs/missing"}]},
  "derivation_status": {"type": "string", "x-vocab": "derivation_statuses"},
  "validity_domain": {"type": "object"},
  "checks_run": {"type": "array", "items": {"type": "object", "required": ["name", "result"],
                 "properties": {"tolerance": {"anyOf": [{"type": "string"}, {"type": "number"}]}}}},
  "checks_not_run": {"type": "array", "items": {"type": "string"}},
  "references_read": {"type": "array", "items": {"type": "object", "required": ["citation", "location"],
                      "properties": {"date_read": {"type": "string", "description": "ISO date YYYY-MM-DD the source was read"}}}},
  "derivation_record": {"type": "string"},
  "inapplicable": {"type": "array", "items": {"type": "string"}},
  "limit": {"type": "string", "description": "the limit an asymptotic-argument result holds in (contracts 2.6.0)"},
  "neglected": {"type": "array", "items": {"type": "string"}},
  "computational_run_ref": {"type": "string", "description": "computational-run artifact with the tool versions of the derivation"},
  "degenerate_directions": {"type": "array", "description": "parameter combinations the model cannot separate: a string such as 'D0/L' or (contracts 3.14.0) an object with its combination",
                            "items": {"oneOf": [{"type": "string"},
                                                {"type": "object", "required": ["combination"], "additionalProperties": false,
                                                 "description": "evidence and valid_range are required by the rules theory.degeneracy_evidence_missing, theory.degeneracy_range_missing and theory.degeneracy_evidence_unknown (validate.CRPROP_FROM)",
                                                 "properties": {"combination": {"type": "string", "minLength": 1},
                                                                "form": {"type": "string", "minLength": 1},
                                                                "exponents": {"type": "object", "additionalProperties": {"type": "number"}},
                                                                "valid_range": {"type": "object", "additionalProperties": {"$ref": "#/$defs/interval"}},
                                                                "broken_by": {"type": "array", "items": {"type": "string", "minLength": 1}},
                                                                "evidence": {"type": "string", "description": "a core degeneracy_evidence term: fisher-screen, profile-scan or posterior"}}}]}},
  "transport": {"type": "object", "additionalProperties": false,
                "description": "optional propagation set-up of a cosmic-ray-propagation model in canonical parameter names and units (contracts 3.14.0); the geometry, diffusion, reacceleration and convection blocks accept only the canonical names",
                "properties": {
                 "geometry": {"type": "object", "additionalProperties": false,
                              "properties": {"kind": {"type": "string", "minLength": 1}, "L_kpc": {"type": "number", "exclusiveMinimum": 0},
                                             "radius_kpc": {"type": "number", "exclusiveMinimum": 0}, "disc_halfwidth_pc": {"type": "number", "exclusiveMinimum": 0}}},
                 "diffusion": {"type": "object", "additionalProperties": false,
                               "properties": {"form": {"type": "string", "minLength": 1}, "D0_cm2_s": {"type": "number", "exclusiveMinimum": 0},
                                              "R0_gv": {"type": "number", "exclusiveMinimum": 0}, "eta": {"type": "number"}, "delta": {"type": "number"},
                                              "breaks": {"type": "array", "items": {"type": "object", "required": ["kind", "R_break_gv"], "additionalProperties": false,
                                                         "properties": {"kind": {"type": "string", "minLength": 1}, "R_break_gv": {"type": "number", "exclusiveMinimum": 0},
                                                                        "delta_below": {"type": "number"}, "s": {"type": "number", "exclusiveMinimum": 0},
                                                                        "s_convention": {"type": "string", "minLength": 1}}}}}},
                 "reacceleration": {"type": "object", "additionalProperties": false,
                                    "properties": {"V_A_kms": {"type": "number", "minimum": 0}, "zone": {"type": "string", "minLength": 1},
                                                   "relation": {"type": "string", "minLength": 1}, "w": {"type": "number"}}},
                 "convection": {"type": "object", "additionalProperties": false,
                                "properties": {"V_c_kms": {"type": "number", "minimum": 0}, "dVc_dz_kms_per_kpc": {"type": "number"}}},
                 "losses": {"type": "array", "items": {"type": "string", "minLength": 1}},
                 "decay": {"type": "object", "properties": {"enabled": {"type": "boolean"}, "lorentz_dilation": {"type": "boolean"},
                                                            "ec_treatment": {"type": "string", "minLength": 1}}},
                 "gas": {"type": "object", "properties": {"model": {"type": "string", "minLength": 1}, "He_to_H_number": {"type": "number", "minimum": 0}}},
                 "sources": {"type": "object", "properties": {"spatial": {"type": "string", "minLength": 1},
                                                              "injection": {"type": "array", "items": {"type": "object", "properties": {"species_group": {"type": "string", "minLength": 1},
                                                                                                                                        "gamma": {"type": "number"},
                                                                                                                                        "breaks": {"type": "array", "items": {"type": "object"}}}}},
                                                              "abundances": {"type": "string", "minLength": 1}}},
                 "cross_sections": {"type": "object", "properties": {"production_set": {"type": "string", "minLength": 1},
                                                                     "inelastic_set": {"type": "string", "minLength": 1},
                                                                     "ghost_threshold": {"type": "string", "minLength": 1}}},
                 "species": {"type": "object", "properties": {"network_top": {"type": "string", "minLength": 1}, "isotopic": {"type": "boolean"}}},
                 "family": {"type": "string", "minLength": 1, "description": "model family, e.g. BIG, SLIM or QUAINT"},
                 "free": {"type": "array", "items": {"type": "string", "minLength": 1}, "description": "the free transport parameters, by canonical name"}}}
 },
 "$defs": {"interval": {"type": "object", "additionalProperties": false, "properties": {"min": {"type": "number"}, "max": {"type": "number"}}}}}
