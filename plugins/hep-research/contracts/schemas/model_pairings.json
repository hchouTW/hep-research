{
 "$comment": "Pairing contract of the model-card suite (v6.3 M2b, contracts/semantics/model_pairings.json).",
 "type": "object",
 "required": [
  "pairings_version",
  "owner",
  "adapter",
  "pairings",
  "unsupported"
 ],
 "additionalProperties": false,
 "properties": {
  "$comment": {
   "type": "string"
  },
  "pairings_version": {
   "type": "string",
   "pattern": "^\\d+\\.\\d+\\.\\d+$"
  },
  "owner": {
   "type": "string",
   "minLength": 1
  },
  "adapter": {
   "type": "object",
   "required": [
    "id",
    "version"
   ]
  },
  "pairings": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "id",
     "modifier",
     "constraint",
     "backend"
    ],
    "additionalProperties": false,
    "properties": {
     "id": {
      "type": "string",
      "minLength": 1
     },
     "modifier": {
      "type": "string",
      "minLength": 1
     },
     "constraint": {
      "anyOf": [
       {
        "type": "null"
       },
       {
        "type": "object",
        "required": [
         "kind",
         "form"
        ],
        "additionalProperties": false,
        "properties": {
         "kind": {
          "type": "string"
         },
         "form": {
          "type": "string"
         }
        }
       }
      ]
     },
     "backend": {
      "type": "string"
     },
     "interpolation": {
      "type": "string"
     },
     "conditions": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "bounds": {
      "type": "array",
      "items": {
       "type": "number"
      }
     }
    }
   }
  },
  "meanings": {
   "type": "object"
  },
  "unsupported": {
   "type": "array",
   "items": {
    "type": "string"
   }
  }
 }
}
