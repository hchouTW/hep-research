{
 "$comment": "naming_change_set.json: the complete plan for one rename (spec §6.6), validated by contracts/naming_check.py validate-change-set in the order of §8.4.",
 "type": "object",
 "required": [
  "change_set_id",
  "entity_id",
  "current",
  "proposed",
  "contract_level",
  "rename_policy",
  "replacements",
  "inventory_digests",
  "source_sha256",
  "verify"
 ],
 "additionalProperties": false,
 "properties": {
  "change_set_id": {
   "type": "string",
   "minLength": 1
  },
  "entity_id": {
   "type": "string",
   "minLength": 1
  },
  "current": {
   "type": "string",
   "minLength": 1
  },
  "proposed": {
   "type": "string",
   "minLength": 1
  },
  "contract_level": {
   "type": "string",
   "enum": [
    "C0",
    "C1",
    "C2",
    "C3",
    "C4"
   ]
  },
  "rename_policy": {
   "type": "string",
   "enum": [
    "matrix",
    "dedup-only",
    "deprecate",
    "never"
   ]
  },
  "approval": {
   "type": "object",
   "required": [
    "required",
    "by",
    "at"
   ],
   "additionalProperties": false,
   "properties": {
    "required": {
     "type": "boolean"
    },
    "by": {
     "type": "string",
     "minLength": 1
    },
    "at": {
     "type": "string",
     "minLength": 1
    }
   }
  },
  "replacements": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "location",
     "old",
     "new"
    ],
    "additionalProperties": false,
    "properties": {
     "location": {
      "type": "string",
      "minLength": 1
     },
     "old": {
      "type": "string",
      "minLength": 1
     },
     "new": {
      "type": "string",
      "minLength": 1
     }
    }
   }
  },
  "inventory_digests": {
   "type": "object",
   "additionalProperties": {
    "type": "string",
    "pattern": "^[0-9a-f]{64}$"
   }
  },
  "source_sha256": {
   "type": "object",
   "additionalProperties": {
    "type": "string",
    "pattern": "^[0-9a-f]{64}$"
   }
  },
  "handoff": {
   "type": "object",
   "required": [
    "owner",
    "rerun"
   ],
   "additionalProperties": false,
   "properties": {
    "owner": {
     "type": "string",
     "enum": [
      "hep-measurement",
      "hep-detector",
      "hep-statistics",
      "hep-theory",
      "hep-computing",
      "hep-ml",
      "hep-citations",
      "hep-authoring"
     ]
    },
    "rerun": {
     "type": "array",
     "items": {
      "type": "string",
      "minLength": 1
     }
    }
   }
  },
  "deprecated_alias": {
   "type": "object",
   "required": [
    "old",
    "remove_in"
   ],
   "additionalProperties": false,
   "properties": {
    "old": {
     "type": "string",
     "minLength": 1
    },
    "remove_in": {
     "$ref": "common.json#/$defs/version"
    }
   }
  },
  "verify": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "string",
    "minLength": 1
   }
  },
  "trigger": {
   "type": "object",
   "$comment": "the finding that asks for the rename; a dedup-only surface (N15) renames only for a uniqueness finding",
   "required": [
    "rule_id"
   ],
   "additionalProperties": false,
   "properties": {
    "rule_id": {
     "type": "string"
    },
    "rule_version": {
     "type": "string"
    },
    "predicate": {
     "type": "string"
    },
    "reason_code": {
     "type": "string"
    }
   }
  }
 }
}
