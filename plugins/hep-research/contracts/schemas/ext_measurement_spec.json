{
 "$comment": "Owner: hep-measurement. Experiment-neutral: the normalization kind decides which exposure field is needed. Ratios and fractions list every effect assumed to cancel, with a correlation model.",
 "type": "object",
 "required": [
  "observable",
  "period",
  "selections",
  "backgrounds",
  "corrections",
  "systematics",
  "blinding"
 ],
 "properties": {
  "observable": {
   "$ref": "common.json#/$defs/observable_spec"
  },
  "species_or_process": {
   "type": "string"
  },
  "period": {
   "anyOf": [
    {
     "type": "object",
     "required": [
      "start",
      "end"
     ]
    },
    {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "start",
       "end"
      ]
     },
     "minItems": 1
    },
    {
     "$ref": "common.json#/$defs/missing"
    }
   ]
  },
  "selections": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "name",
     "definition",
     "conditional_denominator"
    ]
   }
  },
  "backgrounds": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "name",
     "estimator"
    ],
    "properties": {
     "estimator": {
      "type": "string"
     },
     "control_region": {
      "type": "string"
     },
     "constraint": {
      "type": "string"
     },
     "closure": {
      "type": "string"
     }
    }
   }
  },
  "corrections": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "effect_id",
     "category",
     "applied_in"
    ],
    "properties": {
     "exact_zero": {
      "type": "boolean",
      "$comment": "true only when a value of 0 is exact, not unknown"
     }
    }
   }
  },
  "systematics": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "name",
     "source",
     "effect",
     "applied_via"
    ],
    "properties": {
     "effect": {
      "type": "string",
      "enum": [
       "normalization",
       "shape",
       "migration",
       "mixed"
      ]
     },
     "scaling": {
      "type": "string",
      "enum": [
       "statistical-like",
       "floor",
       "mixed"
      ],
      "$comment": "Optional (M5): how the size falls with the control-sample size N_ctrl; statistical-like sigma ~ 1/sqrt(N_ctrl), floor constant, mixed sigma^2 = a^2 + b^2/N_ctrl"
     },
     "era_correlation": {
      "type": "string",
      "enum": [
       "correlated",
       "uncorrelated",
       "partial"
      ],
      "$comment": "Optional (M3): how this systematic is correlated across the spec's eras; partial needs its scheme in correlation_evidence or notes"
     }
    }
   }
  },
  "blinding": {
   "anyOf": [
    {
     "type": "object",
     "required": [
      "blinded"
     ],
     "properties": {
      "blinded": {
       "type": "boolean"
      },
      "mask": {
       "type": "object",
       "$comment": "Blinded regions by name or observable intervals; the collaboration's blinding policy defines them",
       "properties": {
        "regions": {
         "type": "array",
         "items": {
          "type": "string"
         }
        },
        "intervals": {
         "type": "array",
         "items": {
          "type": "object",
          "required": [
           "variable"
          ]
         }
        }
       }
      },
      "unblinding_record_ref": {
       "type": [
        "string",
        "null"
       ],
       "$comment": "Reference to an unblinding record kept outside the agent session by an authorized person; the agent never fills it"
      }
     }
    },
    {
     "$ref": "common.json#/$defs/missing"
    }
   ]
  },
  "experiment_fields": {
   "type": "object",
   "$comment": "Profile-namespaced fields, e.g. '<ns>:<field>'"
  },
  "ratio": {
   "type": "object",
   "required": [
    "numerator",
    "denominator",
    "cancellations"
   ],
   "properties": {
    "numerator": {
     "type": "string"
    },
    "denominator": {
     "type": "string"
    },
    "cancellations": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "effect",
       "treatment",
       "correlation_model"
      ],
      "properties": {
       "effect": {
        "type": "string"
       },
       "treatment": {
        "type": "string",
        "enum": [
         "cancels",
         "correlated",
         "partial",
         "independent"
        ]
       },
       "correlation_model": {
        "type": "string"
       },
       "verification": {
        "type": "string"
       }
      }
     }
    }
   }
  },
  "estimand": {
   "type": "string",
   "$comment": "One sentence: quantity, species or process, variable and range, level, frame, what is held fixed (required by the 2.6.0 rules)"
  },
  "no_backgrounds_reason": {
   "type": "string",
   "$comment": "Why the measurement has no background (an empty backgrounds list needs it from 2.6.0)"
  },
  "eras": {
   "type": "array",
   "minItems": 1,
   "$comment": "Optional (M3): detector configuration, calibration, software or operating eras; review_measurement_spec.py checks periods and time bins against their boundaries, per-era corrections, cross-era correlations and versions",
   "items": {
    "type": "object",
    "required": [
     "id",
     "start",
     "end",
     "kind",
     "source"
    ],
    "properties": {
     "id": {
      "type": "string",
      "minLength": 1
     },
     "start": {
      "type": [
       "string",
       "number"
      ]
     },
     "end": {
      "type": [
       "string",
       "number"
      ]
     },
     "kind": {
      "type": "string",
      "enum": [
       "configuration",
       "calibration",
       "software",
       "operating"
      ]
     },
     "source": {
      "type": "string",
      "minLength": 1
     },
     "corrections": {
      "type": "array",
      "items": {
       "type": "string"
      },
      "$comment": "effect_ids of the corrections determined for this era"
     },
     "shared_corrections": {
      "type": "array",
      "items": {
       "type": "string"
      },
      "$comment": "effect_ids of corrections declared valid across eras (with evidence)"
     },
     "versions": {
      "type": "object",
      "additionalProperties": {
       "type": "string"
      },
      "$comment": "reconstruction, calibration or other versions used for this era"
     },
     "evidence_ids": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "notes": {
      "type": "string"
     }
    }
   }
  },
  "coupled_backgrounds": {
   "type": "array",
   "minItems": 1,
   "$comment": "Optional (M4): backgrounds that are another species measured at the same time (feed-down, charge-sign confusion of the partner species, charge-ladder leakage); review_measurement_spec.py warns (coupled.fixed_subtraction) when one is subtracted as a fixed amount instead of being fitted jointly or iterated",
   "items": {
    "type": "object",
    "required": [
     "background",
     "species",
     "treatment",
     "source"
    ],
    "properties": {
     "background": {
      "type": "string",
      "minLength": 1,
      "$comment": "name of the entry in backgrounds"
     },
     "species": {
      "type": "string",
      "minLength": 1,
      "$comment": "the other species whose measurement sets this background"
     },
     "treatment": {
      "type": "string",
      "enum": [
       "joint-fit",
       "iterative",
       "fixed-subtraction"
      ]
     },
     "source": {
      "type": "string",
      "minLength": 1
     },
     "evidence_ids": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "notes": {
      "type": "string"
     }
    }
   }
  }
 }
}
