{
 "$comment": "naming_inventory.json: what an extractor (skills/<owner>/scripts/extract_names.py) writes for one surface (semantic naming spec §6.1). Holds every name of the surface within scope_roots plus the names removed in this change. A working file of <project>/naming/, never of artifacts_dir. The engine fills tokens, references_status, contract_level and contract_basis.",
 "type": "object",
 "required": [
  "inventory_version",
  "surface",
  "scope_roots",
  "inputs_scanned",
  "generated_at",
  "entities"
 ],
 "additionalProperties": false,
 "properties": {
  "inventory_version": {
   "const": "1.0.0"
  },
  "surface": {
   "type": "string",
   "pattern": "^N(?:[1-9]|1[0-7])$"
  },
  "scope_roots": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "string"
   }
  },
  "inputs_scanned": {
   "type": "integer",
   "minimum": 0
  },
  "generated_at": {
   "type": "string",
   "minLength": 1
  },
  "changed_since": {
   "type": "string",
   "$comment": "the git revision --changed compared against"
  },
  "skipped_inputs": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "path",
     "reason"
    ],
    "additionalProperties": false,
    "properties": {
     "path": {
      "type": "string",
      "minLength": 1
     },
     "reason": {
      "type": "string",
      "minLength": 1
     }
    }
   }
  },
  "entities": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/entity"
   }
  }
 },
 "$defs": {
  "entity": {
   "type": "object",
   "required": [
    "entity_id",
    "surface",
    "entity_kind",
    "name",
    "scope",
    "source",
    "meaning",
    "references",
    "search_coverage",
    "change",
    "content_sha256",
    "extractor"
   ],
   "additionalProperties": false,
   "properties": {
    "entity_id": {
     "type": "string",
     "pattern": "^N(?:[1-9]|1[0-7]):[^#]*#.*@[0-9]+$"
    },
    "surface": {
     "type": "string",
     "pattern": "^N(?:[1-9]|1[0-7])$"
    },
    "entity_kind": {
     "type": "string",
     "minLength": 1
    },
    "name": {
     "type": "string",
     "minLength": 1
    },
    "tokens": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "scope": {
     "type": "object",
     "required": [
      "file",
      "container",
      "span"
     ],
     "additionalProperties": false,
     "properties": {
      "file": {
       "type": "string"
      },
      "container": {
       "type": "string"
      },
      "span": {
       "type": "array",
       "minItems": 2,
       "maxItems": 2,
       "items": {
        "type": "integer",
        "minimum": 0
       }
      }
     }
    },
    "source": {
     "type": "string",
     "enum": [
      "project",
      "external"
     ]
    },
    "meaning": {
     "type": "object",
     "required": [
      "concept_id",
      "unit",
      "status_label",
      "source"
     ],
     "additionalProperties": false,
     "properties": {
      "concept_id": {
       "type": [
        "string",
        "null"
       ]
      },
      "unit": {
       "type": [
        "string",
        "null"
       ]
      },
      "status_label": {
       "type": [
        "string",
        "null"
       ]
      },
      "source": {
       "type": "string",
       "enum": [
        "extractor",
        "glossary",
        "annotation"
       ]
      }
     }
    },
    "references": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "from",
       "kind"
      ],
      "additionalProperties": false,
      "properties": {
       "from": {
        "type": "string",
        "minLength": 1
       },
       "kind": {
        "type": "string",
        "minLength": 1
       }
      }
     }
    },
    "search_coverage": {
     "type": "array",
     "items": {
      "type": "string",
      "pattern": "^N(?:[1-9]|1[0-7]):.+$"
     }
    },
    "references_status": {
     "type": "string",
     "enum": [
      "complete",
      "partial",
      "not_searched"
     ]
    },
    "contract_level": {
     "type": "string",
     "enum": [
      "C0",
      "C1",
      "C2",
      "C3",
      "C4"
     ]
    },
    "contract_basis": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "change": {
     "type": "string",
     "enum": [
      "added",
      "modified",
      "removed",
      "unchanged"
     ]
    },
    "content_sha256": {
     "type": "string",
     "pattern": "^[0-9a-f]{64}$"
    },
    "extractor": {
     "type": "object",
     "required": [
      "id",
      "version"
     ],
     "additionalProperties": false,
     "properties": {
      "id": {
       "type": "string",
       "minLength": 1
      },
      "version": {
       "$ref": "common.json#/$defs/version"
      }
     }
    },
    "targets": {
     "type": "array",
     "$comment": "names this entity refers to on its own or another surface (a \\\\ref to a label, an included figure file, the shape histograms a nuisance reads); derived: the target's name is built from this entity's name, so a rename of this entity renames it too (cross-surface change sets)",
     "items": {
      "type": "object",
      "required": [
       "surface",
       "name",
       "kind"
      ],
      "additionalProperties": false,
      "properties": {
       "surface": {
        "type": "string",
        "pattern": "^N(?:[1-9]|1[0-7])$"
       },
       "name": {
        "type": "string",
        "minLength": 1
       },
       "kind": {
        "type": "string",
        "minLength": 1
       },
       "file": {
        "type": "string"
       },
       "container": {
        "type": "string"
       },
       "derived": {
        "type": "boolean"
       },
       "entity_kind": {
        "type": "string",
        "minLength": 1,
        "$comment": "the kind the target entity has (a label reference targets a label, not another reference)"
       }
      }
     }
    }
   },
   "$comment": "tokens, references_status, contract_level and contract_basis are the engine's: an extractor leaves them out (spec §6.1); the report's classified entities carry them"
  }
 }
}
