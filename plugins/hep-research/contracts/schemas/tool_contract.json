{
 "$comment": "Machine-readable tool contract (AGENTIC-R5 T4.7, F14, F16): a sidecar with its own contract_version, not an artifact envelope type. One file per plugin tool under contracts/tool_contracts/; it states each operation's inputs and outputs with units, its failure states (exit codes), the reader capabilities it needs, the purposes it may serve and its side effects. Help text is not the contract. 1.1.0 (contracts 3.11.0, detector system design spec ART-40..ART-48) adds positional arguments, config-file fields and the optional per-operation design block that sets the fidelity, bound and parameter mapping of design evaluations (read by contracts/design.py); a 1.0.0 contract uses none of them. contracts/tool_contract.py checks a contract against the tool's command line; a valid contract authorizes nothing (HC-05), and formal analysis is not a purpose here: it needs the separate use gate.",
 "type": "object",
 "required": [
  "contract_version",
  "tool_id",
  "entry",
  "operations"
 ],
 "additionalProperties": false,
 "properties": {
  "contract_version": {
   "type": "string",
   "enum": [
    "1.0.0",
    "1.1.0"
   ]
  },
  "tool_id": {
   "$ref": "#/$defs/id"
  },
  "entry": {
   "$comment": "the script, relative to the plugin root; a regular file, never a link",
   "type": "string",
   "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$))(?!.*\\\\)[A-Za-z0-9_./-]+\\.py$"
  },
  "operations": {
   "type": "array",
   "minItems": 1,
   "items": {
    "$ref": "#/$defs/operation"
   }
  }
 },
 "$defs": {
  "id": {
   "type": "string",
   "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
  },
  "flag": {
   "type": "string",
   "pattern": "^--[a-z0-9][a-z0-9-]*$"
  },
  "unit": {
   "$comment": "a unit string; '1' for a dimensionless number or a count, 'n/a' for a value without a unit (a label, a path)",
   "type": "string",
   "minLength": 1
  },
  "operation": {
   "type": "object",
   "required": [
    "operation_id",
    "summary",
    "invocation",
    "inputs",
    "outputs",
    "failure_states",
    "required_capabilities",
    "purposes",
    "side_effects"
   ],
   "additionalProperties": false,
   "properties": {
    "operation_id": {
     "$ref": "#/$defs/id"
    },
    "summary": {
     "type": "string",
     "minLength": 1
    },
    "invocation": {
     "$comment": "every command-line option the tool accepts, each mapped to one input; the checker compares this list with the tool's --help in both directions",
     "type": "object",
     "required": [
      "kind",
      "options",
      "output"
     ],
     "additionalProperties": false,
     "properties": {
      "kind": {
       "type": "string",
       "const": "cli"
      },
      "positionals": {
       "$comment": "1.1.0 (ART-42): positional arguments in order, each mapped to one input; the checker compares them with the tool's usage line",
       "type": "array",
       "items": {
        "type": "object",
        "required": [
         "position",
         "input"
        ],
        "additionalProperties": false,
        "properties": {
         "position": {
          "type": "integer",
          "minimum": 0
         },
         "input": {
          "$ref": "#/$defs/id"
         }
        }
       }
      },
      "options": {
       "type": "array",
       "items": {
        "type": "object",
        "required": [
         "flag",
         "input"
        ],
        "additionalProperties": false,
        "properties": {
         "flag": {
          "$ref": "#/$defs/flag"
         },
         "input": {
          "$ref": "#/$defs/id"
         }
        }
       }
      },
      "output": {
       "type": "string",
       "enum": [
        "json-stdout"
       ]
      }
     }
    },
    "inputs": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "name",
       "kind",
       "unit",
       "required",
       "constraint"
      ],
      "additionalProperties": false,
      "properties": {
       "name": {
        "$ref": "#/$defs/id"
       },
       "kind": {
        "$comment": "a quantity kind (as in an operator-semantics table) or 'parameter' for a setting such as a confidence level",
        "type": "string",
        "minLength": 1
       },
       "unit": {
        "$ref": "#/$defs/unit"
       },
       "required": {
        "type": "boolean"
       },
       "constraint": {
        "type": "string",
        "minLength": 1
       },
       "default": {
        "type": [
         "number",
         "string",
         "boolean"
        ]
       },
       "fields": {
        "$comment": "1.1.0 (ART-42): the fields of a config-file input (kind 'path'), each with kind, unit and constraint",
        "type": "array",
        "minItems": 1,
        "items": {
         "type": "object",
         "required": [
          "field",
          "kind",
          "unit",
          "constraint"
         ],
         "additionalProperties": false,
         "properties": {
          "field": {
           "type": "string",
           "minLength": 1
          },
          "kind": {
           "type": "string",
           "minLength": 1
          },
          "unit": {
           "$ref": "#/$defs/unit"
          },
          "constraint": {
           "type": "string",
           "minLength": 1
          }
         }
        }
       }
      }
     }
    },
    "outputs": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "object",
      "required": [
       "name",
       "kind",
       "unit"
      ],
      "additionalProperties": false,
      "properties": {
       "name": {
        "type": "string",
        "minLength": 1
       },
       "kind": {
        "type": "string",
        "minLength": 1
       },
       "unit": {
        "$ref": "#/$defs/unit"
       }
      }
     }
    },
    "failure_states": {
     "$comment": "every non-zero exit the tool can end with, and what it means; exit 0 is success",
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "object",
      "required": [
       "exit_code",
       "status",
       "meaning"
      ],
      "additionalProperties": false,
      "properties": {
       "exit_code": {
        "type": "integer",
        "minimum": 1
       },
       "status": {
        "type": "string",
        "enum": [
         "invalid-input",
         "unsupported-range",
         "failed",
         "incomplete",
         "unreadable"
        ]
       },
       "meaning": {
        "type": "string",
        "minLength": 1
       }
      }
     }
    },
    "required_capabilities": {
     "$comment": "reader capabilities (contracts.KNOWN_CAPABILITIES) the operation relies on; an unknown one is refused",
     "type": "array",
     "items": {
      "type": "string",
      "minLength": 1
     }
    },
    "purposes": {
     "$comment": "the uses the operation is declared for; formal analysis is not one (separate use gate)",
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "string",
      "enum": [
       "exploration",
       "fixed-execution",
       "validation"
      ]
     }
    },
    "design": {
     "$ref": "#/$defs/design"
    },
    "operators": {
     "$comment": "operator ids of operator-semantics tables this operation can implement (which one depends on the inputs; a recipe step names the operator it uses)",
     "type": "array",
     "items": {
      "$ref": "#/$defs/id"
     }
    },
    "side_effects": {
     "type": "object",
     "required": [
      "writes_files",
      "network",
      "subprocess"
     ],
     "additionalProperties": false,
     "properties": {
      "writes_files": {
       "type": "boolean"
      },
      "network": {
       "$comment": "plugin tools open no network connection",
       "type": "boolean",
       "const": false
      },
      "subprocess": {
       "type": "boolean"
      }
     }
    }
   }
  },
  "fidelity": {
   "type": "string",
   "enum": [
    "F1",
    "F2",
    "F3"
   ]
  },
  "bound": {
   "type": "string",
   "enum": [
    "optimistic",
    "conservative",
    "estimate"
   ]
  },
  "direction": {
   "type": "string",
   "enum": [
    "order-preserving",
    "reversed",
    "non-monotonic"
   ]
  },
  "expr": {
   "$comment": "how design.py recomputes an input (ART-41, ART-61): a candidate parameter found by subsystem role, the budget items of a quantity over the subsystems, a denominator field, a species constant (design_adequacy.json species; 'of' names the denominator field), the value of a required upstream evaluation, a constant, a sum, product, quotient or list, an object or a zip of lists into objects, or a config file (ART-72: written as JSON, its path is the argv token)",
   "anyOf": [
    {
     "type": "object",
     "required": [
      "parameter"
     ],
     "additionalProperties": false,
     "properties": {
      "parameter": {
       "type": "object",
       "required": [
        "role",
        "name",
        "unit"
       ],
       "additionalProperties": false,
       "properties": {
        "role": {
         "type": "string",
         "minLength": 1
        },
        "name": {
         "type": "string",
         "minLength": 1
        },
        "unit": {
         "$ref": "#/$defs/unit"
        }
       }
      }
     }
    },
    {
     "type": "object",
     "required": [
      "denominator"
     ],
     "additionalProperties": false,
     "properties": {
      "denominator": {
       "type": "string",
       "minLength": 1
      }
     }
    },
    {
     "type": "object",
     "required": [
      "species"
     ],
     "additionalProperties": false,
     "properties": {
      "species": {
       "type": "string",
       "enum": [
        "charge",
        "charge_number",
        "mass_GeV",
        "mass_number",
        "tool_name"
       ]
      },
      "of": {
       "$comment": "the denominator field naming the species (default species)",
       "type": "string",
       "minLength": 1
      }
     }
    },
    {
     "type": "object",
     "required": [
      "upstream"
     ],
     "additionalProperties": false,
     "properties": {
      "upstream": {
       "$ref": "#/$defs/fom"
      }
     }
    },
    {
     "type": "object",
     "required": [
      "const"
     ],
     "additionalProperties": false,
     "properties": {
      "const": {
       "type": [
        "number",
        "string",
        "array",
        "boolean",
        "object"
       ]
      }
     }
    },
    {
     "type": "object",
     "required": [
      "sum"
     ],
     "additionalProperties": false,
     "properties": {
      "sum": {
       "type": "array",
       "minItems": 1,
       "items": {
        "$ref": "#/$defs/expr"
       }
      }
     }
    },
    {
     "type": "object",
     "required": [
      "product"
     ],
     "additionalProperties": false,
     "properties": {
      "product": {
       "type": "array",
       "minItems": 1,
       "items": {
        "$ref": "#/$defs/expr"
       }
      }
     }
    },
    {
     "type": "object",
     "required": [
      "quotient"
     ],
     "additionalProperties": false,
     "properties": {
      "quotient": {
       "type": "array",
       "minItems": 2,
       "items": {
        "$ref": "#/$defs/expr"
       }
      }
     }
    },
    {
     "type": "object",
     "required": [
      "list"
     ],
     "additionalProperties": false,
     "properties": {
      "list": {
       "type": "array",
       "minItems": 1,
       "items": {
        "$ref": "#/$defs/expr"
       }
      }
     }
    },
    {
     "type": "object",
     "required": [
      "budget"
     ],
     "additionalProperties": false,
     "properties": {
      "budget": {
       "type": "object",
       "required": [
        "quantity",
        "field"
       ],
       "additionalProperties": false,
       "properties": {
        "quantity": {
         "type": "string",
         "enum": [
          "mass",
          "power",
          "channel_count",
          "data_rate"
         ]
        },
        "field": {
         "type": "string",
         "enum": [
          "estimate",
          "uncertainty"
         ]
        }
       }
      }
     }
    },
    {
     "type": "object",
     "required": [
      "object"
     ],
     "additionalProperties": false,
     "properties": {
      "object": {
       "type": "object",
       "additionalProperties": {
        "$ref": "#/$defs/expr"
       }
      }
     }
    },
    {
     "type": "object",
     "required": [
      "zip"
     ],
     "additionalProperties": false,
     "properties": {
      "zip": {
       "type": "object",
       "additionalProperties": {
        "$ref": "#/$defs/expr"
       }
      }
     }
    },
    {
     "type": "object",
     "required": [
      "config"
     ],
     "additionalProperties": false,
     "properties": {
      "config": {
       "$ref": "#/$defs/expr"
      }
     }
    },
    {
     "type": "object",
     "required": [
      "span"
     ],
     "additionalProperties": false,
     "properties": {
      "span": {
       "$ref": "#/$defs/expr"
      }
     }
    },
    {
     "type": "object",
     "required": [
      "input_artifact"
     ],
     "additionalProperties": false,
     "properties": {
      "input_artifact": {
       "$comment": "the path of the one input artifact of this type the evaluation binds (e.g. statistical-result)",
       "type": "string",
       "minLength": 1
      }
     }
    }
   ]
  },
  "fom": {
   "type": "string",
   "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
  },
  "condition": {
   "$comment": "a validity or bound condition: an input's recomputed value (every element of a list) or a denominator field within [min, max], one output number at least another, or the derived bound of an upstream evaluation",
   "anyOf": [
    {
     "type": "object",
     "required": [
      "input"
     ],
     "additionalProperties": false,
     "properties": {
      "input": {
       "$ref": "#/$defs/id"
      },
      "min": {
       "type": "number"
      },
      "max": {
       "type": "number"
      },
      "note": {
       "type": "string"
      }
     }
    },
    {
     "type": "object",
     "required": [
      "denominator"
     ],
     "additionalProperties": false,
     "properties": {
      "denominator": {
       "type": "string",
       "minLength": 1
      },
      "min": {
       "type": "number"
      },
      "max": {
       "type": "number"
      },
      "note": {
       "type": "string"
      }
     }
    },
    {
     "type": "object",
     "required": [
      "output_ge"
     ],
     "additionalProperties": false,
     "properties": {
      "output_ge": {
       "type": "array",
       "minItems": 2,
       "items": {
        "type": "string",
        "minLength": 1
       }
      },
      "note": {
       "type": "string"
      }
     }
    },
    {
     "type": "object",
     "required": [
      "upstream_bound"
     ],
     "additionalProperties": false,
     "properties": {
      "upstream_bound": {
       "$ref": "#/$defs/fom"
      },
      "in": {
       "type": "array",
       "minItems": 1,
       "items": {
        "$ref": "#/$defs/bound"
       }
      },
      "note": {
       "type": "string"
      }
     }
    }
   ]
  },
  "value_location": {
   "$comment": "where the value is in the tool's output JSON: a dotted path (integers index lists), or one path per value of a denominator field",
   "anyOf": [
    {
     "type": "object",
     "required": [
      "path"
     ],
     "additionalProperties": false,
     "properties": {
      "path": {
       "type": "string",
       "minLength": 1
      }
     }
    },
    {
     "type": "object",
     "required": [
      "by_denominator",
      "paths"
     ],
     "additionalProperties": false,
     "properties": {
      "by_denominator": {
       "type": "string",
       "minLength": 1
      },
      "paths": {
       "type": "object",
       "additionalProperties": {
        "type": "string",
        "minLength": 1
       }
      }
     }
    }
   ]
  },
  "fom_design": {
   "type": "object",
   "required": [
    "id",
    "better",
    "unit",
    "bound",
    "denominator",
    "value",
    "inputs"
   ],
   "additionalProperties": false,
   "properties": {
    "id": {
     "$ref": "#/$defs/fom"
    },
    "better": {
     "$comment": "the figure of merit's 'better' direction (RUL-00b)",
     "type": "string",
     "enum": [
      "smaller",
      "larger"
     ]
    },
    "unit": {
     "$ref": "#/$defs/unit"
    },
    "bound": {
     "$comment": "ART-40: one bound, or pieces tried in order (the first whose conditions all hold); the last piece has no conditions",
     "anyOf": [
      {
       "$ref": "#/$defs/bound"
      },
      {
       "type": "array",
       "minItems": 1,
       "items": {
        "type": "object",
        "required": [
         "bound"
        ],
        "additionalProperties": false,
        "properties": {
         "when": {
          "type": "array",
          "minItems": 1,
          "items": {
           "$ref": "#/$defs/condition"
          }
         },
         "bound": {
          "$ref": "#/$defs/bound"
         },
         "note": {
          "type": "string"
         }
        }
       }
      }
     ]
    },
    "denominator": {
     "$comment": "the denominator fields and their kinds (ART-11)",
     "type": "object",
     "additionalProperties": {
      "type": "string",
      "enum": [
       "number",
       "string"
      ]
     }
    },
    "value": {
     "$ref": "#/$defs/value_location"
    },
    "inputs": {
     "$comment": "every input the evaluation passes, with how design.py recomputes it (ART-41); 'direction' for an input fed by an upstream evaluation (CMB-01)",
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "object",
      "required": [
       "input",
       "from"
      ],
      "additionalProperties": false,
      "properties": {
       "input": {
        "$ref": "#/$defs/id"
       },
       "from": {
        "$ref": "#/$defs/expr"
       },
       "direction": {
        "$ref": "#/$defs/direction"
       }
      }
     }
    },
    "free_inputs": {
     "$comment": "options an evaluation may pass that change no number (e.g. a status label)",
     "type": "array",
     "items": {
      "$ref": "#/$defs/id"
     }
    },
    "operation_args": {
     "$comment": "leading arguments of the operation (the subcommand name for a tool with subcommands)",
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "validity": {
     "$comment": "FID-10: the domain in which the declared bound holds; outside it the verdict is domain.mismatch (row 7)",
     "type": "array",
     "items": {
      "$ref": "#/$defs/condition"
     }
    },
    "required_upstreams": {
     "$comment": "FID-11: upstream figures of merit a composite figure of merit needs",
     "type": "array",
     "items": {
      "$ref": "#/$defs/fom"
     }
    },
    "assumptions": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "note": {
     "type": "string"
    },
    "uncertainty": {
     "$comment": "the uncertainty of the value: absolute at a path of the output, or relative to the value, with its coverage (FID-12)",
     "type": "object",
     "required": [
      "coverage",
      "interval",
      "distribution"
     ],
     "additionalProperties": false,
     "properties": {
      "path": {
       "type": "string",
       "minLength": 1
      },
      "relative": {
       "type": "number",
       "minimum": 0
      },
      "coverage": {
       "type": "number",
       "exclusiveMinimum": 0
      },
      "interval": {
       "type": "string",
       "enum": [
        "central",
        "one-sided"
       ]
      },
      "distribution": {
       "type": "string",
       "enum": [
        "gaussian",
        "non-gaussian",
        "exact"
       ]
      }
     }
    },
    "upstream_directions": {
     "$comment": "CMB-01: the combination direction of a required upstream that the operation reads through another artifact rather than an argument (e.g. through a statistical-result)",
     "type": "object",
     "additionalProperties": {
      "$ref": "#/$defs/direction"
     }
    }
   }
  },
  "design": {
   "$comment": "1.1.0: how the operation's results become design evaluations (contracts/design.py); the key names other than fidelity and bound are fixed here (OQ-06)",
   "type": "object",
   "required": [
    "fidelity",
    "figures_of_merit"
   ],
   "additionalProperties": false,
   "properties": {
    "fidelity": {
     "$ref": "#/$defs/fidelity"
    },
    "figures_of_merit": {
     "type": "array",
     "minItems": 1,
     "items": {
      "$ref": "#/$defs/fom_design"
     }
    }
   }
  }
 }
}
