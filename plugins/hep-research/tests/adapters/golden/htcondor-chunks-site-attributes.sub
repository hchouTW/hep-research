# Generated by the hep-research batch-schedulers adapter (HTCondor backend); regenerate from the config, do not edit.
# Submission s001: each process takes its chunk and attempt IDs from the item list, never from $(Process).
# No max_retries and no on_exit_remove / periodic_release: a failed or held job is reported, never retried here.
universe = vanilla
# The submission tag names the batch and a job attribute, so reconcile can find the jobs; getenv = false keeps the
# submitter's environment (tokens, agent sockets) out of the job.
batch_name = hepr-<UID>-s001
+HepResearchTag = "hepr-<UID>-s001"
getenv = false
executable = <CAMPAIGN>/runner.py
transfer_executable = false
arguments = "--spec <CAMPAIGN>/spec.json --chunk $(chunk_id) --attempt $(attempt_id) --out-root <CAMPAIGN>/outputs"
log = <CAMPAIGN>/submissions/s001/events.log
output = <CAMPAIGN>/submissions/s001/logs/$(attempt_id).stdout.log
error = <CAMPAIGN>/submissions/s001/logs/$(attempt_id).stderr.log
should_transfer_files = NO
request_cpus = 1
request_memory = 1000MB
+JobFlavour = "espresso"
+MaxRuntime = 1200
+WantOS = "el9"
+WantIOProxy = true
queue chunk_id, attempt_id from items.txt
