#!/bin/bash
# Generated by the hep-research batch-schedulers adapter (Slurm backend); regenerate from the config, do not edit.
# Submission s001: the array index selects a chunk only through the submission map.
# Log paths are given on the sbatch command line (--output/--error), so paths with spaces stay intact.
# The job name is the submission tag, so reconcile can find the jobs; --export=NONE keeps the submitter's
# environment (tokens, agent sockets) out of the job.
#SBATCH --job-name=hepr-<UID>-s001
#SBATCH --array=0-9%3
#SBATCH --no-requeue
#SBATCH --export=NONE
#SBATCH --partition=synthetic-partition
#SBATCH --account=synthetic-account
#SBATCH --qos=synthetic-qos
#SBATCH --time=00:10:00
#SBATCH --cpus-per-task=1
#SBATCH --mem=1000M
set -u
exec python3 <CAMPAIGN>/runner.py --spec <CAMPAIGN>/spec.json --map <CAMPAIGN>/submissions/s001/map.json --index "${SLURM_ARRAY_TASK_ID}" --out-root <CAMPAIGN>/outputs
