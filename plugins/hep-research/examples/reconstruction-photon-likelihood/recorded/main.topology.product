{"budget": {"format": "light-likelihood-multistart/1", "sha256": "70220b7ddf1679d01d4a9c5397d1fdf124c6f0bd8ed4dca562d9c18e04180307", "starts": ["prefit", "reversed", "turned +e1", "turned -e1", "turned +e2", "turned -e2", "mirrored", "charge seed"], "tie_tolerance": 1e-06}, "channel_states": {"D": "dead", "H": "live-hit", "U": "live-unhit", "X": "disabled"}, "configuration": {"format": "light-likelihood-configuration/1", "sha256": "ce4f430756f8ea0be1ab1b08eb638f9c38bf305968aa2d6d4e743d5fc68a1508"}, "events": 2, "fit_settings": {"accepted_scipy_status": [0, 2], "callback_stop_rule": "a joint round ends once |(a, b)| exceeds joint_chart_radius; SciPy returns callback_stop_status there; the next round re-centres the chart: never convergence, never a failure by itself", "callback_stop_status": 99, "chart_step": 0.0001, "choice_rule": "the reported fit is the converged start with the highest ln L; every converged start within tie_tolerance of it is tied and the lowest index wins; no converged start: failed, kind all-starts-failed, with start 0's last point if it has one; no hit channel: no start, kind no-hit-channel", "gtol": 1e-06, "joint_chart_radius": 1.0, "max_iterations_per_round": 200, "max_rounds": 6, "minimiser": "scipy.optimize.minimize, method trust-exact, analytic gradient and Hessian", "newton_decrement_tolerance": 1e-08, "prefit": "the charge-only fit of light-likelihood-product/1 from its seed; its point starts the joint fit", "seed_vertex_factor": 0.5, "seeds": "multistart: the budget's starts, in its order (header budget)", "start_rules": {"charge seed": "stage 1's moment seed (vertex 0.5 c, the charge-weighted direction), not fitted", "mirrored": "the anchor reflected through the sphere centre: vertex -x_a, direction -d_a", "prefit": "stage 2's one joint start: the charge-only prefit's point (or its last point, or the charge seed), t0 by the median rule", "reversed": "the anchor vertex, the anchor direction reversed", "turned +e1": "the anchor vertex, direction e1 of section 7's frame at the anchor direction", "turned +e2": "the anchor vertex, direction e2 of section 7's frame at the anchor direction", "turned -e1": "the anchor vertex, direction -e1 of section 7's frame at the anchor direction", "turned -e2": "the anchor vertex, direction -e2 of section 7's frame at the anchor direction"}, "start_values_rule": "starts other than prefit: E_vis by stage 1's moment rule (sum q / (1000 sum_live s_i)) and t0 by stage 2's median rule (median over hits of t_i - |P_i - x| / v), at the start's own vertex and direction", "t0_domain_rule": "t0 in (lo W, hi W), W the configuration's window_ns (200 ns for t09-sphere/1)", "t0_domain_windows": [-1.0, 2.0], "t0_seed": "median over hit channels of t_i - |P_i - x_start| / v", "time_domain_ns": 1000000.0}, "format": "light-likelihood-product/4", "frame": "u1, u2: tangent components at the fitted direction d in section 7's frame, e1 = a x d normalised (a the z axis, or the x axis where |d_z| > 0.9), e2 = d x e1; the scoring side projects onto the frame at the truth direction", "h1_product": {"product_id": "example-reconstruction-photon-likelihood-main-multistart", "sha256": "9d44ae712dc4b758cc9cbd4311c17fd1e31568cccd6377250c65aeaa60eee6b1"}, "hessian_steps": {"direction": 1e-06, "vertex_m": 1e-05}, "hypothesis": "H1: one point source (the multistart fit); H2: two point sources, each with its own t0; the choice of t04-values-v4.md section 7 (the topology record)", "input": {"channels": 1000, "events": 2, "format": "light-readout/1", "role": "reconstruction-input", "saturation_charge": null, "sha256": "5c7f64623b7a420e11e94973de555e3ef991fa86c1e893500bb98063c97ff975", "threshold": 0.25}, "label": "shared-model closure", "label_meaning": "the fixture's events and this fit share the stated analytic light model of t04-values-v4.md section 4.3: a closure of the code, not a test of the model or of any instrument (plan section 11.1)", "likelihood": "charge and first-arrival time jointly, all live channels (stage 2)", "not_estimated": {}, "parameters": [{"name": "x", "unit": "m"}, {"name": "y", "unit": "m"}, {"name": "z", "unit": "m"}, {"name": "u1", "unit": "1 (tangent component at the fitted direction)"}, {"name": "u2", "unit": "1 (tangent component at the fitted direction)"}, {"name": "e_vis", "unit": "1 (E_vis = N_exp / (1000 S), section 4.3)"}, {"name": "t0", "unit": "ns (emission time; arrival at sensor i is t0 + d_i / v)"}], "probability_check": {"epsilon": 2.220446049250313e-16, "factor": 64, "rule": "per live channel at the reported point: |P(hit) + P(no hit) - 1| <= its tolerance (largest_ratio: the largest deviation over tolerance), P(hit) from the upper tails at the threshold and P(no hit) from the likelihood's no-hit term; a failure is the T09 sheet's stop", "tolerance": "64 eps (1 + m |ln m|) per channel, eps = 2^-52"}, "product_id": "example-reconstruction-photon-likelihood-main-topology", "recipe": "reco.light.channel-likelihood/1", "retention": {"charges": "every hit channel's charge, saturated flag and first-arrival time", "states": "every channel of every event", "times": "every hit channel's first-arrival time (unhit, dead and disabled channels have none)", "truth": "none"}, "topology": {"fit": "the joint charge-time likelihood with both sources' light summed per channel, each source its own t0; 14 coordinates (x1, y1, z1, a1, b1, E1, t0_1, x2, y2, z2, a2, b2, E2, t0_2); stage 1's and 2's rounds, convergence rule, failure kinds and covariance for two charts; the start notation: r_i = max(q_i - mu_c m_i(H1), 0) on hit channels; M(w) stage 1's moment rule on weights w (vertex 0.5 x the w-weighted sensor centroid, direction the w-weighted sum of unit vectors from it to the sensors); E(w; x, d) = sum w / (1000 sum_live s_i(x, d)); T(x; S) the median over channels in S of t_i - |P_i - x| / v", "format": "light-likelihood-topology/1", "penalty": 30.0, "report_rule": "H2's reported point is the start with the highest recorded ln L, converged or not; a tie within tie_tolerance goes to the lowest index", "rule": "H2 if and only if 2 (lnL_2 - lnL_1) >= 30 (t04-values-v4.md section 7), lnL_1 the multistart H1 fit's, lnL_2 the larger of H2's reported ln L and lnL_1 (H1 is H2's boundary at zero second yield); otherwise H1", "sha256": "104262a1bfb0f5403a075884d9acd5f5ccbf1fc012d5237b578297f4d98ed7df", "start_rules": {"charge split": "the hit channels split by the plane through the charge centroid normal to the leading eigenvector of the charge-weighted scatter (largest-magnitude component positive), half 0 on its positive side; each half h: M(q_h), E(q_h; ...), T(x_h; q_h > 0)", "charge split, reversed": "as charge split with both directions reversed, E at the reversed directions", "h1 + largest residual": "source 1 H1's fit; source 2 at 0.5 P_k, direction P_k / |P_k|, k the channel of largest r, E(r; ...), t0_2 = t_k - |P_k - x2| / v", "h1 + mirrored h1": "source 1 H1's fit; source 2 (-x_H1, -d_H1), E(r; -x_H1, -d_H1), t0_2 = T(-x_H1; r > 0)", "h1 + residual": "source 1 H1's fit; source 2 (x2, d2) = M(r), E(r; x2, d2), t0_2 = T(x2; r > 0)", "h1 + residual, mirrored": "source 1 H1's fit; source 2 (-x2, -d2), E(r; -x2, -d2), t0_2 = T(-x2; r > 0)", "h1 + residual, reversed": "source 1 H1's fit; source 2 (x2, -d2), E(r; x2, -d2), t0_2 = T(x2; r > 0)", "h1 + residual, turned": "source 1 H1's fit; source 2 (x2, e1(d2)), section 7's frame at d2, E(r; x2, e1), t0_2 = T(x2; r > 0)"}, "starts": ["h1 + residual", "h1 + residual, reversed", "h1 + residual, mirrored", "h1 + residual, turned", "h1 + largest residual", "h1 + mirrored h1", "charge split", "charge split, reversed"], "tie_tolerance": 1e-06}, "uncertainty": "inverse of the observed Hessian of -ln L at the fit, in (x, y, z, u1, u2, e_vis, t0); conditional on the fixed light model and its constants; validated by no pull here"}
